# nexis.grammar — reader grammar for nexis (nexus 1.0).
#
# `zig build parser` generates src/parser.zig from this file. The parser
# produces a raw `Sexp` tree that `src/reader.zig` normalizes into the
# canonical `Form` tree documented in `docs/FORMS.md` (PLAN Appendix C):
#
#   source.nx ──[src/nexis.zig lexer + this grammar]──► raw Sexp ──[src/reader.zig]──► Form
#
# The grammar performs no semantic normalization:
#   - `^meta target` emits `(with-meta-raw ^ target meta)`; the reader merges
#     stacked metadata into one `with-meta` Form.
#   - `#(body)` emits `(anon-fn #( body... ))`; the reader stores it as the
#     `anon_fn` datum and rejects nested anon-fns.
#   - `` `x `` emits `(syntax-quote ` x)`; expansion (auto-qualify, auto-gensym,
#     unquote handling) is the macroexpander's job.
#   - `#_ x` emits `(discard #_ x)`; the reader drops it.
#   - `nil`, `true`, `false` arrive as symbols; the reader converts them.
#   - Duplicate literal keys, odd map counts, nested anon-fns and bare
#     unquotes are the reader's to reject.

@lexer

# The scanner is hand-written: `src/nexis.zig` `Lexer` replaces the generated
# one entirely (numbers, chars, strings and symbols need Clojure's token
# boundaries). The grammar names the token categories it produces and
# nothing more.
tokens
    integer
    real
    string
    char
    keyword
    ident
    lparen
    rparen
    lbracket
    rbracket
    lbrace
    rbrace
    hash_lbrace
    hash_lparen
    hash_discard
    quote_tok
    syntax_quote_tok
    unquote_splicing_tok
    unquote_tok
    deref_tok
    caret
    eof
    err

@parser

@lang = "nexis"

# Start symbols:
#   program — a whole file (zero or more top-level forms)
#   form    — exactly one form (REPL line, read-string)
program! = forms                                 → (program ...1)
form!    = datum                                 → 1

# Left recursion: each form appends to the list in place.
forms    = forms datum                           → (...1 2)
         |                                       → ()

# Compound and prefix forms keep their delimiter tokens as children, so a
# form's span covers them.
datum    = INTEGER                               → (int 1)
         | REAL                                  → (real 1)
         | STRING                                → (string 1)
         | CHAR                                  → (char 1)
         | KEYWORD                               → (keyword 1)
         | IDENT                                 → (symbol 1)
         | LPAREN forms RPAREN                   → (list 1 ...2 3)
         | LBRACKET forms RBRACKET               → (vector 1 ...2 3)
         | LBRACE forms RBRACE                   → (map 1 ...2 3)
         | HASH_LBRACE forms RBRACE              → (set 1 ...2 3)
         | HASH_LPAREN forms RPAREN              → (anon-fn 1 ...2 3)
         | QUOTE_TOK datum                       → (quote 1 2)
         | SYNTAX_QUOTE_TOK datum                → (syntax-quote 1 2)
         | UNQUOTE_TOK datum                     → (unquote 1 2)
         | UNQUOTE_SPLICING_TOK datum            → (unquote-splicing 1 2)
         | DEREF_TOK datum                       → (deref 1 2)
         | HASH_DISCARD datum                    → (discard 1 2)
         | CARET datum datum                     → (with-meta-raw 1 3 2)
