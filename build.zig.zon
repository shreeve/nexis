.{
    .name = .nexis,
    .fingerprint = 0xcb09f0806daea9ef,
    .version = "0.0.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // emdb, nexis's sibling project: the persistent B+-tree storage
        // (PLAN §2 substrate), a path dependency on the sibling checkout.
        // src/db.zig and src/nextomic/store.zig consume its Env, Txn and
        // Cursor.
        .emdb = .{ .path = "../emdb" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "bench",
        "docs",
        "test",
        "examples",
        "nexis.grammar",
        "README.md",
        "PLAN.md",
        "CLOJURE-REVIEW.md",
        "AGENTS.md",
    },
}
