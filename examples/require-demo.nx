; examples/require-demo.nx — loading a library from a file. require
; looks for a namespace's file beside the running script and in the
; working directory; the dots of the name are directories, so lib.geom
; is lib/geom.nx.
;
;   bin/nexis run examples/require-demo.nx

; :as gives the namespace a short alias.
(require '[lib.geom :as g])
(println (g/area-of-square 5) (g/area-of-rectangle 2 3))

; :refer brings names in unqualified; :rename renames one it refers.
(require '[lib.geom :refer [perimeter-of-square point] :rename {point pt}])
(println (perimeter-of-square 5) (pt 1 2))

; In a file of its own, the same goes in the ns form:
;   (ns my.app
;     (:require [lib.geom :as g :refer [point]]))
