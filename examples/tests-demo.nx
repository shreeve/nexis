; examples/tests-demo.nx — unit tests with nexis.test (clojure.test is
; accepted as its name): deftest, is, testing and run-tests. Two tests
; fail and one throws, so the report shows every outcome.
;
;   bin/nexis run examples/tests-demo.nx    prints the report
;   bin/nexis test examples/tests-demo.nx   also exits 1 on a failure

(require '[nexis.test :as t])

(defn area [w h] (* w h))

(t/deftest area-test
  (t/testing "rectangles"
    (t/is (= 6 (area 2 3)))
    (t/is (= 0 (area 0 9))))
  (t/testing "squares"
    (t/is (= 16 (area 4 4)))))

(t/deftest failing-test
  (t/testing "a wrong expectation"
    (t/is (= 5 (area 2 2)) "areas multiply")))

(t/deftest throwing-test
  (t/is (t/thrown? :divide-by-zero (/ 1 0)))
  (t/is (t/thrown? :boom (throw {:error :boom :n 1})))
  (t/is (t/thrown? any (throw "anything"))))

; A throw that no thrown? expects is an error, not a failure.
(defn parse-age [s]
  (or (parse-long s)
      (throw (ex-info "not a number" {:error :bad-age :input s}))))

(t/deftest erroring-test
  (t/is (= 30 (parse-age "30")))
  (t/is (= 1 (parse-age "one"))))

(t/deftest bare-test
  (t/is (pos? (area 3 3)))
  (t/is (empty? [1]) "a bare assertion that fails"))

(t/run-tests)
