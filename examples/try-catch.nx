; examples/try-catch.nx — try / catch / throw / finally
; (steps #9.1 + #9.2).
;
; v1 supports:
;   - throw any value (slot/constant/var operand)
;   - catch-any binding
;   - cross-frame propagation (callee throws, caller catches)
;   - finally clauses (runs on normal exit, caught throw,
;     uncaught throw); throw inside finally overrides
;
; Limitations:
;   - recur inside try not supported (wrap try around loop)
;   - runtime VM errors (KindMismatch etc.) not catchable
;   - only `(catch any binding handler)` matcher in v1

(defn safe-divide [a b]
  (try
    (do
      ; A user-thrown :div-by-zero signals invalid input.
      (when (< b 1)
        (throw :div-by-zero))
      a)
    (catch any e e)
    (finally :always-runs)))   ; finally body runs but value discarded

; Result: 42. Finally body always runs; its value is ignored.
(safe-divide 42 1)
