; examples/try-catch.nx — try / catch / throw, step #9.1.
;
; v1 supports: throw any value, catch-any binding, cross-frame
; propagation. The throw walks up the frame chain until it
; finds a try handler.
;
; Deferred to #9.2: finally clauses, recur inside try.
; Deferred to post-#10: catching VM-detected errors
; (KindMismatch / DivideByZero / etc. still halt the VM
; rather than being caught).

(defn safe-divide [a b]
  (try
    (do
      ; A user-thrown :div-by-zero signals invalid input.
      ; In v1 the throw payload is just a value; richer
      ; structured-error conventions land later.
      (when (< b 1)
        (throw :div-by-zero))
      a)                ; placeholder for actual division
    (catch any e e)))

; Returns 42 — no throw, normal exit.
(safe-divide 42 1)
