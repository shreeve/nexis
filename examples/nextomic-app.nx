; examples/nextomic-app.nx — a small clinic chart on Nextomic, the
; database built into nexis: schema as data, transactions, Datalog
; queries, pull, and reads of the chart as it was at any earlier point.
; Patients and visits are keyed by unique ids, so a second run over the
; same store still finds two patients and one visit; the visit notes
; have no id and are added again, and the history shows both runs.
; The store is tmp/clinic.edb; docs/NEXTOMIC.md is the reference.
;
;   bin/nexis run examples/nextomic-app.nx

(require '[nextomic :as d]
         '[clojure.walk :as walk])

; The schema is data: each attribute is an entity with a type and a
; cardinality. (attr :patient/name :string :one) is the map
;   {:db/ident :patient/name :db/valueType :db.type/string
;    :db/cardinality :db.cardinality/one}
; and a :db.unique/identity attribute makes its value a key.
(defn attr [ident type cardinality & {:as more}]
  (merge {:db/ident ident
          :db/valueType (keyword "db.type" (name type))
          :db/cardinality (keyword "db.cardinality" (name cardinality))}
         more))

(def schema
  [(attr :patient/mrn :string :one
         :db/unique :db.unique/identity :db/doc "Medical record number")
   (attr :patient/name :string :one)
   (attr :patient/born :instant :one)
   (attr :patient/allergies :keyword :many)
   (attr :patient/primary :ref :one)
   (attr :clinician/name :string :one :db/unique :db.unique/identity)
   (attr :visit/id :string :one :db/unique :db.unique/identity)
   (attr :visit/patient :ref :one :db/index true)
   (attr :visit/reason :string :one)
   (attr :visit/weight-kg :double :one)
   (attr :visit/notes :ref :many :db/isComponent true)
   (attr :note/text :string :one)])

(def conn (d/connect "tmp/clinic.edb"))
(d/transact! conn schema)

; Transactions are data too. A string :db/id is a temporary id that
; links entities within one transaction; "datomic.tx" is the
; transaction itself, here given a note.
(def intake
  (d/transact! conn
    [{:db/id "dr" :clinician/name "Dr. Okafor"}
     {:patient/mrn "MRN-1001" :patient/name "Mara Quist" :patient/born #inst "1990-01-01"
      :patient/allergies [:penicillin] :patient/primary "dr"}
     {:patient/mrn "MRN-1002" :patient/name "Teo Lund" :patient/born #inst "2000-01-01"
      :patient/primary "dr"}
     [:db/add "datomic.tx" :db/doc "intake"]]))

; A lookup ref [attr value] names an entity by a unique attribute. The
; notes are components: they belong to the visit.
(d/transact! conn
  [{:visit/id "V-1" :visit/patient [:patient/mrn "MRN-1001"]
    :visit/reason "annual" :visit/weight-kg 62.5
    :visit/notes [{:note/text "BP normal"} {:note/text "advised flu shot"}]}])

; A correction is more facts: a card-one value replaces the old one, a
; card-many value adds to the set, a retraction removes one fact.
(def correction
  (d/transact! conn
    [[:db/add [:visit/id "V-1"] :visit/weight-kg 63.0]
     [:db/add [:patient/mrn "MRN-1001"] :patient/allergies :latex]
     [:db/retract [:patient/mrn "MRN-1001"] :patient/allergies :penicillin]]))

(def db (d/db conn))

; show prints a label and a value as data, strings in quotes.
(defn show [label x]
  (println label (pr-str x)))

(println (format "intake at t = %d, basis now %d" (:tx intake) (d/basis-t db)))

; An entity reads attributes on demand; a ref attribute reads as
; another entity, so keyword lookups walk the graph.
(def mara (d/entity db [:patient/mrn "MRN-1001"]))
; touch reads every attribute into a map: refs as ids, and the entity's
; own :db/id, which this line leaves out with the doctor.
(show "Mara today:" (dissoc (d/touch mara) :db/id :patient/primary))
(show "Mara's doctor:" (:clinician/name (:patient/primary mara)))
(show "V-1 notes:" (mapv :note/text (:visit/notes (d/entity db [:visit/id "V-1"]))))

; Datalog: patterns join on shared variables, :in binds inputs after
; the db, and predicates and aggregates run inside the query.
(show "latex allergies:"
         (d/q '[:find [?name ...]
                :where [?p :patient/allergies :latex] [?p :patient/name ?name]]
              db))

(def visits-per-patient
  '[:find ?name (count ?v)
    :where [?v :visit/patient ?p] [?p :patient/name ?name]])
(show "visits per patient:" (sort (d/q visits-per-patient db)))

(show "visits over 60 kg:"
         (d/q '[:find ?id ?kg
                :in $ ?min
                :where [?v :visit/weight-kg ?kg] [(> ?kg ?min)] [?v :visit/id ?id]]
              db 60.0))

(show "Dr. Okafor's patients:"
         (sort (d/q '[:find [?name ...]
                      :where [?dr :clinician/name "Dr. Okafor"]
                             [?p :patient/primary ?dr]
                             [?p :patient/name ?name]]
                    db)))

; Pull: the pattern is the shape of the answer. A nested map follows a
; ref, :visit/_patient walks the ref backwards (the visits that point at
; Mara), and components come along whole. Pull includes each entity's
; :db/id; the chart leaves them out.
(defn without-ids [x]
  (walk/postwalk #(if (map? %) (dissoc % :db/id) %) x))

(show "Mara's chart:"
         (without-ids
           (d/pull db '[:patient/name :patient/allergies
                        {:patient/primary [:clinician/name]}
                        {:visit/_patient [:visit/reason :visit/weight-kg :visit/notes]}]
                   [:patient/mrn "MRN-1001"])))
(show "both names:"
         (mapv :patient/name
               (d/pull-many db '[:patient/name]
                            [[:patient/mrn "MRN-1001"] [:patient/mrn "MRN-1002"]])))

; Time: as-of is the db as it stood at a transaction, and history holds
; every assertion and retraction, each with its t.
(show "Mara at intake:"
         (-> (d/as-of db (:tx intake))
             (d/entity [:patient/mrn "MRN-1001"])
             :patient/allergies))
(show "weight history:"
         (mapv (fn [[_e _a v t added?]] [v t added?])
               (d/datoms (d/history db) :eavt [:visit/id "V-1"] :visit/weight-kg)))
(show "what changed in the correction:"
         (->> (d/tx-range conn (:tx correction) (inc (:tx correction)))
              first
              :data
              (map (fn [[_e a v _t added?]] [(d/ident db a) v added?]))
              (remove #(= :db/txInstant (first %)))
              vec))

; d/with runs a transaction that is never committed: the db it hands
; the function can be queried like any other, then it is gone.
(d/with conn [{:visit/id "V-2" :visit/patient [:patient/mrn "MRN-1001"]
               :visit/reason "follow-up" :visit/weight-kg 61.0}]
  (fn [db-after report]
    (println "if V-2 were filed:" (pr-str (sort (d/q visits-per-patient db-after)))
             "at t =" (:tx report))))
(let [db (d/db conn)]
  (println "on file:" (count (d/datoms db :aevt :visit/id)) "visit(s), basis" (d/basis-t db)))

; A unique identity is a key: the same MRN with a new name updates that
; patient, and a second entity claiming a taken visit id is refused.
(d/transact! conn [{:patient/mrn "MRN-1002" :patient/name "Teodor Lund"}])
(show "Teo renamed:" (:patient/name (d/entity (d/db conn) [:patient/mrn "MRN-1002"])))
(show "conflict:"
         (try (d/transact! conn [[:db/add [:patient/mrn "MRN-1002"] :visit/id "V-1"]])
              (catch :nextomic/unique e [(:attr e) (:value e)])))

(let [db (d/db conn)]
  (println "patients:" (count (d/datoms db :aevt :patient/mrn))
           "visits:" (count (d/datoms db :aevt :visit/id))
           "basis:" (d/basis-t db)))

(d/release conn)
