; examples/shapes-app.nx — a program split into namespaces: the Shape
; protocol, the records and the built-in extensions each live in a file
; under examples/lib/shapes/, and require loads them by name
; (lib.shapes.records is lib/shapes/records.nx beside this file).
;
;   bin/nexis run examples/shapes-app.nx

(ns shapes-app
  (:require [clojure.string :as str]
            [lib.shapes.protocol :as shape]
            [lib.shapes.records :as r]
            [lib.shapes.builtins]))

(def shapes
  [(r/->Circle 1) (r/->Circle 2) (r/->Rect 3 4) (r/->Triangle 6 4) 5 2 "door"])

(doseq [s shapes]
  (println (format "%-22s %6.2f" (shape/describe s) (double (shape/area s)))))

(println (format "%-22s %6.2f" "total" (double (reduce + (map shape/area shapes)))))

; Count the shapes by kind: the first word of each description.
(prn (frequencies (map #(first (str/split (shape/describe %) #" ")) shapes)))

(prn (every? #(satisfies? shape/Shape %) shapes)
     (satisfies? shape/Shape :keyword))
