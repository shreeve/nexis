; examples/durable-refs.nx — Phase 4.0a durable identity demo
;
; The OTHER big arc: durable identities are first-class language
; values, not a library bolted on top. Backed by emdb (LMDB-class
; B+ tree, MVCC, zero-copy reads).
;
; This example uses both APIs:
;   - v1.alpha auto-ephemeral: db/put-key! / db/get-key
;   - Phase 4.0b explicit-tx: with-tx + db/put! / db/get

; Open (or create) a connection to a database file.
; v1.alpha accepts the path as a keyword (its interned name = path).
(def conn (db/open :app.edb))

; Construct a durable ref. Its identity is the triple
; {store-id, tree-name, key-bytes}. Two refs with the same
; triple compare equal, regardless of stored content.
(def alice (db/ref conn :users :alice))

; Write + read via auto-ephemeral transactions.
(db/put-key! alice {:name :alice :age 30 :tags #{:admin :early-user}})
(db/get-key alice)               ; => {:name :alice, :age 30, ...}

; Presence check (no decode cost).
(db/present? alice)              ; => true

; Default value for missing keys.
(db/get-key (db/ref conn :users :nobody) :not-found)   ; => :not-found

; Persistent values round-trip through the codec — maps, sets,
; vectors, nested structures all work.
(def history-key (db/ref conn :events :session-1))
(db/put-key! history-key
  [:event-log
   {:t 0 :kind :login}
   {:t 1 :kind :click :target :button}
   {:t 2 :kind :logout}])

(db/get-key history-key)

; Phase 4.0b: explicit transactions via `with-tx` / `with-read-tx`.
; Multi-write atomicity: the body either fully commits OR fully
; aborts. An exception inside the body aborts; the read after
; sees the pre-tx state.
(def bob (db/ref conn :users :bob))
(with-tx [tx conn]
  (db/put! tx alice {:age 31 :note :updated-via-with-tx})
  (db/put! tx bob {:age 25}))

(with-read-tx [t conn]
  [:alice (db/get t alice)
   :bob (db/get t bob)])

; Throwing inside `with-tx` rolls back.
(def rolled-back
  (try
    (with-tx [tx conn]
      (db/put! tx alice {:age 999 :note :should-not-persist})
      (throw :oops))
    (catch any e [:caught e])))

; alice still has the {:age 31 ...} from the successful tx.
(def after-rollback (db/get-key alice))

; Delete + close.
(db/delete-key! alice)
(db/delete-key! bob)
(db/close conn)

[:rolled-back rolled-back :after-rollback after-rollback]
