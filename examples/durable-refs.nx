; examples/durable-refs.nx — durable refs: a ref names a key in a store
; file, and its value outlives the process. Run it twice: the second run
; finds what the first one wrote. The store is tmp/refs.edb under the
; working directory; delete tmp/ to start over.
;
;   bin/nexis run examples/durable-refs.nx

; db/open opens the file, creating it and its directories.
(def conn (db/open "tmp/refs.edb"))

; A ref is a tree name and a key in that file. Refs are values: two made
; the same way are equal.
(def runs (db/ref conn :app :runs))
(prn (= runs (db/ref conn :app "runs")))

; db/get-key reads (with a default), db/put-key! writes, and @ reads too.
; Each is its own small transaction.
(db/put-key! runs (inc (db/get-key runs 0)))
(println "run number" @runs)

; Any nexis value can be stored: maps, sets, vectors, nested.
(def ada (db/ref conn :users :ada))
(db/put-key! ada {:name "Ada" :langs #{"nexis"} :scores [90 95]})
(prn @ada (db/present? ada) (db/present? (db/ref conn :users :nobody)))

; with-tx groups writes into one transaction: all of them commit, or
; none do. db/alter! applies a function to the stored value.
(def grace (db/ref conn :users :grace))
(with-tx [tx conn]
  (db/put! tx grace {:name "Grace" :langs #{"COBOL"} :scores [88]})
  (db/alter! tx ada update :scores conj 99))

; with-read-tx reads several refs as of one moment.
(with-read-tx [tx conn]
  (prn (:scores (db/get tx ada)) (:name (db/get tx grace))))

; A throw inside with-tx rolls every write back.
(prn (try
       (with-tx [tx conn]
         (db/put! tx ada {:name "overwritten"})
         (throw :changed-my-mind))
       (catch :changed-my-mind _ :rolled-back)))
(prn (:name @ada))

; Remove the users, keep the run counter, and close the file.
(db/delete-key! ada)
(db/delete-key! grace)
(db/close conn)
