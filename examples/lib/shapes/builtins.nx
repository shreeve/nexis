; examples/lib/shapes/builtins.nx — Shape for built-in kinds: a number
; is a square's side, and a string a label with no area. Requiring this
; namespace installs them; it defines nothing to call.

(ns lib.shapes.builtins
  (:require [lib.shapes.protocol :as p]))

(extend-protocol p/Shape
  :fixnum
  (area [n] (* n n))
  (describe [n] (str "Square of side " n))

  :string
  (area [_] 0)
  (describe [s] (str "Label " (pr-str s))))
