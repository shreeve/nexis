; examples/lib/shapes/records.nx — records implementing the Shape
; protocol from another namespace, named through its alias.

(ns lib.shapes.records
  (:require [lib.shapes.protocol :as p]))

(defrecord Circle [radius]
  p/Shape
  (area [_] (* 3.14159 radius radius))
  (describe [_] (str "Circle of radius " radius)))

(defrecord Rect [width height]
  p/Shape
  (area [_] (* width height))
  (describe [_] (str "Rect " width "x" height)))

; A record can also be extended after it is defined. Outside defrecord
; the fields are not locals, so the methods destructure them.
(defrecord Triangle [base height])

(extend-type Triangle
  p/Shape
  (area [{:keys [base height]}] (/ (* base height) 2))
  (describe [{:keys [base]}] (str "Triangle with base " base)))
