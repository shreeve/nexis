; examples/lib/geom.nx — a small library for examples/require-demo.nx.
; A required file starts with the ns form that names it: lib.geom lives
; at lib/geom.nx.

(ns lib.geom)

(defn area-of-square [side]
  (* side side))

(defn area-of-rectangle [w h]
  (* w h))

(defn perimeter-of-square [side]
  (* 4 side))

(defn point [x y]
  [:point x y])
