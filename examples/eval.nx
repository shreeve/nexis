; examples/eval.nx — code is data: read-string turns text into a form,
; and eval runs a form in the current namespace, as the REPL runs a
; line. A def inside it defines a Var later code sees, a defmacro serves
; a later eval, and a function it returns can be called afterwards.
;
;   bin/nexis run examples/eval.nx

(def source "(defn square [x] (* x x))")
(eval (read-string source))
(println "square 12 =" (square 12))

(def forms ['(+ 1 2) '(let [x 2] (* x x)) '(str "a" "b")])
(println "each form:" (map eval forms))

(eval '(def answer 42))
(println "answer =" answer)

(let [f (eval '(fn [n] (* n answer)))]
  (println "closure from eval:" (f 2)))

(eval '(defmacro unless [test & body] (list 'if test nil (cons 'do body))))
(println "macro from eval:" (eval '(unless false :ran)))

; A form that does not compile throws a :compile-error map, which
; carries the form.
(println "compile error in"
  (try (eval '(no-such-fn 1))
       (catch :compile-error e (:form e))))

; A throw inside the evaluated form is an ordinary throw.
(try (eval '(throw :boom))
     (catch :boom e (println "caught" e)))
