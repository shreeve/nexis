; examples/todo-app.nx — a to-do list kept in a store file, so it lasts
; between runs. The first run adds three to-dos and finishes one; a later
; run finds them as the first run left them. The store is tmp/todos.edb
; under the working directory; delete tmp/ to start over.
;
;   bin/nexis run examples/todo-app.nx

(def conn (db/open "tmp/todos.edb"))

; Every to-do lives in the :todos tree under a key of its own.
(defn todo-ref [id]
  (db/ref conn :todos id))

(defn add-todo! [id title]
  (with-tx [tx conn]
    (db/put! tx (todo-ref id) {:title title :done false})))

; db/alter! reads, applies a function and writes, in one transaction.
(defn complete! [id]
  (with-tx [tx conn]
    (db/alter! tx (todo-ref id) assoc :done true)))

; db/scan returns [key value] pairs in key order, each key a string.
(defn all-todos []
  (with-read-tx [tx conn]
    (db/scan tx :todos)))

; db/reduce-tree folds over the tree without building the whole list.
(defn stats []
  (with-read-tx [tx conn]
    (db/reduce-tree tx :todos
                    (fn [acc _id {:keys [done]}]
                      (cond-> (update acc :total inc)
                        done (update :done inc)))
                    {:total 0 :done 0})))

(defn print-todos []
  (doseq [[_id {:keys [title done]}] (all-todos)]
    (println (if done "  [x]" "  [ ]") title)))

; Add the to-dos only when they are not there yet, so a second run keeps
; what the first one did.
(doseq [[id title] [[:buy-milk "Buy milk"]
                    [:write-tests "Write the tests"]
                    [:ship "Ship the release"]]]
  (when-not (db/present? (todo-ref id))
    (add-todo! id title)))

(let [{:keys [total done]} (stats)]
  (println (format "at start: %d to-dos, %d done" total done)))

(complete! :buy-milk)
(print-todos)

; A transaction that throws writes nothing: the to-do it added is gone.
(println "rollback:"
         (try
           (with-tx [tx conn]
             (db/put! tx (todo-ref :never) {:title "Never saved" :done false})
             (throw :cancelled))
           (catch :cancelled _ "cancelled"))
         "/ saved?" (db/present? (todo-ref :never)))

; @ reads one ref in a transaction of its own.
(prn @(todo-ref :buy-milk))
(prn (stats))

(db/close conn)
