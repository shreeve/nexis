; src/stdlib/edn.nx — the `nexis.edn` namespace, Clojure's clojure.edn
; (which names this namespace; docs/STDLIB.md §4). Embedded via
; @embedFile and bootstrapped with nexis.edn current.

(defn read-string
  "Returns the first value read from the string s as data, never
  evaluated; nil for a nil s. With no opts a string with no form is
  nil; opts go to nexis.core/read-string as they are, so with no :eof
  in them it is :reader-error. There are no tagged literals: a tag is
  :reader-error, and :readers and :default find nothing to apply to."
  ([s] (read-string {:eof nil} s))
  ([opts s] (when s (nexis.core/read-string opts s))))
