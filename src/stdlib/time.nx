; src/stdlib/time.nx — the `nexis.time` namespace: instants (the inst
; values #inst reads), ISO-8601 text and durations (docs/STDLIB.md §12),
; over the natives in src/stdlib.zig internal_natives. Embedded via
; @embedFile and bootstrapped with nexis.time as the current namespace.

(defn parse
  "The instant the ISO-8601 text s names, in the grammar of #inst:
  2026-10-09, 2026-10-09T12:30Z, 2026-10-09T12:30:15.123+02:00 and the
  like, a missing offset UTC, a fraction truncated to the millisecond.
  Other text is :invalid-argument."
  [s]
  (nexis.internal/#%parse-instant s))

(defn instant
  "The instant of x: an instant (any Inst) itself, epoch milliseconds
  (an integer), or ISO-8601 text as parse reads it."
  [x]
  (cond (inst? x) (nexis.internal/#%inst (inst-ms x))
        (integer? x) (nexis.internal/#%inst x)
        (string? x) (parse x)
        :else (nexis.internal/#%raise :kind-mismatch "instant takes an instant, an integer or ISO-8601 text, got" x)))

(defn- ms
  "The epoch milliseconds of x, which instant takes."
  [x]
  (inst-ms (instant x)))

(defn now
  "The wall clock as an instant, to the millisecond."
  []
  (nexis.internal/#%inst (nexis.internal/#%now-ms)))

(defn format
  "The ISO-8601 text of the instant x (or what instant takes), in UTC
  as Java's Instant.toString writes it: 2026-10-09T12:30:15.123Z, the
  fraction left out when it is zero."
  [x]
  (nexis.internal/#%format-instant (instant x)))

(defn seconds "n seconds, as a duration in milliseconds." [n] (* n 1000))
(defn minutes "n minutes, as a duration in milliseconds." [n] (* n 60000))
(defn hours "n hours, as a duration in milliseconds." [n] (* n 3600000))
(defn days "n days of 24 hours, as a duration in milliseconds." [n] (* n 86400000))

(defn plus
  "The instant each duration (milliseconds) later than the instant x."
  [x & durations]
  (nexis.internal/#%inst (long (apply + (ms x) durations))))

(defn minus
  "The instant each duration (milliseconds) earlier than the instant x."
  [x & durations]
  (nexis.internal/#%inst (long (apply - (ms x) durations))))

(defn between
  "The duration from the instant a to the instant b in milliseconds,
  negative when b is earlier."
  [a b]
  (- (ms b) (ms a)))

(defn before?
  "Whether the instant a is earlier than the instant b."
  [a b]
  (< (ms a) (ms b)))

(defn after?
  "Whether the instant a is later than the instant b."
  [a b]
  (> (ms a) (ms b)))
