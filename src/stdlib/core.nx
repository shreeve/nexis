; src/stdlib/core.nx
;
; The part of nexis.core written in nexis itself: user-facing
; macros and functions built on the natives that
; stdlib.installCore provides. Embedded via @embedFile and
; evaluated into nexis.core at VM startup, after the natives are
; installed, so everything here is auto-referred by user code.

; ============================================================
; Simple predicates + accessors
; ============================================================

(defn true?  [x] (= x true))
(defn false? [x] (= x false))

; second, third, take, some and every? are natives that walk no
; further than they must.
(defn ffirst [x] (first (first x)))
(defn nfirst [x] (next (first x)))
(defn fnext [x] (second x))
(defn nnext [x] (next (next x)))

(defn last [s]
  ; Walk by reducing; the reduce fn keeps only the latest x.
  (reduce (fn* [_ x] x) nil s))

; ============================================================
; Sequence transforms
; ============================================================

(defn reverse [s]
  ; reduce + cons builds the list in reverse order naturally.
  (reduce (fn* [acc x] (cons x acc)) (list) s))

; (drop n coll) → a seq of coll without its first n elements, () when
; none are left.
(defn drop [n s]
  (or (seq (nthrest s n)) (list)))

; (nthnext coll n) → the elements after the first n, nil when none.
(defn nthnext [coll n]
  (seq (nthrest coll n)))

; ============================================================
; Conditional macros
; ============================================================

; (if-let [binding test] then else?) → then with binding bound to
; test's value when it is truthy, else. The binding may destructure;
; any other shape fails to expand, as in Clojure.
(defmacro if-let [binding then & else]
  (when (or (not (vector? binding)) (not= 2 (count binding)) (next else))
    (throw (ex-info "if-let takes [binding test], then and an optional else" {})))
  `(let [temp# ~(second binding)]
     (if temp#
       (let [~(first binding) temp#] ~then)
       ~(first else))))

; (when-let [binding test] body...) → body when test is truthy.
(defmacro when-let [binding & body]
  `(let [temp# ~(second binding)]
     (when temp#
       (let [~(first binding) temp#] ~@body))))

; (if-some [binding test] then else?) / (when-some [binding test]
; body...) → as if-let / when-let, but only nil fails: false binds.
(defmacro if-some [binding then & else]
  (when (or (not (vector? binding)) (not= 2 (count binding)) (next else))
    (throw (ex-info "if-some takes [binding test], then and an optional else" {})))
  `(let [temp# ~(second binding)]
     (if (nil? temp#)
       ~(first else)
       (let [~(first binding) temp#] ~then))))

(defmacro when-some [binding & body]
  `(let [temp# ~(second binding)]
     (if (nil? temp#)
       nil
       (let [~(first binding) temp#] ~@body))))

; (when-first [x coll] body...) → body with x bound to the first
; element, when coll has one.
(defmacro when-first [binding & body]
  `(let [s# (seq ~(second binding))]
     (when s#
       (let [~(first binding) (first s#)] ~@body))))

; (comment ...) → nil; the body is never evaluated or compiled, so
; it may hold anything that reads (PLAN §23 #27).
(defmacro comment [& _] nil)

; (doto x (f a) g ...) → x, after (f x a), (g x), ... in order.
(defmacro doto [x & forms]
  (let [g (gensym "doto")]
    `(let [~g ~x]
       ~@(map (fn [f] (if (seq? f) `(~(first f) ~g ~@(rest f)) `(~f ~g))) forms)
       ~g)))

; (defonce name expr) → defines name as expr's value unless it
; already has one; expr is not evaluated then.
(defmacro defonce [name expr]
  `(let [v# (def ~name)]
     (when-not (bound? v#) (def ~name ~expr))
     v#))

; (assert x) / (assert x message) → nil when x is truthy, else throws
; ex-info "Assert failed: <message or the form>" whose data's :error
; is :assertion-failed. The printed form and the data are built when
; the macro expands, so the check costs its test and the failure one
; call.
(defmacro assert [x & message]
  `(when-not ~x
     (throw (ex-info ~(cond
                        (empty? message) (str "Assert failed: " (pr-str x))
                        (string? (first message)) (str "Assert failed: " (first message) "\n" (pr-str x))
                        true `(str "Assert failed: " ~(first message) ~(str "\n" (pr-str x))))
                     {:error :assertion-failed}))))

; (time expr) → expr's value, after printing how long it took, as
; Clojure's does.
(defmacro time [expr]
  `(let [start# (nano-time)
         ret# ~expr]
     (prn (str "Elapsed time: " (/ (double (- (nano-time) start#)) 1000000.0) " msecs"))
     ret#))

; (with-out-str body...) → what body printed, as a string; nothing
; reaches stdout. Captures nest.
(defmacro with-out-str [& body]
  `(do (nexis.internal/#%push-out)
       (try (do ~@body)
            (catch any e# (nexis.internal/#%pop-out) (throw e#)))
       (nexis.internal/#%pop-out)))

; (dotimes [name n-expr] body...)
;   runs body n times with name bound to 0..n-1.
;   Returns nil.
(defmacro dotimes [binding & body]
  `(let* [limit# ~(first (rest binding))]
     (loop* [~(first binding) 0]
       (if (< ~(first binding) limit#)
         (do ~@body
             (recur (inc ~(first binding))))
         nil))))

; ============================================================
; Durable transaction macros
; ============================================================
;
; `(with-tx [tx conn] body...)` opens a write transaction,
; runs body, commits on normal exit, aborts on exception
; (rethrows the exception). Returns body's result.
;
; `(with-read-tx [tx conn] body...)` opens a read snapshot,
; runs body, aborts on exit (reads never commit). Returns
; body's result.

(defmacro with-tx [binding & body]
  `(let* [~(first binding) (db/begin-write ~(first (rest binding)))]
     (try
       (let* [r# (do ~@body)]
         (db/commit! ~(first binding))
         r#)
       (catch any e#
         (db/abort-write! ~(first binding))
         (throw e#)))))

(defmacro with-read-tx [binding & body]
  `(let* [~(first binding) (db/begin-read ~(first (rest binding)))]
     (try
       (let* [r# (do ~@body)]
         (db/abort-read! ~(first binding))
         r#)
       (catch any e#
         (db/abort-read! ~(first binding))
         (throw e#)))))

; Snapshot vocabulary (docs/DB.md §12).
;
; A snapshot is an emdb read transaction pinned to the commit
; generation that was current when it began. As long as the
; snapshot is alive, all reads through it see EXACTLY that
; state regardless of subsequent writes.
;
; `(with-snapshot [snap conn] body...)` opens a snapshot,
; runs body, releases on exit. Identical semantics to
; `with-read-tx`; different name matches the user-facing
; "I'm pinning to a point in time" mental model.
;
; To pin a snapshot past block scope: call `(db/snapshot conn)`
; directly and `(db/release-snapshot! snap)` when done. The
; snapshot is an ordinary Value — pass it to functions, store
; it, compare it for identity.
;
; Caveat (docs/DB.md §12): long-held snapshots prevent emdb
; from reclaiming pages they reference. Don't pin snapshots
; you don't intend to release.

(defmacro with-snapshot [binding & body]
  `(let* [~(first binding) (db/snapshot ~(first (rest binding)))]
     (try
       (let* [r# (do ~@body)]
         (db/release-snapshot! ~(first binding))
         r#)
       (catch any e#
         (db/release-snapshot! ~(first binding))
         (throw e#)))))

; ============================================================
; Dynamic bindings (docs/VM.md §6.5)
; ============================================================
;
; (binding [*a* 1 *b* 2] body...) evaluates every value first, in
; the bindings outside the form, then pushes one binding frame
; for the dynamic Vars named and runs the body; the frame pops in
; a finally, so a throw restores the previous bindings on its way
; out. A closure called inside the body sees the bindings in
; force at the call, wherever it was made. A Var not marked
; ^:dynamic throws :not-dynamic before anything is rebound.

(defmacro binding [bindings & body]
  `(do (push-thread-bindings
         (hash-map ~@(mapcat (fn [pair] [`(var ~(first pair)) (second pair)])
                             (partition 2 bindings))))
       (try
         (do ~@body)
         (finally (pop-thread-bindings)))))

; (set! *a* v) is a special form of the expander (docs/MACROEXPAND.md
; §2b): it rebinds the innermost binding of *a* to v through var-set
; and returns v, :not-dynamic outside a dynamic Var, :no-thread-binding
; outside any binding of it, and refuses a lexical name at compile
; time. The root binding never changes here; def is the only root
; write.

; ============================================================
; Function combinators and collection helpers
; ============================================================
;
; Each defn builds on the natives: reduce, loop*, cons, assoc,
; apply. A fold over `reduce` stops on a `reduced` value the way
; Clojure's does; the others iterate with `loop*` and an explicit
; exit.

; (unreduced x) → the value inside a reduced, else x.
(defn unreduced [x]
  (if (reduced? x) @x x))

; (ensure-reduced x) → x if already reduced, else (reduced x).
(defn ensure-reduced [x]
  (if (reduced? x) x (reduced x)))

; ---- function composition helpers ----

; (constantly x) → fn taking any args, always returns x.
(defn constantly [x]
  (fn* [& _] x))

; (complement f) → fn returning the logical-not of f.
(defn complement [f]
  (fn* [& args] (not (apply f args))))

; (partial f & args) → fn taking more args, prepending the
; closed-over `args`.
(defn partial [f & bound]
  (fn* [& more] (apply f (concat bound more))))

; (comp & fns) → fn that applies the rightmost fn to args,
; then walks left passing single results. (comp) → identity.
; (comp f) → f. Matches Clojure's right-to-left composition.
(defn comp [& fns]
  (if (empty? fns)
    identity
    (let* [reversed (reverse fns)
           first-fn (first reversed)
           rest-fns (rest reversed)]
      (fn* [& args]
        (reduce (fn* [acc f] (f acc))
                (apply first-fn args)
                rest-fns)))))

; ---- short-circuiting predicates over sequences ----

; (not-every? pred coll) → true iff pred is falsy for at
; least one elt. (Inverse of every?.)
(defn not-every? [pred coll]
  (not (every? pred coll)))

; (not-any? pred coll) → true iff pred is falsy for all elts.
(defn not-any? [pred coll]
  (if (some pred coll) false true))

; ---- collection extras ----

; (merge & maps) → left-to-right map merge. Later keys win.
; (merge) → nil, and so does a merge of nils only; the first
; non-nil map decides the result's kind, so a record stays one.
(defn merge [& maps]
  (when (some some? maps)
    (reduce conj (remove nil? maps))))

; (update m k f & args) → assoc m with k → (apply f (get m k) args).
(defn update [m k f & args]
  (assoc m k (apply f (cons (get m k) args))))

; (get-in m [k1 k2 ...]) → nested lookup. nil if any step
; misses. (get-in m ks default) → default when any key along
; the path is absent (a present nil value is still nil).
(defn get-in
  ([m ks]
   (reduce (fn* [acc k] (if (nil? acc) nil (get acc k)))
           m
           ks))
  ([m ks default]
   ; A fresh atom is identical to no value a map holds.
   (let* [missing (atom nil)]
     (loop* [acc m s (seq ks)]
       (if (nil? s)
         acc
         (let* [v (get acc (first s) missing)]
           (if (identical? v missing)
             default
             (recur v (next s)))))))))

; (assoc-in m [k1 k2 ...] v) → m with the nested path set to v.
(defn assoc-in [m ks v]
  (if (empty? (rest ks))
    (assoc m (first ks) v)
    (assoc m
           (first ks)
           (assoc-in (get m (first ks)) (rest ks) v))))

; (update-in m [k1 k2 ...] f & args) → assoc-in over the
; result of applying f to the current value.
(defn update-in [m ks f & args]
  (assoc-in m ks (apply f (cons (get-in m ks) args))))

; ---- sequence breakdown helpers ----

; (frequencies coll) → map counting occurrences of each elt.
(defn frequencies [coll]
  (reduce (fn* [acc x] (assoc acc x (inc (get acc x 0))))
          {}
          coll))

; (group-by f coll) → map from (f x) to vector of matching xs.
; Order within each bucket is left-to-right.
(defn group-by [f coll]
  (reduce (fn* [acc x]
            (let* [k (f x)
                   bucket (get acc k [])]
              (assoc acc k (conj bucket x))))
          {}
          coll))

; (interpose sep coll) → coll with sep between each pair of
; adjacent elements. Returns a list.
(defn interpose [sep coll]
  (if (empty? coll)
    (list)
    (loop* [s (rest coll) acc (list (first coll))]
      (if (empty? s)
        (reverse acc)
        (recur (rest s) (cons (first s) (cons sep acc)))))))

; ============================================================
; Function combinators
; ============================================================

; (juxt f g ...) → fn returning [(f args) (g args) ...].
(defn juxt [& fs]
  (fn* [& args]
    (mapv (fn* [f] (apply f args)) fs)))

; (vary-meta obj f & args) → obj carrying (apply f (meta obj) args).
(defn vary-meta [obj f & args]
  (with-meta obj (apply f (meta obj) args)))

; (fnil f d1 d2? d3?) → f, with nil leading arguments replaced
; by the defaults, one per position.
(defn fnil
  ([f d1]
   (fn* [x & more]
     (apply f (if (nil? x) d1 x) more)))
  ([f d1 d2]
   (fn* [x y & more]
     (apply f (if (nil? x) d1 x) (if (nil? y) d2 y) more)))
  ([f d1 d2 d3]
   (fn* [x y z & more]
     (apply f (if (nil? x) d1 x) (if (nil? y) d2 y) (if (nil? z) d3 z) more))))

; (merge-with f & maps) → merge where a key present on both
; sides keeps (f left right).
(defn merge-with [f & maps]
  (reduce (fn* [acc m]
            (if (nil? m)
              acc
              (reduce (fn* [a k]
                        (if (contains? a k)
                          (assoc a k (f (get a k) (get m k)))
                          (assoc a k (get m k))))
                      acc
                      (keys m))))
          (first maps)
          (rest maps)))

; ============================================================
; Control-flow macros
; ============================================================

; (doc name) → prints the Var's :arglists and :doc, the way a
; REPL shows them; nil. A defn carries them once it is given a
; docstring or attribute map.
(defmacro doc [name]
  `(let* [m# (meta (var ~name))
          arglists# (:arglists m#)
          docstring# (:doc m#)]
     (println "-------------------------")
     (println '~name)
     (when arglists# (println arglists#))
     (when docstring# (println " " docstring#))
     nil))

; (declare a b ...) → interns each name as an unbound Var so a
; later definition can be referred to before it appears, even
; when a macro will produce that definition.
(defmacro declare [& names]
  `(do ~@(map (fn* [n] (list 'def n)) names) nil))

; (if-not test then else?) → (if test else then).
(defmacro if-not [test then & else]
  `(if ~test ~(first else) ~then))

; (while test body...) → loops until test is falsy; nil.
(defmacro while [test & body]
  `(loop* []
     (if ~test
       (do ~@body (recur))
       nil)))

; (letfn [(f [x] ...) (g [y] ...)] body...) — mutually
; recursive local functions; the primitive takes the same shape.
(defmacro letfn [bindings & body]
  `(letfn* ~bindings ~@body))

; (doseq [x xs modifiers... y ys ...] body...) → runs body for
; each x in xs and, nested inside, each y in ys; nil. A binding
; form may destructure, and each pair may be followed by
; `:let [b]`, `:when t` (skip the element) and `:while t` (end
; that loop), as in `for`. One loop per pair:
;   (loop* [s (seq xs)]
;     (if s (let [x (first s)] <modifiers around
;                               (do (doseq [rest...] body...) (recur (next s)))>)
;           nil))
(defmacro doseq [bindings & body]
  (if (empty? bindings)
    `(do ~@body nil)
    (let* [pat (first bindings)
           src (second bindings)
           s (gensym "s")]
      (loop* [more (rest (rest bindings)) mods (list)]
        (if (and (seq more) (keyword? (first more)))
          (recur (rest (rest more)) (cons [(first more) (second more)] mods))
          (let* [inner (reduce (fn* [inner mod]
                                 (let* [k (first mod) v (second mod)]
                                   (cond
                                     (= k :let) `(let ~v ~inner)
                                     (= k :when) `(if ~v ~inner (recur (next ~s)))
                                     (= k :while) `(if ~v ~inner nil)
                                     true (throw (str "doseq: unknown modifier " k)))))
                               `(do (doseq ~(vec more) ~@body) (recur (next ~s)))
                               mods)]
            `(loop* [~s (seq ~src)]
               (if ~s
                 (let [~pat (first ~s)] ~inner)
                 nil))))))))

; ============================================================
; Threading macros
; ============================================================

; (cond-> x test step ...) → threads x through each step whose
; test is truthy. The tests are ordinary expressions; they are
; not threaded, exactly as in Clojure.
(defmacro cond-> [expr & clauses]
  (if (empty? clauses)
    expr
    `(let* [g# ~expr
            next# (if ~(first clauses) (-> g# ~(second clauses)) g#)]
       (cond-> next# ~@(rest (rest clauses))))))

(defmacro cond->> [expr & clauses]
  (if (empty? clauses)
    expr
    `(let* [g# ~expr
            next# (if ~(first clauses) (->> g# ~(second clauses)) g#)]
       (cond->> next# ~@(rest (rest clauses))))))

; (some-> x f g ...) → threads while the value is non-nil.
(defmacro some-> [expr & forms]
  (if (empty? forms)
    expr
    `(let* [g# ~expr]
       (if (nil? g#)
         nil
         (some-> (-> g# ~(first forms)) ~@(rest forms))))))

(defmacro some->> [expr & forms]
  (if (empty? forms)
    expr
    `(let* [g# ~expr]
       (if (nil? g#)
         nil
         (some->> (->> g# ~(first forms)) ~@(rest forms))))))

; (as-> x name form ...) → binds name to x, then to each form
; in turn.
(defmacro as-> [expr name & forms]
  (if (empty? forms)
    expr
    `(let* [~name ~expr]
       (as-> ~(first forms) ~name ~@(rest forms)))))

; ============================================================
; More sequence and function helpers
; ============================================================

; (some-fn p & ps) → a fn returning the first truthy result of a
; predicate on an argument, in Clojure's order: each predicate over the
; first three arguments, then each further argument against every
; predicate (every predicate against those arguments past three
; predicates). A miss is the last result for up to three predicates
; and three arguments, else nil. (every-pred p & ps) → a fn true when
; every predicate is truthy of every argument.
(defn some-fn [p & ps]
  (let [ps (cons p ps)
        many (> (count ps) 3)
        hit (fn [f coll]
              (loop [s (seq coll) r nil]
                (if s (let [v (f (first s))] (if v v (recur (next s) v))) r)))]
    (fn [& xs]
      (let [more (drop 3 xs)
            r (hit (fn [p] (hit p (take 3 xs))) ps)]
        (cond r r
              (seq more) (if many
                           (some (fn [p] (some p more)) ps)
                           (some (fn [x] (hit (fn [p] (p x)) ps)) more))
              many nil
              true r)))))

(defn every-pred [& ps]
  (fn [& xs] (every? (fn [p] (every? p xs)) ps)))

; (memoize f) → f, caching each result by its arguments.
(defn memoize [f]
  (let [cache (atom {})]
    (fn [& args]
      (let [hit (find @cache args)]
        (if hit
          (val hit)
          (let [r (apply f args)]
            (swap! cache assoc args r)
            r))))))

; (trampoline f & args) → calls f, then each fn it returns, until a
; value that is not a fn comes back; mutual recursion without stack.
(defn trampoline [f & args]
  (loop [r (apply f args)]
    (if (fn? r) (recur (r)) r)))

; (comparator pred) → a comparator of two arguments from a "less
; than" predicate.
(defn comparator [pred]
  (fn [a b] (cond (pred a b) -1 (pred b a) 1 true 0)))

; (run! f coll) → calls f on each element for its effect; nil.
(defn run! [f coll]
  (reduce (fn [_ x] (f x) nil) nil coll))

; Sequences are eager, so doall and dorun only return.
(defn doall [coll] coll)
(defn dorun [coll] nil)

; (partition-by f coll) → coll split each time (f x) changes.
(defn partition-by [f coll]
  (loop [s (seq coll) acc [] run [] k nil]
    (if s
      (let [x (first s) fx (f x)]
        (if (or (empty? run) (= fx k))
          (recur (next s) acc (conj run x) fx)
          (recur (next s) (conj acc (seq run)) [x] fx)))
      (or (seq (if (empty? run) acc (conj acc (seq run)))) (list)))))

; (dedupe coll) → coll without consecutive duplicates.
(defn dedupe [coll]
  (or (seq (reduce (fn [acc x] (if (and (seq acc) (= x (peek acc))) acc (conj acc x))) [] coll)) (list)))

; (take-nth n coll) → every nth element, starting with the first.
(defn take-nth [n coll]
  (keep-indexed (fn [i x] (when (zero? (rem i n)) x)) coll))

; (split-with pred coll) → [(take-while pred coll) (drop-while pred coll)].
(defn split-with [pred coll]
  [(take-while pred coll) (drop-while pred coll)])

; (distinct? x & xs) → whether no two arguments are equal.
(defn distinct? [& xs]
  (= (count xs) (count (set xs))))

; (tree-seq branch? children root) → the nodes of the tree under root,
; depth first, each before its children; an explicit stack, so the
; depth of the tree costs no native stack.
(defn tree-seq [branch? children root]
  (loop [stack (list root) acc (transient [])]
    (if (seq stack)
      (let [node (first stack) more (rest stack)]
        (recur (if (branch? node) (into more (reverse (children node))) more)
               (conj! acc node)))
      (seq (persistent! acc)))))

; (replace smap coll) → coll with each element that is a key of smap
; (a map, or a vector by index) replaced by its value: a vector of a
; vector, keeping its metadata, else a seq.
(defn replace [smap coll]
  (let [f (fn [x] (let [e (find smap x)] (if e (val e) x)))]
    (if (vector? coll) (with-meta (mapv f coll) (meta coll)) (map f coll))))

; (bounded-count n coll) → the count of a counted coll, else the count
; of at most its first n elements.
(defn bounded-count [n coll]
  (if (counted? coll)
    (count coll)
    (loop [i 0 s (seq coll)]
      (if (and s (< i n)) (recur (inc i) (next s)) i))))

; (random-sample prob coll) → the elements of coll each kept with
; probability prob.
(defn random-sample [prob coll]
  (filter (fn [_] (< (rand) prob)) coll))

; partition and partition-all with each part a vector, and split-at
; with the first part a vector (Clojure 1.12).
(defn partitionv
  ([n coll] (map vec (partition n coll)))
  ([n step coll] (map vec (partition n step coll)))
  ([n step pad coll] (map vec (partition n step pad coll))))
(defn partitionv-all
  ([n coll] (map vec (partition-all n coll)))
  ([n step coll] (map vec (partition-all n step coll))))
(defn splitv-at [n coll]
  [(vec (take n coll)) (drop n coll)])

; (map-entry? x) → whether x is a map entry: a two-element vector, the
; shape a map's seq yields.
(defn map-entry? [x] (and (vector? x) (= 2 (count x))))

; (rseq v) → v's elements last first, nil when empty.
(defn rseq [v]
  (seq (reverse v)))

; (rand-nth coll) → a random element; (shuffle coll) → a vector of
; coll's elements in random order.
(defn rand-nth [coll]
  (nth coll (rand-int (count coll))))

(defn shuffle [coll]
  (loop [v (vec coll) i (dec (count v))]
    (if (pos? i)
      (let [j (rand-int (inc i)) vi (nth v i)]
        (recur (assoc v i (nth v j) j vi) (dec i)))
      v)))

; (update-vals m f) / (update-keys m f) → a map of m's entries with f
; applied to every value / key, keeping m's metadata.
(defn update-vals [m f]
  (with-meta (persistent! (reduce-kv (fn [acc k v] (assoc! acc k (f v))) (transient {}) m)) (meta m)))

(defn update-keys [m f]
  (with-meta (persistent! (reduce-kv (fn [acc k v] (assoc! acc (f k) v)) (transient {}) m)) (meta m)))

; (reset-vals! a v) → [old new] after setting a to v.
(defn reset-vals! [a v]
  (swap-vals! a (constantly v)))

; Volatiles are atoms: one isolate, one thread.
(defn volatile! [x] (atom x))
(defn volatile? [x] (atom? x))
(defn vreset! [v x] (reset! v x))
(defmacro vswap! [v f & args]
  `(swap! ~v ~f ~@args))

; ---- predicates ----
(defn any? [_] true)
(defn ident? [x] (or (keyword? x) (symbol? x)))
(defn qualified-keyword? [x] (boolean (and (keyword? x) (namespace x))))
(defn simple-keyword? [x] (and (keyword? x) (nil? (namespace x))))
(defn qualified-symbol? [x] (boolean (and (symbol? x) (namespace x))))
(defn simple-symbol? [x] (and (symbol? x) (nil? (namespace x))))
; int? and its kin: an integer in Java's long range, as Clojure's are
; true of a Long and not a BigInt.
(defn int? [x] (and (integer? x) (<= -9223372036854775808 x 9223372036854775807)))
(defn pos-int? [x] (and (int? x) (pos? x)))
(defn nat-int? [x] (and (int? x) (not (neg? x))))
(defn neg-int? [x] (and (int? x) (neg? x)))
(defn double? [x] (float? x))
(defn seqable? [x] (or (nil? x) (coll? x) (string? x) (typed-vector? x)))
(defn record? [x] (nexis.internal/#%record? x))

; ---- the numeric names Clojure spells apart ----
; Every integer operator promotes to a bignum (docs/BIGNUM.md), so the
; promoting forms are the same functions.
(def +' +)
(def -' -)
(def *' *)
(def inc' inc)
(def dec' dec)

; The unchecked operators wrap two longs at 64 bits, as Java's long
; arithmetic does; with a float or an integer beyond 64 bits they
; compute as the checked operator does, as Clojure's do.
(defn- wrap64 [r x y]
  (if (and (int? x) (int? y))
    (let [m (mod r 18446744073709551616)]
      (if (< m 9223372036854775808) m (- m 18446744073709551616)))
    r))
(defn unchecked-add [x y] (wrap64 (+ x y) x y))
(defn unchecked-subtract [x y] (wrap64 (- x y) x y))
(defn unchecked-multiply [x y] (wrap64 (* x y) x y))
(defn unchecked-inc [x] (wrap64 (inc x) x 0))
(defn unchecked-dec [x] (wrap64 (dec x) x 0))
(defn unchecked-negate [x] (wrap64 (- x) x 0))

; (num x) → x, a number or nil; there are no boxed kinds to convert.
(defn num [x] (if (or (nil? x) (number? x)) x (throw :kind-mismatch)))
; No rationals (PLAN §23 #10): the rationals are the integers.
(defn ratio? [_] false)
(defn rational? [x] (integer? x))
(defn parse-boolean [s]
  (cond (= s "true") true (= s "false") false (string? s) nil true (throw :kind-mismatch)))

; (ex-cause e) → the cause an ex-info carries, nil for anything else.
(defn ex-cause [e]
  (when (map? e) (:cause e)))

; (printf fmt & args) → prints (format fmt args...); nil.
(defn printf [fmt & args]
  (print (apply format fmt args)))

; ============================================================
; Delays, closing, taps
; ============================================================

; (delay body...) → a delay: body runs the first time the delay is
; forced (force or deref), and every later force returns its value,
; or rethrows what it threw. A delay is the record nexis.core/Delay,
; whose :state atom holds [:pending thunk], [:ready v] or [:failed e].
(defmacro delay [& body]
  `(nexis.internal/#%delay (fn* [] ~@body)))

(defn force [x]
  (if (delay? x)
    (let [state (:state x)
          s @state]
      (case (first s)
        :ready (second s)
        :failed (throw (second s))
        (try
          (let [v ((second s))]
            (reset! state [:ready v])
            v)
          (catch any e
            (reset! state [:failed e])
            (throw e)))))
    x))

; (realized? d) → whether the delay has been forced.
(defn realized? [x]
  (if (delay? x) (not= :pending (first @(:state x))) (throw :kind-mismatch)))

; What with-open closes: a db connection, a Nextomic connection, and
; any type extended to it (Java's Closeable).
(defprotocol Closeable
  (close [this]))
(extend-protocol Closeable
  :db_connection (close [c] (db/close c))
  :nextomic_conn (close [c] (nextomic/release c)))

; (with-open [name init ...] body...) → body with each name bound,
; closing each through Closeable in reverse order on every exit, a
; throw included.
(defmacro with-open [bindings & body]
  (when (or (not (vector? bindings)) (odd? (count bindings)) (not (every? symbol? (take-nth 2 bindings))))
    (throw (ex-info "with-open takes a vector of symbol and value pairs" {})))
  (if (empty? bindings)
    `(do ~@body)
    `(let [~(first bindings) ~(second bindings)]
       (try
         (with-open ~(vec (drop 2 bindings)) ~@body)
         (finally (nexis.core/close ~(first bindings)))))))

; (tap> x) → true, after calling every function add-tap added with x;
; a tap that throws is ignored. Clojure runs taps on another thread;
; here, one isolate and one thread, they run before tap> returns.
(def ^:private taps (atom #{}))
(defn add-tap [f] (swap! taps conj f) nil)
(defn remove-tap [f] (swap! taps disj f) nil)
(defn tap> [x]
  (doseq [f @taps]
    (try (f x) (catch any _ nil)))
  true)

; ============================================================
; Printing to a string
; ============================================================

(defn newline [] (print "\n"))
(defn print-str [& xs] (with-out-str (apply print xs)))
(defn println-str [& xs] (with-out-str (apply println xs)))
(defn prn-str [& xs] (with-out-str (apply prn xs)))

; ============================================================
; The command line
; ============================================================

; The arguments after the program on the command line, as a vector
; of strings; nil when there are none. `nexis run` binds it.
(def *command-line-args* nil)
