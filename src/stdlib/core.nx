; src/stdlib/core.nx
;
; The part of nexis.core written in nexis itself: user-facing
; macros and functions built on the natives that
; stdlib.installCore provides. Embedded via @embedFile and
; evaluated into nexis.core at VM startup, after the natives are
; installed, so everything here is auto-referred by user code.

; ============================================================
; Simple predicates + accessors
; ============================================================

(defn true?  "Returns true if x is the value true." [x] (= x true))
(defn false? "Returns true if x is the value false." [x] (= x false))

; second, take, some and every? are natives that walk no
; further than they must.
(defn ffirst "Returns (first (first x))." [x] (first (first x)))
(defn nfirst "Returns (next (first x))." [x] (next (first x)))
(defn fnext "Returns (first (next x)), the second element." [x] (second x))
(defn nnext "Returns (next (next x))." [x] (next (next x)))

; ============================================================
; Sequence transforms
; ============================================================

(defmacro lazy-seq
  "Returns a lazy seq whose body runs once, when the seq is first
  walked, its result (a seq, a collection or nil) cached. A body that
  throws ends the seq there on the next walk."
  [& body]
  `(nexis.internal/#%lazy-seq (fn* [] ~@body)))

(defmacro lazy-cat
  "Returns the lazy concatenation of the colls, each coll expression
  evaluated only when the walk reaches it."
  [& colls]
  `(concat ~@(map (fn* [c] `(lazy-seq ~c)) colls)))

; The barrier through which = and hash realize a lazy block they meet
; (docs/LAZY.md §6): [true seq], or [false thrown] for a throw, which
; the VM parks.
(defn- realize-caught [s]
  (try [true (nexis.internal/#%force s)] (catch any e [false e])))


; ============================================================
; Conditional macros
; ============================================================

; Fails the expansion of the binding macro `macro` unless `binding` is
; [binding test] and `else` holds at most one form, as Clojure's
; assert-args does.
(defn- check-binding [macro binding else]
  (when (or (not (vector? binding)) (not= 2 (count binding)))
    (throw (ex-info (str macro " requires exactly 2 forms in binding vector") {})))
  (when (next else)
    (throw (ex-info (str macro " requires 1 or 2 forms after binding vector") {}))))

(defmacro if-let
  "binding is [form test]. When test is truthy, evaluates then with form
  bound to its value, else evaluates else (nil when absent). form may
  destructure; a binding of any other shape fails to expand."
  [binding then & else]
  (check-binding "if-let" binding else)
  `(let [temp# ~(second binding)]
     (if temp#
       (let [~(first binding) temp#] ~then)
       ~(first else))))

(defmacro when-let
  "binding is [form test]. When test is truthy, evaluates body with form
  bound to its value and returns the last value, else nil."
  [binding & body]
  (check-binding "when-let" binding nil)
  `(let [temp# ~(second binding)]
     (when temp#
       (let [~(first binding) temp#] ~@body))))

(defmacro if-some
  "binding is [form test]. As if-let, but only a nil test takes the
  else branch: false is bound."
  [binding then & else]
  (check-binding "if-some" binding else)
  `(let [temp# ~(second binding)]
     (if (nil? temp#)
       ~(first else)
       (let [~(first binding) temp#] ~then))))

(defmacro when-some
  "binding is [form test]. As when-let, but only a nil test skips the
  body: false is bound."
  [binding & body]
  (check-binding "when-some" binding nil)
  `(let [temp# ~(second binding)]
     (if (nil? temp#)
       nil
       (let [~(first binding) temp#] ~@body))))

(defmacro when-first
  "binding is [x coll]. When (seq coll) is non-nil, evaluates body with
  x bound to its first element, else returns nil."
  [binding & body]
  (check-binding "when-first" binding nil)
  `(let [s# (seq ~(second binding))]
     (when s#
       (let [~(first binding) (first s#)] ~@body))))

; The body is never compiled (PLAN §23 #27).
(defmacro comment
  "Ignores the body and returns nil. The body is never evaluated or
  compiled, so it may hold anything that reads."
  [& _] nil)

(defmacro doto
  "Evaluates x, then calls each form with that value inserted as its
  first argument, in order: (doto x (f a) g) calls (f x a), then (g x).
  Returns x."
  [x & forms]
  (let [g (gensym "doto")]
    `(let [~g ~x]
       ~@(map (fn [f] (if (seq? f) `(~(first f) ~g ~@(rest f)) `(~f ~g))) forms)
       ~g)))

(defmacro defonce
  "Defines name as the value of expr unless the Var is already bound,
  in which case expr is not evaluated. Returns the Var when it defines
  name, else nil."
  [name expr]
  `(let [v# (def ~name)]
     (when-not (bound? v#) (def ~name ~expr))))

; The printed form is built when the macro expands, so the check costs
; its test and the failure one call of two constants, a conj that makes
; a fresh map each time.
(defmacro assert
  "Returns nil when x is truthy, else throws {:error :assertion-failed
  :message \"Assert failed: ...\"} holding message, when given, and the
  form x: the value a failed :pre or :post condition throws."
  [x & message]
  `(when-not ~x
     (throw (conj {:error :assertion-failed}
                  [:message ~(cond
                               (empty? message) (str "Assert failed: " (pr-str x))
                               (string? (first message)) (str "Assert failed: " (first message) "\n" (pr-str x))
                               true `(str "Assert failed: " ~(first message) ~(str "\n" (pr-str x))))]))))

(defmacro time
  "Evaluates expr, prints the time it took as \"Elapsed time: N msecs\"
  (with prn), and returns its value."
  [expr]
  `(let [start# (nano-time)
         ret# ~expr]
     (prn (str "Elapsed time: " (/ (double (- (nano-time) start#)) 1000000.0) " msecs"))
     ret#))

(defmacro with-out-str
  "Evaluates body and returns what it printed, as a string; nothing
  reaches stdout. Captures nest."
  [& body]
  `(do (nexis.internal/#%push-out)
       (try (do ~@body)
            (catch any e# (nexis.internal/#%pop-out) (throw e#)))
       (nexis.internal/#%pop-out)))

(defmacro dotimes
  "binding is [name n]. Evaluates body n times, with name bound to the
  integers 0 through n-1; n is truncated to an integer as long does.
  Returns nil."
  [binding & body]
  `(let* [limit# (long ~(first (rest binding)))]
     (loop* [~(first binding) 0]
       (if (< ~(first binding) limit#)
         (do ~@body
             (recur (inc ~(first binding))))
         nil))))

; ============================================================
; Durable transaction macros (docs/DB.md §12)
; ============================================================

(defmacro with-tx
  "binding is [tx conn]. Begins a write transaction on the db
  connection conn, evaluates body with tx bound to it, commits and
  returns body's value; when body throws, aborts and rethrows."
  [binding & body]
  `(let* [~(first binding) (db/begin-write ~(first (rest binding)))]
     (try
       (let* [r# (do ~@body)]
         (db/commit! ~(first binding))
         r#)
       (catch any e#
         (db/abort-write! ~(first binding))
         (throw e#)))))

(defmacro with-read-tx
  "binding is [tx conn]. Begins a read transaction on the db connection
  conn, evaluates body with tx bound to it, and aborts the transaction
  afterwards, whether or not body throws. Returns body's value."
  [binding & body]
  `(let* [~(first binding) (db/begin-read ~(first (rest binding)))]
     (try (do ~@body)
          (finally (db/abort-read! ~(first binding))))))

; A snapshot is an emdb read transaction pinned to the commit
; generation that was current when it began (docs/DB.md §12).

(defmacro with-snapshot
  "binding is [snap conn]. with-read-tx under the snapshot names: body
  sees the store as of the snapshot, which is released afterwards. To
  hold one past a block, call db/snapshot and db/release-snapshot!; a
  held snapshot keeps emdb from reclaiming the pages it sees."
  [binding & body]
  `(let* [~(first binding) (db/snapshot ~(first (rest binding)))]
     (try (do ~@body)
          (finally (db/release-snapshot! ~(first binding))))))

; ============================================================
; Dynamic bindings (docs/VM.md §6.5)
; ============================================================
;
; One binding frame for the Vars named, pushed after every value is
; evaluated and popped in a finally.

(defmacro binding
  "bindings is [var-name val ...]. Evaluates every val, then binds each
  dynamic Var to its value while body runs, restoring the previous
  bindings on every exit, a throw included. A function called inside
  sees them wherever it was made. A Var not ^:dynamic is :not-dynamic."
  [bindings & body]
  `(do (push-thread-bindings
         (hash-map ~@(mapcat (fn [pair] [`(var ~(first pair)) (second pair)])
                             (partition 2 bindings))))
       (try
         (do ~@body)
         (finally (pop-thread-bindings)))))

; (set! *a* v) is a special form of the expander (docs/MACROEXPAND.md
; §2b): it rebinds the innermost binding of *a* to v through var-set
; and returns v, :not-dynamic outside a dynamic Var, :no-thread-binding
; outside any binding of it, and refuses a lexical name at compile
; time. The root binding never changes here; def and alter-var-root
; write roots.

(defn with-redefs-fn
  "binding-map is {#'v val ...}. Calls func with each Var's root set to
  its value, restoring every root on every exit (a Var that was unbound
  is unbound again). A root write, not a binding: every caller sees it,
  and a Var need not be dynamic. Returns func's value."
  [binding-map func]
  (let* [old-vals (reduce-kv (fn* [m v _] (assoc m v (when (bound? v) [(alter-var-root v identity)]))) {} binding-map)]
    (try
      (reduce-kv (fn* [_ v x] (alter-var-root v (constantly x))) nil binding-map)
      (func)
      (finally
        (reduce-kv (fn* [_ v old] (if old (alter-var-root v (constantly (old 0))) (nexis.internal/#%unbind-root v))) nil old-vals)))))

(defmacro with-redefs
  "bindings is [name val ...]. Evaluates body with the root of each Var
  a name resolves to set to its val, as with-redefs-fn does, and every
  root restored afterwards. A call the compiler inlines (arithmetic,
  comparison) does not go through the Var."
  [bindings & body]
  `(with-redefs-fn
     (hash-map ~@(mapcat (fn [pair] [`(var ~(first pair)) (second pair)])
                         (partition 2 bindings)))
     (fn [] ~@body)))

; The compiler sets the root before it expands each top-level form,
; and in-ns when it switches (STDLIB.md §8).
(def ^:dynamic *ns*
  "The namespace a form is compiled in, as its name symbol. A binding
  of it does not change where forms compile."
  'nexis.core)

; ============================================================
; Function combinators and collection helpers
; ============================================================
;
; Each defn builds on the natives: reduce, loop*, cons, assoc,
; apply. A fold over `reduce` stops on a `reduced` value the way
; Clojure's does; the others iterate with `loop*` and an explicit
; exit.

(defn unreduced
  "Returns the value inside x when x is reduced, else x."
  [x]
  (if (reduced? x) @x x))

(defn ensure-reduced
  "Returns x when it is already reduced, else (reduced x)."
  [x]
  (if (reduced? x) x (reduced x)))

; ---- function composition helpers ----

(defn constantly
  "Returns a function that takes any number of arguments and returns
  x."
  [x]
  (fn* [& _] x))

(defn complement
  "Returns a function that takes the same arguments as f and returns
  the opposite truth value."
  [f]
  (fn* [& args] (not (apply f args))))

(defn partial
  "Returns a function that calls f with bound followed by its own
  arguments."
  [f & bound]
  (fn* [& more] (apply f (concat bound more))))

(defn comp
  "Returns the composition of fns: a function that applies the
  rightmost to its arguments, then each fn to its left to the result.
  (comp) is identity."
  [& fns]
  (if (empty? fns)
    identity
    (let* [reversed (reverse fns)
           first-fn (first reversed)
           rest-fns (rest reversed)]
      (fn* [& args]
        (reduce (fn* [acc f] (f acc))
                (apply first-fn args)
                rest-fns)))))

; ---- short-circuiting predicates over sequences ----

(defn not-every?
  "Returns false if (pred x) is truthy for every x in coll, else true."
  [pred coll]
  (not (every? pred coll)))

(defn not-any?
  "Returns false if (pred x) is truthy for any x in coll, else true."
  [pred coll]
  (if (some pred coll) false true))

; ---- collection extras ----

(defn merge
  "Returns a map of the maps conj'd onto the first left to right, a
  later key's value winning; {} stands for a leading nil or false.
  nil when every map is nil or false."
  [& maps]
  (when (some identity maps)
    (reduce (fn* [acc m] (conj (or acc {}) m)) maps)))

; The short arities call f directly, with no argument list to build.
(defn update
  "Returns m with the value at k replaced by (f (get m k)), any further
  arguments passed to f after the old value."
  ([m k f] (assoc m k (f (get m k))))
  ([m k f x] (assoc m k (f (get m k) x)))
  ([m k f x y] (assoc m k (f (get m k) x y)))
  ([m k f x y & more] (assoc m k (apply f (get m k) x y more))))

(defn get-in
  "Returns the value in nested associative m at the path of keys ks:
  nil, or default when given, if a key along the path is absent. A
  present nil value is nil."
  ([m ks]
   (reduce (fn* [acc k] (if (nil? acc) nil (get acc k)))
           m
           ks))
  ([m ks default]
   ; A fresh atom is identical to no value a map holds.
   (let* [missing (atom nil)]
     (loop* [acc m s (seq ks)]
       (if (nil? s)
         acc
         (let* [v (get acc (first s) missing)]
           (if (identical? v missing)
             default
             (recur v (next s)))))))))

(defn assoc-in
  "Returns m with v at the nested path of keys ks, creating maps for
  levels that do not exist."
  [m ks v]
  (if (empty? (rest ks))
    (assoc m (first ks) v)
    (assoc m
           (first ks)
           (assoc-in (get m (first ks)) (rest ks) v))))

(defn update-in
  "Returns m with the value at the nested path of keys ks replaced by
  (apply f old-value args), creating maps for levels that do not
  exist. An empty path is the one key nil."
  [m ks f & args]
  (let* [k (first ks)
         more (next ks)]
    (assoc m k (if more
                 (apply update-in (get m k) more f args)
                 (apply f (get m k) args)))))

; ---- lazy sequence functions (docs/LAZY.md §7), Clojure 1.12's ----

(defn interleave
  "Returns a lazy seq of the first item of each coll, then the second
  of each, and so on, ending when the shortest coll does."
  ([] ())
  ([c1] (lazy-seq c1))
  ([c1 c2]
   (lazy-seq
     (let [s1 (seq c1) s2 (seq c2)]
       (when (and s1 s2)
         (cons (first s1) (cons (first s2) (interleave (rest s1) (rest s2))))))))
  ([c1 c2 & colls]
   (lazy-seq
     (let [ss (map seq (conj colls c2 c1))]
       (when (every? identity ss)
         (concat (map first ss) (apply interleave (map rest ss))))))))

(defn interpose
  "Returns a lazy seq of the elements of coll with sep between each
  adjacent pair. Returns a transducer when no coll is given."
  ([sep] (xf-interpose sep))
  ([sep coll] (drop 1 (interleave (repeat sep) coll))))

(defn take-nth
  "Returns a lazy seq of every nth element of coll, starting with the
  first. Returns a transducer when no coll is given."
  ([n]
   (fn* [rf]
     (let [iv (atom -1)]
       (fn ([] (rf))
           ([result] (rf result))
           ([result input]
            (if (zero? (rem (swap! iv inc) n)) (rf result input) result))))))
  ([n coll]
   (lazy-seq
     (when-let [s (seq coll)]
       (cons (first s) (take-nth n (drop n s)))))))

(defn partition-by
  "Returns a lazy seq of the runs of coll, split each time (f x)
  returns a new value. Returns a transducer when no coll is given."
  ([f] (xf-partition-by f))
  ([f coll]
  (lazy-seq
    (when-let [s (seq coll)]
      (let [fst (first s)
            fv (f fst)
            run (cons fst (take-while (fn [x] (= fv (f x))) (next s)))]
        (cons run (partition-by f (lazy-seq (drop (count run) s)))))))))

; The seqs of children still to visit wait on an explicit stack, so the
; depth of the tree costs no native stack.
(defn tree-seq
  "Returns a lazy seq of the nodes of the tree under root, depth first,
  each before its children. (children node) gives the children of a
  node for which (branch? node) is truthy. A tree of any depth walks."
  [branch? children root]
  (let [walk (fn walk [node stack]
               (lazy-seq
                 (cons node
                       (let [stack (if (branch? node) (cons (children node) stack) stack)]
                         (lazy-seq
                           (loop [stack stack]
                             (when (seq stack)
                               (if-let [s (seq (first stack))]
                                 (walk (first s) (cons (rest s) (rest stack)))
                                 (recur (rest stack))))))))))]
    (walk root ())))

(defn flatten
  "Returns a lazy seq of the non-sequential leaves of nested lists and
  vectors in x, depth first; nil leaves are kept. (flatten x) of an x
  that is not sequential, nil included, is ()."
  [x]
  (filter (complement sequential?) (rest (tree-seq sequential? seq x))))

(defn reductions
  "Returns a lazy seq of the intermediate values of (reduce f init
  coll), init first, ending at a reduced value. Without init, starts
  from the first element, or (f) when coll is empty."
  ([f coll]
   (lazy-seq
     (if-let [s (seq coll)]
       (reductions f (first s) (rest s))
       (list (f)))))
  ([f init coll]
   (if (reduced? init)
     (list @init)
     (cons init
           (lazy-seq
             (when-let [s (seq coll)]
               (reductions f (f init (first s)) (rest s))))))))

(defn drop-last
  "Returns a lazy seq of all but the last n elements of coll, n 1 by
  default."
  ([coll] (drop-last 1 coll))
  ([n coll] (map (fn [x _] x) coll (drop n coll))))

(defn split-at
  "Returns [(take n coll) (drop n coll)]."
  [n coll]
  [(take n coll) (drop n coll)])

; ============================================================
; Function combinators
; ============================================================

(defn juxt
  "Returns a function that calls each of fs on its arguments and
  returns the vector of results: ((juxt a b) x) is [(a x) (b x)]."
  [& fs]
  (fn* [& args]
    (mapv (fn* [f] (apply f args)) fs)))

(defn vary-meta
  "Returns obj with metadata (apply f (meta obj) args)."
  [obj f & args]
  (with-meta obj (apply f (meta obj) args)))

(defn fnil
  "Returns a function that calls f with a nil first argument replaced
  by d1, a nil second by d2 and a nil third by d3, as many as are
  given; further arguments pass through."
  ([f d1]
   (fn* [x & more]
     (apply f (if (nil? x) d1 x) more)))
  ([f d1 d2]
   (fn* [x y & more]
     (apply f (if (nil? x) d1 x) (if (nil? y) d2 y) more)))
  ([f d1 d2 d3]
   (fn* [x y z & more]
     (apply f (if (nil? x) d1 x) (if (nil? y) d2 y) (if (nil? z) d3 z) more))))

(defn merge-with
  "Returns a map of the maps merged left to right; a key present in
  more than one keeps (f val-in-result val-in-latter). nil maps are
  skipped."
  [f & maps]
  (reduce (fn* [acc m]
            (if (nil? m)
              acc
              (reduce (fn* [a k]
                        (if (contains? a k)
                          (assoc a k (f (get a k) (get m k)))
                          (assoc a k (get m k))))
                      acc
                      (keys m))))
          (first maps)
          (rest maps)))

; ============================================================
; Control-flow macros
; ============================================================

(defmacro declare
  "Interns each of names as an unbound Var, so code can refer to it
  before its definition appears. Returns nil."
  [& names]
  `(do ~@(map (fn* [n] (list 'def n)) names) nil))

(defmacro if-not
  "Evaluates then when test is falsy, else evaluates else (nil when
  absent)."
  [test then & else]
  `(if ~test ~(first else) ~then))

(defmacro while
  "Evaluates body repeatedly while test is truthy. Returns nil."
  [test & body]
  `(loop* []
     (if ~test
       (do ~@body (recur))
       nil)))

; The primitive letfn* takes the same shape.
(defmacro letfn
  "bindings is [(name [params] body...) ...]. Evaluates body with each
  name bound to its function; the functions may call each other, and
  themselves, in any order."
  [bindings & body]
  `(letfn* ~bindings ~@body))

; Fails the expansion of the binding macro `who` unless its bindings
; are a vector of pairs whose first is a binding, as Clojure's
; assert-args does.
(defn- check-seq-exprs [who bindings]
  (when-not (vector? bindings)
    (throw (ex-info (str who " requires a vector for its binding") {})))
  (when (odd? (count bindings))
    (throw (ex-info (str who " requires an even number of forms in binding vector") {})))
  (when (keyword? (first bindings))
    (throw (ex-info (str who ": a modifier needs a binding before it") {}))))

; The modifiers of one binding of doseq or for, [[k v] ...] in source
; order, wrapped around leaf, the first outermost: :let binds, :when
; evaluates skip when false, :while ends the walk (nil).
(defn- wrap-mods [who mods skip leaf]
  (reduce (fn [inner [k v]]
            (cond (= k :let) `(let ~v ~inner)
                  (= k :when) `(if ~v ~inner ~skip)
                  (= k :while) `(when ~v ~inner)
                  true (throw (ex-info (str who ": unknown modifier " k) {}))))
          leaf
          (reverse mods)))

; One loop per binding, the modifiers around the rest:
;   (loop* [s (seq xs)]
;     (if s (let [x (first s)] <(do (doseq [rest...] body...) (recur (next s)))>)
;           nil))
(defmacro doseq
  "bindings is [x xs modifiers... y ys ...]. Evaluates body for each x
  in xs and, nested inside, each y in ys, for effect. A binding may
  destructure, and :let [b], :when t and :while t modifiers work as in
  for. Returns nil."
  [bindings & body]
  (check-seq-exprs "doseq" bindings)
  (if (empty? bindings)
    `(do ~@body nil)
    (let* [s (gensym "s")
           pairs (partition 2 (drop 2 bindings))
           mods (take-while (fn* [p] (keyword? (first p))) pairs)
           more (vec (apply concat (drop (count mods) pairs)))]
      `(loop* [~s (seq ~(second bindings))]
         (if ~s
           (let [~(first bindings) (first ~s)]
             ~(wrap-mods "doseq" mods `(recur (next ~s)) `(do (doseq ~more ~@body) (recur (next ~s)))))
           nil)))))

; Clojure 1.12's for (docs/LAZY.md §7): one iterator per binding, each
; a lazy-seq over the seq of its coll; the innermost walks a chunk at a
; time where its coll is chunked, applying the modifiers inside the
; chunk; an outer one concatenates the inner seq onto the walk of its
; rest. One binding and no modifiers is (map (fn [binding] body) coll).
(defmacro for
  "seq-exprs is [binding coll modifiers... binding coll ...]. Returns
  the lazy seq of body-expr for each combination of bindings, the last
  varying fastest. Modifiers: :let [b], :when t (skip the element) and
  :while t (end that binding's walk)."
  [seq-exprs body-expr]
  (check-seq-exprs "for" seq-exprs)
  (when (empty? seq-exprs)
    (throw (ex-info "for requires a binding" {})))
  (if (= 2 (count seq-exprs))
    `(map (fn* [x#] (let [~(first seq-exprs) x#] ~body-expr)) ~(second seq-exprs))
    (let [groups (reduce (fn* [groups pair]
                           (if (keyword? (first pair))
                             (conj (pop groups) (conj (peek groups) pair))
                             (conj groups [(first pair) (second pair)])))
                         [] (partition 2 seq-exprs))
          emit-bind
          (fn emit-bind [groups]
            (let [group (first groups)
                  bind (first group)
                  mod-pairs (drop 2 group)
                  next-groups (next groups)
                  giter (gensym "iter__")
                  gxs (gensym "s__")]
              (if next-groups
                `(fn ~giter [~gxs]
                   (lazy-seq
                     (loop [~gxs ~gxs]
                       (when-first [~bind ~gxs]
                         ~(wrap-mods "for" mod-pairs `(recur (rest ~gxs))
                                     `(let [iterys# ~(emit-bind next-groups)
                                            fs# (seq (iterys# ~(second (first next-groups))))]
                                        (if fs#
                                          (concat fs# (~giter (rest ~gxs)))
                                          (recur (rest ~gxs)))))))))
                (let [gi (gensym "i__")
                      gb (gensym "b__")
                      gc (gensym "c__")
                      gsize (gensym "size__")]
                  `(fn ~giter [~gxs]
                     (lazy-seq
                       (loop [~gxs ~gxs]
                         (when-let [~gxs (seq ~gxs)]
                           (if (chunked-seq? ~gxs)
                             (let [~gc (chunk-first ~gxs)
                                   ~gsize (count ~gc)
                                   ~gb (chunk-buffer ~gsize)]
                               (if (loop [~gi 0]
                                     (if (< ~gi ~gsize)
                                       (let [~bind (nth ~gc ~gi)]
                                         ~(wrap-mods "for" mod-pairs `(recur (inc ~gi))
                                                     `(do (chunk-append ~gb ~body-expr) (recur (inc ~gi)))))
                                       true))
                                 (chunk-cons (chunk ~gb) (~giter (chunk-rest ~gxs)))
                                 (chunk-cons (chunk ~gb) nil)))
                             (let [~bind (first ~gxs)]
                               ~(wrap-mods "for" mod-pairs `(recur (rest ~gxs))
                                           `(cons ~body-expr (~giter (rest ~gxs))))))))))))))]
      `(let [iter# ~(emit-bind groups)]
         (iter# ~(second seq-exprs))))))

; ============================================================
; Threading macros
; ============================================================

; The threading macros below expand once, to one let chain over their
; steps, as Clojure's do, so a long chain costs linear expansion. Each
; binds g to every step but the last, which is the body.
(defn- step-chain [g init steps]
  `(let [~g ~init ~@(interleave (repeat (count steps) g) (butlast steps))]
     ~(if (empty? steps) g (last steps))))

(defmacro cond->
  "clauses are test step pairs. Threads expr through each step whose
  test is truthy, as -> does (as its first argument). The tests are
  not threaded."
  [expr & clauses]
  (assert (even? (count clauses)))
  (let [g (gensym)]
    (step-chain g expr (map (fn [[test step]] `(if ~test (-> ~g ~step) ~g)) (partition 2 clauses)))))

(defmacro cond->>
  "clauses are test step pairs. Threads expr through each step whose
  test is truthy, as ->> does (as its last argument). The tests are
  not threaded."
  [expr & clauses]
  (assert (even? (count clauses)))
  (let [g (gensym)]
    (step-chain g expr (map (fn [[test step]] `(if ~test (->> ~g ~step) ~g)) (partition 2 clauses)))))

(defmacro some->
  "Threads expr through forms as -> does, stopping with nil at the
  first nil value."
  [expr & forms]
  (let [g (gensym)]
    (step-chain g expr (map (fn [step] `(if (nil? ~g) nil (-> ~g ~step))) forms))))

(defmacro some->>
  "Threads expr through forms as ->> does, stopping with nil at the
  first nil value."
  [expr & forms]
  (let [g (gensym)]
    (step-chain g expr (map (fn [step] `(if (nil? ~g) nil (->> ~g ~step))) forms))))

(defmacro as->
  "Binds name to expr, then to the value of each form in turn, and
  returns the last; name may appear anywhere in a form."
  [expr name & forms]
  (step-chain name expr forms))

; ============================================================
; More sequence and function helpers
; ============================================================

; The search runs in Clojure's order: each predicate over the first
; three arguments, then each further argument against every predicate
; (every predicate against those arguments past three predicates). A
; miss is the last result for up to three predicates and three
; arguments, else nil.
(defn some-fn
  "Returns a function that returns the first truthy value of any of
  the predicates p and ps applied to any of its arguments, else a
  falsy value."
  [p & ps]
  (let [ps (cons p ps)
        many (> (count ps) 3)
        hit (fn [f coll]
              (loop [s (seq coll) r nil]
                (if s (let [v (f (first s))] (if v v (recur (next s) v))) r)))]
    (fn [& xs]
      (let [more (drop 3 xs)
            r (hit (fn [p] (hit p (take 3 xs))) ps)]
        (cond r r
              (seq more) (if many
                           (some (fn [p] (some p more)) ps)
                           (some (fn [x] (hit (fn [p] (p x)) ps)) more))
              many nil
              true r)))))

(defn every-pred
  "Returns a function that returns true when every predicate in ps is
  truthy of every one of its arguments, else false."
  [& ps]
  (fn [& xs] (every? (fn [p] (every? p xs)) ps)))

(defn memoize
  "Returns a memoized version of f: a function that caches the result
  of f for each list of arguments, calling f on the first call only."
  [f]
  (let [cache (atom {})]
    (fn [& args]
      (let [hit (find @cache args)]
        (if hit
          (val hit)
          (let [r (apply f args)]
            (swap! cache assoc args r)
            r))))))

(defn trampoline
  "Calls (apply f args), then calls each function it returns with no
  arguments, until a value that is not a function comes back, and
  returns it: mutual recursion without growing the stack."
  [f & args]
  (loop [r (apply f args)]
    (if (fn? r) (recur (r)) r)))

(defn comparator
  "Returns a comparator (-1, 0 or 1) of two arguments from pred, a
  less-than predicate."
  [pred]
  (fn [a b] (cond (pred a b) -1 (pred b a) 1 true 0)))

(defn run!
  "Calls f on each element of coll, for effect, through reduce: a
  reduced value from f ends the walk. Returns nil."
  [f coll]
  (reduce (fn [_ x] (f x)) nil coll)
  nil)


(defn split-with
  "Returns [(take-while pred coll) (drop-while pred coll)]."
  [pred coll]
  [(take-while pred coll) (drop-while pred coll)])

; With a transducer, a producer that hands out 32 outputs at a time
; (docs/LAZY.md §10).
(defn sequence
  "Returns coll when it is a seq, else (seq coll), () when empty. With
  xform, returns the lazy seq of coll's elements through the
  transducer; with several colls, xform gets an element of each."
  ([coll] (if (seq? coll) coll (or (seq coll) ())))
  ([xform coll] (nexis.internal/#%sequence xform coll))
  ([xform coll & colls] (nexis.internal/#%sequence xform (apply map vector coll colls) true)))

(defn distinct?
  "Returns true if no two of the arguments are =."
  [x & xs]
  (= (inc (count xs)) (count (set (cons x xs)))))


(defn- replacer [smap] (fn [x] (let [e (find smap x)] (if e (val e) x))))

(defn replace
  "Returns coll with each element that is a key of smap (a map, or a
  vector by index) replaced by its value: a vector, keeping its
  metadata, when coll is one, else a lazy seq. Returns a transducer
  when no coll is given."
  ([smap] (map (replacer smap)))
  ([smap coll]
   (let [f (replacer smap)]
     (if (vector? coll) (with-meta (mapv f coll) (meta coll)) (map f coll)))))

(defn bounded-count
  "Returns (count coll) when coll is counted?, else the count of at
  most its first n elements: (bounded-count 2 \"abcd\") is 2."
  [n coll]
  (if (counted? coll)
    (count coll)
    (loop [i 0 s (seq coll)]
      (if (and s (< i n)) (recur (inc i) (next s)) i))))

(defn random-sample
  "Returns a lazy seq of the elements of coll, each kept with
  probability prob. Returns a transducer when no coll is given."
  ([prob] (filter (fn [_] (< (rand) prob))))
  ([prob coll] (filter (fn [_] (< (rand) prob)) coll)))

(defn partitionv
  "As partition, with each part a vector."
  ([n coll] (map vec (partition n coll)))
  ([n step coll] (map vec (partition n step coll)))
  ([n step pad coll] (map vec (partition n step pad coll))))
(defn partitionv-all
  "As partition-all, with each part a vector. Returns a transducer
  when no coll is given."
  ([n] (partition-all n))
  ([n coll] (map vec (partition-all n coll)))
  ([n step coll] (map vec (partition-all n step coll))))
(defn splitv-at
  "Returns [(vec (take n coll)) (drop n coll)]."
  [n coll]
  [(vec (take n coll)) (drop n coll)])

(defn map-entry?
  "Returns true if x is a two-element vector, the shape of a map's
  entries. Unlike Clojure, (map-entry? [1 2]) is true."
  [x] (and (vector? x) (= 2 (count x))))


(defn rand-nth
  "Returns a random element of coll, found by nth."
  [coll]
  (nth coll (rand-int (count coll))))

(defn shuffle
  "Returns a vector of the elements of coll in random order."
  [coll]
  (loop [v (vec coll) i (dec (count v))]
    (if (pos? i)
      (let [j (rand-int (inc i)) vi (nth v i)]
        (recur (assoc v i (nth v j) j vi) (dec i)))
      v)))

(defn update-vals
  "Returns a map of m's keys, each with (f value), keeping m's
  metadata."
  [m f]
  (with-meta (persistent! (reduce-kv (fn [acc k v] (assoc! acc k (f v))) (transient {}) m)) (meta m)))

(defn update-keys
  "Returns a map of m's values, each under (f key), keeping m's
  metadata. Keys f maps to one key keep one of their values."
  [m f]
  (with-meta (persistent! (reduce-kv (fn [acc k v] (assoc! acc (f k) v)) (transient {}) m)) (meta m)))

(defn reset-vals!
  "Sets the value of atom a to v. Returns [old new]."
  [a v]
  (swap-vals! a (constantly v)))

; Volatiles are atoms: one isolate, one thread (docs/ATOM.md §4.7).
(defn volatile!
  "Returns a volatile holding x. A volatile is an atom (atom? is true):
  with one thread there is nothing to give up."
  [x] (atom x))
(defn volatile?
  "Returns true if x is a volatile, which is any atom."
  [x] (atom? x))
(defn vreset!
  "Sets the value of volatile v to x, as reset!. Returns x."
  [v x] (reset! v x))
(defmacro vswap!
  "Sets the value of volatile v to (apply f current args), as swap!.
  Returns the new value."
  [v f & args]
  `(swap! ~v ~f ~@args))

; Clojure's definition, with re-find's result in place of a second
; re-groups (docs/REGEX.md §9).
(defn re-seq
  "Returns a lazy seq of the successive matches of re in s, each as
  re-find returns it, finding one match per element; nil when there
  is none."
  [re s]
  (let [m (re-matcher re s)]
    ((fn step []
       (when-some [g (re-find m)]
         (cons g (lazy-seq (step))))))))

; ---- predicates ----
(defn any? "Returns true for any argument." [_] true)
(defn ident? "Returns true if x is a keyword or a symbol." [x] (or (keyword? x) (symbol? x)))
(defn qualified-keyword? "Returns true if x is a keyword with a namespace." [x] (boolean (and (keyword? x) (namespace x))))
(defn simple-keyword? "Returns true if x is a keyword without a namespace." [x] (and (keyword? x) (nil? (namespace x))))
(defn qualified-symbol? "Returns true if x is a symbol with a namespace." [x] (boolean (and (symbol? x) (namespace x))))
(defn simple-symbol? "Returns true if x is a symbol without a namespace." [x] (and (symbol? x) (nil? (namespace x))))
(defn qualified-ident? "Returns true if x is a keyword or symbol with a namespace." [x] (boolean (and (ident? x) (namespace x))))
(defn simple-ident? "Returns true if x is a keyword or symbol without a namespace." [x] (and (ident? x) (nil? (namespace x))))
; int? and its kin: an integer in Java's long range, as Clojure's are
; true of a Long and not a BigInt.
(defn int?
  "Returns true if x is an integer in the 64-bit signed range; a larger
  integer (a bignum) is not one."
  [x] (and (integer? x) (<= -9223372036854775808 x 9223372036854775807)))
(defn pos-int? "Returns true if x is a positive int?." [x] (and (int? x) (pos? x)))
(defn nat-int? "Returns true if x is a non-negative int?." [x] (and (int? x) (not (neg? x))))
(defn neg-int? "Returns true if x is a negative int?." [x] (and (int? x) (neg? x)))
(defn double? "Returns true if x is a float; every float is a double." [x] (float? x))
(defn seqable?
  "Returns true if seq works on x: nil, a collection, a string or a
  typed vector."
  [x] (or (nil? x) (coll? x) (string? x) (typed-vector? x)))
(defn record? "Returns true if x is a record." [x] (nexis.internal/#%record? x))

; ---- the numeric names Clojure spells apart ----
; Every integer operator promotes to a bignum (docs/BIGNUM.md), so the
; promoting forms are the same functions.
(def ^{:arglists '([] [x] [x y] [x y & more])} +'
  "The same function as +: every integer operator promotes to a bignum." +)
(def ^{:arglists '([x] [x y] [x y & more])} -'
  "The same function as -: every integer operator promotes to a bignum." -)
(def ^{:arglists '([] [x] [x y] [x y & more])} *'
  "The same function as *: every integer operator promotes to a bignum." *)
(def ^{:arglists '([x])} inc'
  "The same function as inc: every integer operator promotes to a bignum." inc)
(def ^{:arglists '([x])} dec'
  "The same function as dec: every integer operator promotes to a bignum." dec)

; The unchecked operators wrap two longs at 64 bits, as Java's long
; arithmetic does; with a float or an integer beyond 64 bits they
; compute as the checked operator does, as Clojure's do.
(defn- wrap64 [r x y]
  (if (and (int? x) (int? y))
    (let [m (mod r 18446744073709551616)]
      (if (< m 9223372036854775808) m (- m 18446744073709551616)))
    r))
(defn unchecked-add
  "Returns x + y, wrapped to 64 bits when both are integers in the long
  range (as Java's long arithmetic); otherwise as +."
  [x y] (wrap64 (+ x y) x y))
(defn unchecked-subtract
  "Returns x - y, wrapped to 64 bits when both are integers in the long
  range (as Java's long arithmetic); otherwise as -."
  [x y] (wrap64 (- x y) x y))
(defn unchecked-multiply
  "Returns x * y, wrapped to 64 bits when both are integers in the long
  range (as Java's long arithmetic); otherwise as *."
  [x y] (wrap64 (* x y) x y))
(defn unchecked-inc
  "Returns x + 1, wrapped to 64 bits when x is an integer in the long
  range; otherwise as inc."
  [x] (wrap64 (inc x) x 0))
(defn unchecked-dec
  "Returns x - 1, wrapped to 64 bits when x is an integer in the long
  range; otherwise as dec."
  [x] (wrap64 (dec x) x 0))
(defn unchecked-negate
  "Returns -x, wrapped to 64 bits when x is an integer in the long
  range; otherwise as -."
  [x] (wrap64 (- x) x 0))

(defn num
  "Returns x, a number or nil; there are no boxed kinds to convert.
  Anything else is :kind-mismatch."
  [x] (if (or (nil? x) (number? x)) x (nexis.internal/#%raise :kind-mismatch "num takes a number or nil, got" x)))
; No rationals (PLAN §23 #10): the rationals are the integers.
(defn ratio? "Returns false: there are no ratios." [_] false)
(defn rational?
  "Returns true if x is an integer: with no ratios, the rationals are
  the integers."
  [x] (integer? x))
; No decimals either (PLAN §4).
(defn decimal? "Returns false: there are no decimals." [_] false)
; One integer domain: a BigInt is an integer, so these truncate as long.
(defn bigint
  "Returns (long x): one integer kind holds integers of any size."
  [x] (long x))
(defn biginteger
  "Returns (long x): one integer kind holds integers of any size."
  [x] (long x))
; Java's bit operations not among the natives.
(defn bit-and-not
  "Returns x with the bits of y, and of each of more, cleared."
  [x y & more] (reduce (fn [a b] (bit-and a (bit-not b))) x (cons y more)))
(defn bit-flip "Returns x with bit n flipped." [x n] (if (bit-test x n) (bit-clear x n) (bit-set x n)))
; A map small enough to keep its insertion order prints in it
; (docs/CHAMP.md §2), which is what array-map promises.
(defn array-map
  "Returns (apply hash-map kvs). A map of up to eight entries keeps its
  insertion order, all an array map promises."
  [& kvs] (apply hash-map kvs))
(defn parse-boolean
  "Returns true for \"true\", false for \"false\", nil for any other
  string. A non-string is :kind-mismatch."
  [s]
  (cond (= s "true") true (= s "false") false (string? s) nil
        true (nexis.internal/#%raise :kind-mismatch "parse-boolean takes a string, got" s)))

(defn ex-cause
  "Returns the cause an ex-info value e carries, nil for anything else,
  a caught runtime error included."
  [e]
  (when (map? e) (:cause e)))

(defn printf
  "Prints (apply format fmt args). Returns nil."
  [fmt & args]
  (print (apply format fmt args)))

; ============================================================
; Transducers (docs/LAZY.md §10), Clojure 1.12's
; ============================================================
;
; The one-argument arities of map, filter, remove, keep, take,
; take-while, drop, drop-while, map-indexed, keep-indexed,
; partition-all, mapcat, and the no-argument ones of distinct and
; dedupe, are natives that call the xf- function of their name here.

(defn- xf-map [f]
  (fn* [rf]
    (fn ([] (rf))
         ([result] (rf result))
         ([result input] (rf result (f input)))
         ([result input & inputs] (rf result (apply f input inputs))))))

(defn- xf-filter [pred]
  (fn* [rf]
    (fn ([] (rf))
         ([result] (rf result))
         ([result input] (if (pred input) (rf result input) result)))))

(defn- xf-remove [pred] (xf-filter (complement pred)))

(defn- xf-keep [f]
  (fn* [rf]
    (fn ([] (rf))
         ([result] (rf result))
         ([result input] (let [v (f input)] (if (nil? v) result (rf result v)))))))

(defn- xf-take [n]
  (fn* [rf]
    (let [nv (volatile! n)]
      (fn ([] (rf))
           ([result] (rf result))
           ([result input]
            (let [n @nv
                  nn (vswap! nv dec)
                  result (if (pos? n) (rf result input) result)]
              (if (not (pos? nn)) (ensure-reduced result) result)))))))

(defn- xf-take-while [pred]
  (fn* [rf]
    (fn ([] (rf))
         ([result] (rf result))
         ([result input] (if (pred input) (rf result input) (reduced result))))))

(defn- xf-drop [n]
  (fn* [rf]
    (let [nv (volatile! n)]
      (fn ([] (rf))
           ([result] (rf result))
           ([result input]
            (let [n @nv]
              (vswap! nv dec)
              (if (pos? n) result (rf result input))))))))

(defn- xf-drop-while [pred]
  (fn* [rf]
    (let [dv (volatile! true)]
      (fn ([] (rf))
           ([result] (rf result))
           ([result input]
            (if (and @dv (pred input))
              result
              (do (vreset! dv nil) (rf result input))))))))

(defn- xf-map-indexed [f]
  (fn* [rf]
    (let [i (volatile! -1)]
      (fn ([] (rf))
           ([result] (rf result))
           ([result input] (rf result (f (vswap! i inc) input)))))))

(defn- xf-keep-indexed [f]
  (fn* [rf]
    (let [iv (volatile! -1)]
      (fn ([] (rf))
           ([result] (rf result))
           ([result input]
            (let [i (vswap! iv inc) v (f i input)]
              (if (nil? v) result (rf result v))))))))

(defn- xf-partition-all [n]
  (fn* [rf]
    (let [a (volatile! [])]
      (fn ([] (rf))
           ([result]
            (let [result (if (empty? @a)
                           result
                           (let [v @a] (vreset! a []) (unreduced (rf result v))))]
              (rf result)))
           ([result input]
            (let [v (vswap! a conj input)]
              (if (= n (count v))
                (do (vreset! a []) (rf result v))
                result)))))))

(defn- xf-partition-by [f]
  (fn* [rf]
    (let [a (volatile! []) pv (volatile! :nexis.core/none)]
      (fn ([] (rf))
           ([result]
            (let [result (if (empty? @a)
                           result
                           (let [v @a] (vreset! a []) (unreduced (rf result v))))]
              (rf result)))
           ([result input]
            (let [pval @pv val (f input)]
              (vreset! pv val)
              (if (or (identical? pval :nexis.core/none) (= val pval))
                (do (vswap! a conj input) result)
                (let [v @a]
                  (vreset! a [])
                  (let [ret (rf result v)]
                    (when-not (reduced? ret) (vswap! a conj input))
                    ret)))))))))

(defn- xf-distinct []
  (fn* [rf]
    (let [seen (volatile! #{})]
      (fn ([] (rf))
           ([result] (rf result))
           ([result input]
            (if (contains? @seen input)
              result
              (do (vswap! seen conj input) (rf result input))))))))

(defn- xf-dedupe []
  (fn* [rf]
    (let [pv (volatile! :nexis.core/none)]
      (fn ([] (rf))
           ([result] (rf result))
           ([result input]
            (let [prior @pv]
              (vreset! pv input)
              (if (= prior input) result (rf result input))))))))

(defn- xf-interpose [sep]
  (fn* [rf]
    (let [started (volatile! false)]
      (fn ([] (rf))
           ([result] (rf result))
           ([result input]
            (if @started
              (let [sepr (rf result sep)]
                (if (reduced? sepr) sepr (rf sepr input)))
              (do (vreset! started true) (rf result input))))))))

(defn- preserving-reduced [rf]
  (fn* [a b] (let [ret (rf a b)] (if (reduced? ret) (reduced ret) ret))))

(defn cat
  "A transducer that concatenates the contents of each input, a
  collection, into the reduction."
  [rf]
  (let [rrf (preserving-reduced rf)]
    (fn ([] (rf))
         ([result] (rf result))
         ([result input] (reduce rrf result input)))))

(defn- xf-mapcat [f] (comp (xf-map f) cat))

(defn completing
  "Returns a reducing function that calls f for its 0- and 2-argument
  arities and cf (identity by default) for its 1-argument completion."
  ([f] (completing f identity))
  ([f cf]
   (fn ([] (f))
        ([x] (cf x))
        ([x y] (f x y)))))

(defn transduce
  "Reduces coll with (xform f), starting from init ((f) when absent),
  then calls the completion arity of (xform f) on the result and
  returns it. f must have a 1-argument arity; see completing."
  ([xform f coll] (transduce xform f (f) coll))
  ([xform f init coll]
   (let [f (xform f)
         ret (reduce f init coll)]
     (f ret))))

; (into to xform from): the native into's arity with a transducer.
(defn- into-xform [to xform from]
  (if (contains? #{:vector :map :set} (class to))
    (with-meta (persistent! (transduce xform conj! (transient to) from)) (meta to))
    (transduce xform conj to from)))

(defn eduction
  "(eduction xform* coll). Returns the lazy seq of coll through the
  composed transducers, as sequence makes it: cached, where Clojure's
  eduction runs the transform again on each reduce."
  [& xforms]
  (sequence (apply comp (butlast xforms)) (last xforms)))

(defn halt-when
  "Returns a transducer that ends the reduction at the first input
  pred is truthy of, its result that input or, with retf,
  (retf completed-result input). Unaffected when pred never holds."
  ([pred] (halt-when pred nil))
  ([pred retf]
   (fn* [rf]
     (fn ([] (rf))
          ([result]
           (if (and (map? result) (contains? result :nexis.core/halt))
             (:nexis.core/halt result)
             (rf result)))
          ([result input]
           (if (pred input)
             (reduced {:nexis.core/halt (if retf (retf (rf result) input) input)})
             (rf result input)))))))

; ============================================================
; Types, namespaces, UUIDs (docs/STDLIB.md §8)
; ============================================================

(defn type
  "Returns the :type in x's metadata, else (class x)."
  [x] (or (get (meta x) :type) (class x)))

(defn instance?
  "Returns true if (class x) is t: a kind keyword such as :vector, or a
  record's symbol. There is no hierarchy of kinds. A t that is not a
  keyword or symbol is :kind-mismatch."
  [t x]
  (if (or (keyword? t) (symbol? t))
    (= t (class x))
    (nexis.internal/#%raise :kind-mismatch "instance? takes a kind keyword or a record symbol, got" t)))

(defn special-symbol?
  "Returns true if s names a special form of the compiler."
  [s]
  (contains? '#{def if do let* fn* loop* letfn* quote var recur try catch finally throw set! &} s))

; A namespace is its name symbol.
(defn the-ns
  "Returns x, a namespace's name symbol, when that namespace exists,
  else throws :no-such-namespace. A namespace is its name symbol."
  [x] (or (find-ns x) (nexis.internal/#%raise :no-such-namespace (str "no namespace named " x))))
(defn ns-name
  "Returns the name symbol of the namespace x names, which is x itself;
  :no-such-namespace when there is none."
  [x] (the-ns x))

(defn var-get
  "Returns the value of the Var v. A non-Var is :kind-mismatch."
  [v] (if (var? v) (deref v) (nexis.internal/#%raise :kind-mismatch "var-get takes a Var, got" v)))
(defn find-var
  "Returns the Var the qualified symbol sym names, nil when its
  namespace has none; :no-such-namespace when the namespace does not
  exist."
  [sym] (ns-resolve (the-ns (symbol (namespace sym))) sym))

; Each form is compiled as read, as a file's form is, and the namespace
; in force is restored afterwards, as Clojure's Compiler.load binds *ns*.
(defn load-string
  "Reads, compiles and runs each form of the string s in turn in the
  current namespace, and returns the last form's value (nil for none).
  A form that does not read raises :reader-error after the ones before
  it ran. The namespace in force is restored afterwards."
  [s]
  (let [ns *ns*]
    (try
      (loop [i 0 v nil]
        (if-let [[v j] (nexis.internal/#%load-next s i)]
          (recur j v)
          v))
      (finally (in-ns ns)))))
(defn load-file
  "Loads the file at path as load-string loads a string, and returns
  the last form's value."
  [path] (load-string (slurp path)))

(defn uuid?
  "Returns true if x is a string holding a UUID's canonical lowercase
  text, as random-uuid and parse-uuid make it: a UUID is that string."
  [x] (and (string? x) (= x (parse-uuid x))))

; ============================================================
; Delays, closing, taps
; ============================================================

; A delay is the record nexis.core/Delay, whose :state atom holds
; [:pending thunk], [:ready v] or [:failed e].
(defmacro delay
  "Returns a delay: body runs the first time the delay is forced (force
  or deref), and every later force returns its value, or rethrows what
  it threw; the body runs once either way."
  [& body]
  `(nexis.internal/#%delay (fn* [] ~@body)))

(defn force
  "Returns the value of x when it is a delay, forcing it; else x."
  [x]
  (if (delay? x)
    (let [state (:state x)
          s @state]
      (case (first s)
        :ready (second s)
        :failed (throw (second s))
        (try
          (let [v ((second s))]
            (reset! state [:ready v])
            v)
          (catch any e
            (reset! state [:failed e])
            (throw e)))))
    x))

; Java's Closeable.
(defprotocol Closeable
  "What with-open closes: a db connection, a Nextomic connection, and
  any record or kind extended to it."
  (close [this]
    "Closes this: db/close of a db connection, nextomic/release of a
  Nextomic connection."))
(extend-protocol Closeable
  :db_connection (close [c] (db/close c))
  :nextomic_conn (close [c] (nextomic/release c)))

; Clojure's Inst: what inst? and inst-ms take as an instant. nexis.time's
; Instant extends it (docs/STDLIB.md §12).
(defprotocol Inst
  (inst-ms* [inst]
    "Returns the epoch milliseconds of the instant inst."))
(alter-meta! #'Inst assoc :doc
  "An instant: a value with epoch milliseconds, which inst-ms* returns.
  nexis.time's Instant extends it, and so may any record.")

(defn inst?
  "Returns true if x is an instant: of a type extended to Inst, as
  nexis.time's Instant is."
  [x]
  (satisfies? Inst x))

(defn inst-ms
  "Returns the epoch milliseconds of the instant inst; anything else is
  :no-protocol-impl."
  [inst]
  (inst-ms* inst))

(defmacro with-open
  "bindings is [name init ...]. Evaluates body with each name bound,
  then calls close on each in reverse order on every exit, a throw
  included. Returns body's value."
  [bindings & body]
  (when (or (not (vector? bindings)) (odd? (count bindings)) (not (every? symbol? (take-nth 2 bindings))))
    (throw (ex-info "with-open takes a vector of symbol and value pairs" {})))
  (if (empty? bindings)
    `(do ~@body)
    `(let [~(first bindings) ~(second bindings)]
       (try
         (with-open ~(vec (drop 2 bindings)) ~@body)
         (finally (nexis.core/close ~(first bindings)))))))

(def ^:private taps (atom #{}))
(defn add-tap
  "Adds f, a function of one argument, to the taps tap> calls. Returns
  nil."
  [f] (swap! taps conj f) nil)
(defn remove-tap
  "Removes f from the taps tap> calls. Returns nil."
  [f] (swap! taps disj f) nil)
(defn tap>
  "Calls every function add-tap added with x, ignoring any that throws,
  and returns true. Unlike Clojure's, the taps run before tap> returns,
  on the one thread."
  [x]
  (doseq [f @taps]
    (try (f x) (catch any _ nil)))
  true)

; ============================================================
; Printing to a string
; ============================================================

(defn newline "Prints a newline. Returns nil." [] (print "\n"))
; Every print writes through at once (STDLIB.md §6): nothing to flush.
(defn flush
  "Returns nil: every print writes through at once, so there is
  nothing to flush."
  [] nil)
(defn print-str "Returns what (print xs...) would print, as a string." [& xs] (with-out-str (apply print xs)))
(defn println-str "Returns what (println xs...) would print, as a string." [& xs] (with-out-str (apply println xs)))
(defn prn-str "Returns what (prn xs...) would print, as a string." [& xs] (with-out-str (apply prn xs)))

; ============================================================
; Hierarchies and multimethods (docs/STDLIB.md §9)
; ============================================================

(defn make-hierarchy
  "Returns an empty hierarchy, the plain map {:parents {} :descendants
  {} :ancestors {}}: each tag's direct parents, and the closures of its
  ancestors and descendants, which derive and underive keep."
  [] {:parents {} :descendants {} :ancestors {}})

; The hierarchy the arities without one read, and derive and underive
; change through alter-var-root, as Clojure's.
(def ^:private global-hierarchy (make-hierarchy))

(defn isa?
  "Returns true if child is = to parent, has parent among its ancestors
  in hierarchy h (the global one by default), or both are vectors of
  one count whose elements are isa? pairwise. Only the edges derive
  made count: kinds have no supertypes."
  ([child parent] (isa? global-hierarchy child parent))
  ([h child parent]
   (or (= child parent)
       (contains? (get (:ancestors h) child) parent)
       (and (vector? parent) (vector? child) (= (count parent) (count child))
            (loop [i 0]
              (cond (= i (count parent)) true
                    (isa? h (child i) (parent i)) (recur (inc i))
                    :else false))))))

(defn parents
  "Returns the set of tag's direct parents in hierarchy h (the global
  one by default), nil when it has none."
  ([tag] (parents global-hierarchy tag))
  ([h tag] (not-empty (get (:parents h) tag))))

(defn ancestors
  "Returns the set of tag's ancestors in hierarchy h (the global one by
  default), nil when it has none."
  ([tag] (ancestors global-hierarchy tag))
  ([h tag] (not-empty (get (:ancestors h) tag))))

(defn descendants
  "Returns the set of tag's descendants in hierarchy h (the global one
  by default), nil when it has none."
  ([tag] (descendants global-hierarchy tag))
  ([h tag] (not-empty (get (:descendants h) tag))))

; Throws the :assertion-failed of Clojure's assert of the form `text`,
; for the assertions whose form names a Java class.
(defn- assert-failed [text]
  (throw {:error :assertion-failed :message (str "Assert failed: " text)}))

(defn derive
  "Returns hierarchy h with tag a child of parent (h itself when it is
  already); both are keywords or symbols. Without h, changes the
  global hierarchy and returns nil; parent then needs a namespace, and
  so does tag unless class? holds of it. A cycle is :invalid-derivation."
  ([tag parent]
   (assert (namespace parent))
   (when-not (or (class? tag) (and (ident? tag) (namespace tag)))
     (assert-failed "(or (class? tag) (and (instance? clojure.lang.Named tag) (namespace tag)))"))
   (alter-var-root #'global-hierarchy derive tag parent)
   nil)
  ([h tag parent]
   (assert (not= tag parent))
   (when-not (ident? tag) (assert-failed "(or (class? tag) (instance? clojure.lang.Named tag))"))
   (when-not (ident? parent) (assert-failed "(instance? clojure.lang.Named parent)"))
   (let [tp (:parents h)
         td (:descendants h)
         ta (:ancestors h)
         tf (fn [m source sources target targets]
              (reduce (fn [ret k]
                        (assoc ret k (reduce conj (get targets k #{}) (cons target (get targets target)))))
                      m (cons source (get sources source))))]
     (or
      (when-not (contains? (get tp tag) parent)
        (when (contains? (get ta tag) parent)
          (throw {:error :invalid-derivation :message (print-str tag "already has" parent "as ancestor")}))
        (when (contains? (get ta parent) tag)
          (throw {:error :invalid-derivation :message (print-str "Cyclic derivation:" parent "has" tag "as ancestor")}))
        {:parents (assoc tp tag (conj (get tp tag #{}) parent))
         :ancestors (tf ta tag td parent ta)
         :descendants (tf td parent ta tag td)})
      h))))

; The result is rebuilt by deriving every remaining edge into an empty
; hierarchy, as Clojure's.
(defn underive
  "Returns hierarchy h without the edge from tag to parent (h itself
  when there is none). Without h, changes the global hierarchy and
  returns nil."
  ([tag parent] (alter-var-root #'global-hierarchy underive tag parent) nil)
  ([h tag parent]
   (let [parent-map (:parents h)
         childs-parents (if (get parent-map tag) (disj (get parent-map tag) parent) #{})
         new-parents (if (not-empty childs-parents)
                       (assoc parent-map tag childs-parents)
                       (dissoc parent-map tag))
         deriv-seq (flatten (map #(cons (key %) (interpose (key %) (val %))) (seq new-parents)))]
     (if (contains? (get parent-map tag) parent)
       (reduce #(apply derive %1 %2) (make-hierarchy) (partition 2 deriv-seq))
       h))))

; Every multimethod made, by identity (a function's = and hash are its
; own), to its state: {:state s :cache c}, where the atom s holds
; {:name :default :href :table :prefers} and the atom c the pair
; [hierarchy method-cache] the cache was built against. Nothing
; unregisters, as with record types and protocols. The stdlib itself
; defines no multimethod: past eight, the keys' pointer hashes would
; order the image's copy of this map differently and fail its
; verification (STDLIB.md §9.4).
(def ^:private multifns (atom {}))

(defn multifn?
  "Returns true if x is a multimethod."
  [x] (contains? @multifns x))

(defn- multifn-entry [mf]
  (or (get @multifns mf) (nexis.internal/#%raise :kind-mismatch "expected a multimethod, got" mf)))

; MultiFn.resetCache: the cache is the method table, so an exact key
; is found before any isa? search.
(defn- mm-reset! [state cache]
  (let [s @state] (reset! cache [@(:href s) (:table s)])))

; Whether x is preferred to y in the prefer table pt, directly or
; through the parents of either in h (MultiFn.prefers).
(defn- mm-prefers? [h pt x y]
  (or (contains? (get pt x) y)
      (boolean (some #(mm-prefers? h pt x %) (parents h y)))
      (boolean (some #(mm-prefers? h pt % y) (parents h x)))))

(defn- mm-dominates? [h pt x y] (or (mm-prefers? h pt x y) (isa? h x y)))

; MultiFn.findAndCacheBestMethod: the entry whose key dv isa? and that
; dominates every other such entry, else the default's method, else
; nil. The result is cached when nothing it read changed meanwhile.
(defn- mm-find [state cache dv]
  (let [s @state
        ch (nth @cache 0)
        pt (:prefers s)
        best (reduce-kv
              (fn [best k m]
                (if (isa? ch dv k)
                  (let [best (if (or (nil? best) (mm-dominates? ch pt k (nth best 0))) [k m] best)]
                    (when-not (mm-dominates? ch pt (nth best 0) k)
                      (throw {:error :ambiguous-method :value dv
                              :message (format "Multiple methods in multimethod '%s' match dispatch value: %s -> %s and %s, and neither is preferred"
                                               (:name s) dv k (nth best 0))}))
                    best)
                  best))
              nil (:table s))
        method (if best (nth best 1) (get (:table s) (:default s)))]
    (when method
      (if (and (identical? s @state) (identical? ch (nth @cache 0)) (identical? ch @(:href s)))
        (do (swap! cache (fn [[h c]] [h (assoc c dv method)]))
            method)
        (do (mm-reset! state cache)
            (recur state cache dv))))))

; MultiFn.getMethod: the cached method for dv, the cache first reset
; when the hierarchy is no longer the one it was built against.
(defn- mm-method [state cache dv]
  (when-not (identical? (nth @cache 0) @(:href @state)) (mm-reset! state cache))
  (or (get (nth @cache 1) dv) (mm-find state cache dv)))

(defn- mm-fn [state cache dv]
  (or (mm-method state cache dv)
      (throw {:error :no-method :value dv
              :message (format "No method in multimethod '%s' for dispatch value: %s" (:name @state) dv)})))

; One arity of a multimethod: the dispatch value of the arguments,
; its method from the cache when the hierarchy is still the one the
; cache was built against (#%mm-lookup), else from mm-fn, applied to
; the arguments.
(defmacro ^:private mm-call [dispatch-fn state cache href args more]
  (let [f (gensym "method")]
    `(let [dv# ~(if more `(apply ~dispatch-fn ~@args ~more) `(~dispatch-fn ~@args))
           ~f (or (nexis.internal/#%mm-lookup ~cache ~href dv#) (mm-fn ~state ~cache dv#))]
       ~(if more `(apply ~f ~@args ~more) `(~f ~@args)))))

(defn make-multifn
  "Returns a multimethod named by the string mname, with no methods,
  dispatching on dispatch-fn, default the fallback dispatch value and
  href the Var or atom its hierarchy is read through. What defmulti
  expands to, nexis's name for Clojure's new MultiFn."
  [mname dispatch-fn default href]
  (when-not (or (var? href) (atom? href))
    (nexis.internal/#%raise :kind-mismatch "make-multifn reads its hierarchy through a Var or an atom, got" href))
  (let [state (atom {:name mname :default default :href href :table {} :prefers {}})
        cache (atom [@href {}])
        mf (fn
             ([] (mm-call dispatch-fn state cache href [] nil))
             ([a] (mm-call dispatch-fn state cache href [a] nil))
             ([a b] (mm-call dispatch-fn state cache href [a b] nil))
             ([a b c] (mm-call dispatch-fn state cache href [a b c] nil))
             ([a b c d] (mm-call dispatch-fn state cache href [a b c d] nil))
             ([a b c d & more] (mm-call dispatch-fn state cache href [a b c d] more)))]
    (swap! multifns assoc mf {:state state :cache cache})
    mf))

; Applies f to mf's state, resets its cache, and returns mf.
(defn- mm-update! [mf f & args]
  (let [{:keys [state cache]} (multifn-entry mf)]
    (apply swap! state f args)
    (mm-reset! state cache)
    mf))

(defn add-method
  "Sets method as the multimethod mf's method for dispatch-val. Returns
  mf."
  [mf dispatch-val method] (mm-update! mf assoc-in [:table dispatch-val] method))
(defn remove-method
  "Removes the multimethod mf's method for dispatch-val. Returns mf."
  [mf dispatch-val] (mm-update! mf update :table dissoc dispatch-val))
(defn remove-all-methods
  "Empties the multimethod mf's method table and prefer table. Returns
  mf."
  [mf] (mm-update! mf assoc :table {} :prefers {}))

(defn prefer-method
  "Makes the multimethod mf prefer dispatch value x to y where both
  match. Returns mf; :preference-conflict when y is already preferred
  to x."
  [mf x y]
  (let [s @(:state (multifn-entry mf))]
    (when (mm-prefers? @(:href s) (:prefers s) y x)
      (throw {:error :preference-conflict
              :message (format "Preference conflict in multimethod '%s': %s is already preferred to %s" (:name s) y x)}))
    (mm-update! mf update-in [:prefers x] (fnil conj #{}) y)))

(defn methods
  "Returns the multimethod mf's method table, a map of dispatch value
  to method."
  [mf] (:table @(:state (multifn-entry mf))))
(defn prefers
  "Returns the multimethod mf's prefer table, {x #{y ...}}."
  [mf] (:prefers @(:state (multifn-entry mf))))
(defn get-method
  "Returns the method a call of the multimethod mf with dispatch-val
  would run, nil when none would."
  [mf dispatch-val]
  (let [{:keys [state cache]} (multifn-entry mf)] (mm-method state cache dispatch-val)))

(defmacro defmulti
  "(defmulti name docstring? attr-map? dispatch-fn & options)
  Defines name as a multimethod unless it holds one already; returns
  the Var the first time, nil after. Options: :default, the fallback
  dispatch value (:default), and :hierarchy, a Var or atom."
  [mm-name & options]
  (let [docstring (when (string? (first options)) (first options))
        options (if docstring (next options) options)
        m (if (map? (first options)) (first options) {})
        options (if (map? (first options)) (next options) options)
        dispatch-fn (first options)
        options (next options)
        m (if docstring (assoc m :doc docstring) m)]
    (when (= (count options) 1)
      (throw (ex-info "The syntax for defmulti has changed. Example: (defmulti name dispatch-fn :default dispatch-value)" {})))
    (let [opts (apply hash-map options)
          v (gensym "v")]
      (when (seq (remove #{:default :hierarchy} (keys opts)))
        (throw (ex-info "Only these options are valid: :default, :hierarchy" {})))
      `(let [~v (def ~mm-name)
             r# (when-not (and (bound? ~v) (multifn? (deref ~v)))
                  (def ~mm-name (make-multifn ~(name mm-name) ~dispatch-fn ~(get opts :default :default)
                                              ~(get opts :hierarchy `(var global-hierarchy)))))]
         ~@(when (seq m) [`(alter-meta! ~v merge ~m)])
         r#))))

(defmacro defmethod
  "Sets (fn fn-tail...) as the multimethod mf's method for
  dispatch-val, so a named or multi-arity method works. Returns mf."
  [mf dispatch-val & fn-tail]
  `(add-method ~mf ~dispatch-val (fn ~@fn-tail)))

; ============================================================
; The command line
; ============================================================

(def *command-line-args*
  "The arguments after the program on the command line (nexis run FILE
  or nexis -e EXPR), as a vector of strings; nil when there are none."
  nil)

; ============================================================
; Documentation (STDLIB.md §10)
; ============================================================

; The doc map of a special form or host macro, from the runtime's
; table; `&`, `catch` and `finally` are documented with fn and try.
(defn- special-doc [sym]
  (let [sym (get '{& fn catch try finally try} sym sym)
        sym (if (= (namespace sym) "nexis.core") (symbol (name sym)) sym)]
    (some (fn [m] (when (= (:name m) sym) m)) (nexis.internal/#%special-docs))))

(defn- namespace-doc [ns-sym]
  (when-let [d (nexis.internal/#%namespace-doc ns-sym)]
    {:name ns-sym :doc d}))

; What `doc` prints of a doc map, in Clojure's layout.
(defn- print-doc [m]
  (println "-------------------------")
  (println (str (when-let [n (:ns m)] (str n "/")) (:name m)))
  (doseq [f (:forms m)] (print "  ") (prn f))
  (when-let [a (:arglists m)] (prn a))
  (cond (:special-form m) (println "Special Form")
        (:macro m) (println "Macro"))
  (when-let [d (:doc m)] (println " " d)))

; The doc map of what sym names: a special form or host macro, a
; library namespace, else the Var it resolves to; nil for none.
(defn- doc-of [sym]
  (or (special-doc sym)
      (when (find-ns sym) (or (namespace-doc sym) {:name sym}))
      (when-let [v (resolve sym)] (or (meta v) {:name sym}))))

(defmacro doc
  "Prints the documentation of the Var, special form, macro or namespace
  that name names: its qualified name, its arglists, whether it is a
  macro or special form, and its docstring. Prints nothing when name
  names nothing. nil."
  [name]
  `(when-let [m# (#'nexis.core/doc-of '~name)] (#'nexis.core/print-doc m#)))

(defn find-doc
  "Prints the documentation of every Var, special form, macro and
  namespace whose docstring or name has a match for re-string-or-pattern,
  a string or a regex. nil."
  [re-string-or-pattern]
  (let [re (re-pattern re-string-or-pattern)
        ms (concat (mapcat (fn [ns] (sort-by :name (keep meta (vals (ns-interns ns))))) (all-ns))
                   (keep namespace-doc (all-ns))
                   (nexis.internal/#%special-docs))]
    (doseq [m ms
            :when (and (:doc m) (or (re-find re (:doc m)) (re-find re (str (:name m)))))]
      (print-doc m))))

(defn apropos
  "Given a regex or a string, a sorted seq of the qualified symbols of
  every public Var, and of every host macro, whose name has a match for
  the regex or contains the string. nexis.internal is left out."
  [str-or-pattern]
  (let [match? (if (= :regex (class str-or-pattern))
                 (fn [s] (re-find str-or-pattern s))
                 (fn [s] (nexis.string/includes? s (str str-or-pattern))))]
    (sort (concat (mapcat (fn [ns]
                            (when-not (= ns 'nexis.internal)
                              (keep (fn [s] (when (match? (str s)) (symbol (str ns) (str s))))
                                    (keys (ns-publics ns)))))
                          (all-ns))
                  (keep (fn [m] (when (and (:macro m) (match? (str (:name m))))
                                  (symbol "nexis.core" (str (:name m)))))
                        (nexis.internal/#%special-docs))))))

(defn dir-fn
  "A sorted seq of the symbols naming the public Vars of the namespace
  ns names, or that an alias in the current namespace names; for
  nexis.core, its host macros (defn, let, cond, ...) as well.
  :no-such-namespace when it names none."
  [ns]
  (let [n (or (nexis.internal/#%the-ns-name ns) (the-ns ns))]
    (sort (concat (keys (ns-publics n))
                  (when (= n 'nexis.core)
                    (keep (fn [m] (when (:macro m) (:name m))) (nexis.internal/#%special-docs)))))))

(defmacro dir
  "Prints a sorted directory of the public Vars of the namespace, or
  namespace alias, nsname names, one per line. nil."
  [nsname]
  `(doseq [v# (dir-fn '~nsname)] (println v#)))
