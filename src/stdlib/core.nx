; src/stdlib/core.nx
;
; Phase 3.3d composite stdlib written in nexis itself,
; embedded via @embedFile and bootstrapped at VM startup
; AFTER native fns are installed.
;
; This is the "stage 2" layer per CLOJURE-REVIEW.md §1.1 —
; user-facing macros + fns built atop the primitive substrate.
; Each def/defn/defmacro here lands in the user's namespace and
; is callable from REPL + source files.
;
; Constraints:
;   - Only uses primitives installed by stdlib.installCore
;     (sequence/HOF/arithmetic/collection groups from 3.3a/b/c).
;   - No multi-arity defn yet (Phase 3.5).
;   - No destructuring yet (Phase 3.5).
;   - Single-argument macros only for v1 simplicity.

; ============================================================
; Simple predicates + accessors
; ============================================================

(defn true?  [x] (= x true))
(defn false? [x] (= x false))

; second / nthrest / last — basic seq access.
(defn second [s] (first (rest s)))
(defn third  [s] (first (rest (rest s))))

(defn last [s]
  ; Walk by reducing; the reduce fn keeps only the latest x.
  (reduce (fn* [_ x] x) nil s))

; ============================================================
; Sequence transforms
; ============================================================

(defn reverse [s]
  ; reduce + cons builds the list in reverse order naturally.
  (reduce (fn* [acc x] (cons x acc)) (list) s))

(defn range [n]
  ; (range 5) => (0 1 2 3 4). Builds a cons list back-to-front.
  (loop* [i n acc (list)]
    (if (< 0 i)
      (recur (dec i) (cons (dec i) acc))
      acc)))

(defn take [n s]
  ; Return up to n elements of s as a list.
  (loop* [i 0 rem s acc (list)]
    (if (< i n)
      (if (empty? rem)
        (reverse acc)
        (recur (inc i) (rest rem) (cons (first rem) acc)))
      (reverse acc))))

(defn drop [n s]
  ; Return s after dropping up to n elements.
  (loop* [i 0 rem s]
    (if (< i n)
      (if (empty? rem)
        rem
        (recur (inc i) (rest rem)))
      rem)))

; ============================================================
; Conditional macros
; ============================================================

; (when-let [name val-expr] body...)
;   evaluates val-expr; if truthy, binds it to name and runs
;   body, returning its last value. Else nil.
(defmacro when-let [binding & body]
  `(let* [bound# ~(first (rest binding))]
     (if bound#
       (let* [~(first binding) bound#]
         (do ~@body))
       nil)))

; (if-let [name val-expr] then else)
;   like when-let but with explicit else branch.
(defmacro if-let [binding then else]
  `(let* [bound# ~(first (rest binding))]
     (if bound#
       (let* [~(first binding) bound#] ~then)
       ~else)))

; (dotimes [name n-expr] body...)
;   runs body n times with name bound to 0..n-1.
;   Returns nil.
(defmacro dotimes [binding & body]
  `(let* [limit# ~(first (rest binding))]
     (loop* [~(first binding) 0]
       (if (< ~(first binding) limit#)
         (do ~@body
             (recur (inc ~(first binding))))
         nil))))

; ============================================================
; Phase 4.0b — durable transaction macros
; ============================================================
;
; `(with-tx [tx conn] body...)` opens a write transaction,
; runs body, commits on normal exit, aborts on exception
; (rethrows the exception). Returns body's result.
;
; `(with-read-tx [tx conn] body...)` opens a read snapshot,
; runs body, aborts on exit (reads never commit). Returns
; body's result.

(defmacro with-tx [binding & body]
  `(let* [~(first binding) (db/begin-write ~(first (rest binding)))]
     (try
       (let* [r# (do ~@body)]
         (db/commit! ~(first binding))
         r#)
       (catch any e#
         (db/abort-write! ~(first binding))
         (throw e#)))))

(defmacro with-read-tx [binding & body]
  `(let* [~(first binding) (db/begin-read ~(first (rest binding)))]
     (try
       (let* [r# (do ~@body)]
         (db/abort-read! ~(first binding))
         r#)
       (catch any e#
         (db/abort-read! ~(first binding))
         (throw e#)))))

; Phase 4.0f — snapshot vocabulary (PLAN.md §15.7).
;
; A snapshot is an emdb read transaction pinned to the commit
; generation that was current when it began. As long as the
; snapshot is alive, all reads through it see EXACTLY that
; state regardless of subsequent writes.
;
; `(with-snapshot [snap conn] body...)` opens a snapshot,
; runs body, releases on exit. Identical semantics to
; `with-read-tx`; different name matches the user-facing
; "I'm pinning to a point in time" mental model.
;
; To pin a snapshot past block scope: call `(db/snapshot conn)`
; directly and `(db/release-snapshot! snap)` when done. The
; snapshot is an ordinary Value — pass it to functions, store
; it, compare it for identity.
;
; Caveat (per PLAN.md §15.7): long-held snapshots prevent emdb
; from reclaiming pages they reference. Don't pin snapshots
; you don't intend to release.

(defmacro with-snapshot [binding & body]
  `(let* [~(first binding) (db/snapshot ~(first (rest binding)))]
     (try
       (let* [r# (do ~@body)]
         (db/release-snapshot! ~(first binding))
         r#)
       (catch any e#
         (db/release-snapshot! ~(first binding))
         (throw e#)))))

; ============================================================
; Phase 5 Item 5 — stdlib breadth (peer-AI turn 74 §10.5)
; ============================================================
;
; All user-land. Each defn builds on existing primitives —
; reduce + loop* + cons + assoc + apply. No new runtime
; surface. These are the Clojure-canonical helpers that
; real programs reach for first.
;
; Where Clojure ships short-circuiting via `reduced`, we use
; `loop*` instead — nexis v1 doesn't have `reduced` yet, so
; `every?` / `some` / etc. iterate with explicit termination.

; ---- function composition helpers ----

; (constantly x) → fn taking any args, always returns x.
(defn constantly [x]
  (fn* [& _] x))

; (complement f) → fn returning the logical-not of f.
(defn complement [f]
  (fn* [& args] (not (apply f args))))

; (partial f & args) → fn taking more args, prepending the
; closed-over `args`. Single-arity captures matching Clojure
; behavior; for multi-arity callees the caller supplies the
; rest.
(defn partial [f & bound]
  (fn* [& more] (apply f (apply list (concat-lists bound more)))))

; tiny helper for partial (private; not exported by intent).
(defn concat-lists [a b]
  ; (a) is a list; (b) is a list. Walk a back-to-front via
  ; reverse so we can cons each item onto b.
  (reduce (fn* [acc x] (cons x acc)) b (reverse a)))

; (comp & fns) → fn that applies the rightmost fn to args,
; then walks left passing single results. (comp) → identity.
; (comp f) → f. Matches Clojure's right-to-left composition.
(defn comp [& fns]
  (if (empty? fns)
    identity
    (let* [reversed (reverse fns)
           first-fn (first reversed)
           rest-fns (rest reversed)]
      (fn* [& args]
        (reduce (fn* [acc f] (f acc))
                (apply first-fn args)
                rest-fns)))))

; ---- short-circuiting predicates over sequences ----

; (every? pred coll) → true iff pred is truthy for every elt.
; Empty coll → true (vacuous). Stops on first falsy result.
(defn every? [pred coll]
  (loop* [s coll]
    (if (empty? s)
      true
      (if (pred (first s))
        (recur (rest s))
        false))))

; (not-every? pred coll) → true iff pred is falsy for at
; least one elt. (Inverse of every?.)
(defn not-every? [pred coll]
  (not (every? pred coll)))

; (some pred coll) → first truthy (pred x) result, or nil.
(defn some [pred coll]
  (loop* [s coll]
    (if (empty? s)
      nil
      (let* [r (pred (first s))]
        (if r r (recur (rest s)))))))

; (not-any? pred coll) → true iff pred is falsy for all elts.
(defn not-any? [pred coll]
  (if (some pred coll) false true))

; ---- collection extras ----

; (merge & maps) → left-to-right map merge. Later keys win.
; (merge) → nil. (merge m) → m. Nil maps treated as empty.
(defn merge [& maps]
  (reduce (fn* [acc m]
            (if (nil? m)
              acc
              (reduce (fn* [a k] (assoc a k (get m k)))
                      acc
                      (keys m))))
          nil
          maps))

; (update m k f & args) → assoc m with k → (apply f (get m k) args).
(defn update [m k f & args]
  (assoc m k (apply f (cons (get m k) args))))

; (get-in m [k1 k2 ...]) → nested lookup. nil if any step
; misses. (get-in m ks default) → default on miss.
(defn get-in [m ks]
  (reduce (fn* [acc k] (if (nil? acc) nil (get acc k)))
          m
          ks))

; (assoc-in m [k1 k2 ...] v) → m with the nested path set to v.
(defn assoc-in [m ks v]
  (if (empty? (rest ks))
    (assoc m (first ks) v)
    (assoc m
           (first ks)
           (assoc-in (get m (first ks)) (rest ks) v))))

; (update-in m [k1 k2 ...] f & args) → assoc-in over the
; result of applying f to the current value.
(defn update-in [m ks f & args]
  (assoc-in m ks (apply f (cons (get-in m ks) args))))

; ---- sequence breakdown helpers ----

; (frequencies coll) → map counting occurrences of each elt.
(defn frequencies [coll]
  (reduce (fn* [acc x] (assoc acc x (inc (get acc x 0))))
          {}
          coll))

; (group-by f coll) → map from (f x) to vector of matching xs.
; Order within each bucket is left-to-right.
(defn group-by [f coll]
  (reduce (fn* [acc x]
            (let* [k (f x)
                   bucket (get acc k [])]
              (assoc acc k (conj bucket x))))
          {}
          coll))

; (interpose sep coll) → coll with sep between each pair of
; adjacent elements. Returns a list.
(defn interpose [sep coll]
  (if (empty? coll)
    (list)
    (loop* [s (rest coll) acc (list (first coll))]
      (if (empty? s)
        (reverse acc)
        (recur (rest s) (cons (first s) (cons sep acc)))))))
