; src/stdlib/set.nx — the `nexis.set` namespace: set algebra over
; persistent sets, Clojure's clojure.set (which names this namespace).
; Embedded via @embedFile and bootstrapped with nexis.set current.

; coll with the element `k` maximizes first (the last of equals).
(defn- bubble-max-key [k coll]
  (let [m (apply max-key k coll)]
    (cons m (remove (fn [x] (identical? m x)) coll))))

; (union & sets) → every element of any of the sets, poured into the
; largest, so its kind and metadata stay.
(defn union
  ([] #{})
  ([s1] s1)
  ([s1 s2]
   (if (< (count s1) (count s2)) (into s2 s1) (into s1 s2)))
  ([s1 s2 & sets]
   (let [bubbled (bubble-max-key count (conj sets s2 s1))]
     (reduce into (first bubbled) (rest bubbled)))))

; (intersection s & sets) → the elements of s in every other set,
; removed from the smallest.
(defn intersection
  ([s1] s1)
  ([s1 s2]
   (if (< (count s2) (count s1))
     (recur s2 s1)
     (reduce (fn [result item] (if (contains? s2 item) result (disj result item)))
             s1 s1)))
  ([s1 s2 & sets]
   (let [bubbled (bubble-max-key (fn [s] (- (count s))) (conj sets s2 s1))]
     (reduce intersection (first bubbled) (rest bubbled)))))

; (difference s & sets) → the elements of s in none of the others.
(defn difference [s & sets]
  (reduce (fn [acc t] (reduce disj acc t)) s sets))

; (subset? a b) → whether every element of a is in b;
; (superset? a b) → whether every element of b is in a.
(defn subset? [a b]
  (and (<= (count a) (count b)) (every? (fn [x] (contains? b x)) a)))

(defn superset? [a b]
  (subset? b a))

; (select pred s) → s without the elements for which pred is falsy.
(defn select [pred s]
  (reduce (fn [acc k] (if (pred k) acc (disj acc k))) s s))

; (map-invert m) → m with its keys and values swapped.
(defn map-invert [m]
  (reduce-kv (fn [acc k v] (assoc acc v k)) {} m))

; (rename-keys m kmap) → m with each key of kmap renamed to its value.
(defn rename-keys [m kmap]
  (reduce-kv (fn [acc old new]
               (if (contains? m old)
                 (assoc acc new (get m old))
                 acc))
             (apply dissoc m (keys kmap))
             kmap))
