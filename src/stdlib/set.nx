; src/stdlib/set.nx — the `nexis.set` namespace: set algebra over
; persistent sets, Clojure's clojure.set (which names this namespace).
; Embedded via @embedFile and bootstrapped with nexis.set current.

; coll with the element `k` maximizes first (the last of equals).
(defn- bubble-max-key [k coll]
  (let [m (apply max-key k coll)]
    (cons m (remove (fn [x] (identical? m x)) coll))))

(defn union
  "Returns a set of every element of any of the sets, poured into the
  largest, which keeps its kind and metadata: a sorted set stays
  sorted. (union) is #{}; one argument is returned as it is."
  ([] #{})
  ([s1] s1)
  ([s1 s2]
   (if (< (count s1) (count s2)) (into s2 s1) (into s1 s2)))
  ([s1 s2 & sets]
   (let [bubbled (bubble-max-key count (conj sets s2 s1))]
     (reduce into (first bubbled) (rest bubbled)))))

(defn intersection
  "Returns the elements of s1 present in every other set, removed
  (disj) from the smallest, which keeps its kind. One argument is
  returned as it is."
  ([s1] s1)
  ([s1 s2]
   (if (< (count s2) (count s1))
     (recur s2 s1)
     (reduce (fn [result item] (if (contains? s2 item) result (disj result item)))
             s1 s1)))
  ([s1 s2 & sets]
   (let [bubbled (bubble-max-key (fn [s] (- (count s))) (conj sets s2 s1))]
     (reduce intersection (first bubbled) (rest bubbled)))))

(defn difference
  "Returns the set s1 without the elements of any of the other sets,
  walking the smaller of each pair. s1 must be a set, else
  :kind-mismatch."
  ([s1] s1)
  ([s1 s2]
   (if (< (count s1) (count s2))
     (reduce (fn [result item] (if (contains? s2 item) (disj result item) result)) s1 s1)
     (reduce disj s1 s2)))
  ([s1 s2 & sets] (reduce difference s1 (conj sets s2))))

(defn subset?
  "Returns true if every element of a is in b."
  [a b]
  (and (<= (count a) (count b)) (every? (fn [x] (contains? b x)) a)))

(defn superset?
  "Returns true if every element of b is in a."
  [a b]
  (subset? b a))

(defn select
  "Returns the set s without the elements for which pred is falsy,
  of s's kind."
  [pred s]
  (reduce (fn [acc k] (if (pred k) acc (disj acc k))) s s))

(defn map-invert
  "Returns m with its keys and values swapped; of keys sharing a
  value, the one iterated last wins."
  [m]
  (reduce-kv (fn [acc k v] (assoc acc v k)) {} m))

(defn rename-keys
  "Returns m with each key of kmap present in m renamed to the value
  kmap maps it to."
  [m kmap]
  (reduce-kv (fn [acc old new]
               (if (contains? m old)
                 (assoc acc new (get m old))
                 acc))
             (apply dissoc m (keys kmap))
             kmap))
