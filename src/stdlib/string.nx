; src/stdlib/string.nx — the part of the `nexis.string` namespace
; written in nexis over its natives (src/stdlib.zig string_natives).
; Embedded via @embedFile and bootstrapped with nexis.string as the
; current namespace.

(defn capitalize
  "Returns s with its first character upper-case and the rest
  lower-case. Only ASCII letters change case."
  [s]
  (if (< (count s) 2)
    (upper-case s)
    (str (upper-case (subs s 0 1)) (lower-case (subs s 1)))))

(defn reverse
  "Returns s with its code points in reverse order (not grapheme
  clusters)."
  [s]
  (apply str (nexis.core/reverse s)))

(defn split-lines
  "Returns a vector of the lines of s, split at \\n or \\r\\n, with
  trailing empty lines dropped."
  [s]
  (split (replace s "\r\n" "\n") "\n"))

(defn escape
  "Returns s with each character that cmap maps to a truthy value
  replaced by that value's text (str), the others kept:
  (escape \"a<b\" {\\< \"&lt;\"}) is \"a&lt;b\"."
  [s cmap]
  (apply str (map (fn [c] (if-let [r (cmap c)] r c)) s)))
