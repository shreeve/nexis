; src/stdlib/math.nx — the part of the `nexis.math` namespace
; (Clojure's clojure.math, docs/TOOLING.md §4) written in nexis: the
; constants and the integer divisions. The functions of doubles are
; natives in src/stdlib.zig `math_natives`; abs lives in nexis.core.
; Embedded via @embedFile and bootstrapped at VM startup with
; nexis.math as the current namespace.

(def PI 3.141592653589793)
(def E 2.718281828459045)

; (floor-div x y), (floor-mod x y) → Java's Math/floorDiv and
; Math/floorMod of x and y as longs (a float truncated, as Clojure
; casts it): the quotient rounded toward negative infinity, and the
; remainder with y's sign. A zero y is :divide-by-zero.
(defn floor-mod [x y] (mod (long x) (long y)))

(defn floor-div [x y]
  (let [x (long x) y (long y)]
    (quot (- x (mod x y)) y)))
