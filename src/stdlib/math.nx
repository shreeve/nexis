; src/stdlib/math.nx — the part of the `nexis.math` namespace
; (Clojure's clojure.math, docs/TOOLING.md §4) written in nexis: the
; constants and the integer divisions. The functions of doubles are
; natives in src/stdlib.zig `math_natives`; abs lives in nexis.core.
; Embedded via @embedFile and bootstrapped at VM startup with
; nexis.math as the current namespace.

(def PI "The double closest to pi." 3.141592653589793)
(def E "The double closest to e, the base of natural logarithms." 2.718281828459045)

(defn floor-mod
  "Returns the remainder of x by y with y's sign, as Java's
  Math/floorMod; a float is truncated first. A zero y is
  :divide-by-zero."
  [x y] (mod (long x) (long y)))

(defn floor-div
  "Returns the quotient of x by y rounded toward negative infinity, as
  Java's Math/floorDiv; a float is truncated first, and a quotient
  past the long range is a bignum. A zero y is :divide-by-zero."
  [x y]
  (let [x (long x) y (long y)]
    (quot (- x (mod x y)) y)))
