; src/stdlib/walk.nx — the `nexis.walk` namespace, Clojure's
; clojure.walk (which names this namespace; docs/STDLIB.md §4).
; Embedded via @embedFile and bootstrapped with nexis.walk current,
; before test.nx, whose `are` substitutes through postwalk-replace.

(defn walk
  "Returns (outer form) of form rebuilt from (inner x) of each element
  x, in form's kind: a list stays a list and any other seq becomes a
  realized seq, with form's metadata; a record keeps its type; another
  collection is poured into (empty form), so a sorted one keeps its
  comparator. A map's elements are its [k v] entries. Anything else, a
  typed vector included, is a leaf: (outer form)."
  [inner outer form]
  (cond
    (list? form) (outer (with-meta (apply list (map inner form)) (meta form)))
    (seq? form) (outer (with-meta (doall (map inner form)) (meta form)))
    (record? form) (outer (reduce (fn [r x] (conj r (inner x))) form form))
    (coll? form) (outer (into (empty form) (map inner form)))
    :else (outer form)))

(defn postwalk
  "Returns form with f applied to every subform, children before their
  parent, each parent rebuilt from what f returned for its children."
  [f form]
  (walk (partial postwalk f) f form))

(defn prewalk
  "Returns form with f applied to every subform, a parent before its
  children, walking into what f returned."
  [f form]
  (walk (partial prewalk f) identity (f form)))

(defn keywordize-keys
  "Returns m with every string key of every map in it a keyword. A
  record or sorted map in m becomes a hash map."
  [m]
  (let [f (fn [[k v]] (if (string? k) [(keyword k) v] [k v]))]
    (postwalk (fn [x] (if (map? x) (into {} (map f x)) x)) m)))

(defn stringify-keys
  "Returns m with every keyword key of every map in it its name. A
  record or sorted map in m becomes a hash map."
  [m]
  (let [f (fn [[k v]] (if (keyword? k) [(name k) v] [k v]))]
    (postwalk (fn [x] (if (map? x) (into {} (map f x)) x)) m)))

(defn prewalk-replace
  "Returns form with every subform that is a key of smap replaced by
  its value, walking parents first (prewalk)."
  [smap form]
  (prewalk (fn [x] (if (contains? smap x) (smap x) x)) form))

(defn postwalk-replace
  "Returns form with every subform that is a key of smap replaced by
  its value, walking children first (postwalk)."
  [smap form]
  (postwalk (fn [x] (if (contains? smap x) (smap x) x)) form))

(defn macroexpand-all
  "Returns form with every macro call in it expanded, outermost first,
  each seq through macroexpand."
  [form]
  (prewalk (fn [x] (if (seq? x) (macroexpand x) x)) form))
