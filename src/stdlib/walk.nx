; src/stdlib/walk.nx — the `nexis.walk` namespace, Clojure's
; clojure.walk (which names this namespace; docs/STDLIB.md §4).
; Embedded via @embedFile and bootstrapped with nexis.walk current,
; before test.nx, whose `are` substitutes through postwalk-replace.

; (walk inner outer form) → outer of form with inner applied to each
; of its elements, rebuilt in form's kind: a list (seqs are lists)
; keeps its metadata, a record its type, any other collection is
; poured into (empty form), so a sorted one keeps its comparator and
; metadata stays. A map's elements are its [k v] entries. Anything
; else, a typed vector included, is a leaf: (outer form).
(defn walk [inner outer form]
  (cond
    (list? form) (outer (with-meta (apply list (map inner form)) (meta form)))
    (record? form) (outer (reduce (fn [r x] (conj r (inner x))) form form))
    (coll? form) (outer (into (empty form) (map inner form)))
    :else (outer form)))

; (postwalk f form) → f applied to every subform, children before
; their parent, each parent rebuilt from the children f returned.
(defn postwalk [f form]
  (walk (partial postwalk f) f form))

; (prewalk f form) → f applied to every subform, a parent before its
; children, walking into what f returned.
(defn prewalk [f form]
  (walk (partial prewalk f) identity (f form)))

; (keywordize-keys m) → every string key of every map in m a keyword.
(defn keywordize-keys [m]
  (let [f (fn [[k v]] (if (string? k) [(keyword k) v] [k v]))]
    (postwalk (fn [x] (if (map? x) (into {} (map f x)) x)) m)))

; (stringify-keys m) → every keyword key of every map in m its name.
(defn stringify-keys [m]
  (let [f (fn [[k v]] (if (keyword? k) [(name k) v] [k v]))]
    (postwalk (fn [x] (if (map? x) (into {} (map f x)) x)) m)))

; (prewalk-replace smap form), (postwalk-replace smap form) → form
; with every subform that is a key of smap replaced by its value.
(defn prewalk-replace [smap form]
  (prewalk (fn [x] (if (contains? smap x) (smap x) x)) form))

(defn postwalk-replace [smap form]
  (postwalk (fn [x] (if (contains? smap x) (smap x) x)) form))

; (macroexpand-all form) → form with every macro call in it expanded,
; outermost first, as the compiler would expand it.
(defn macroexpand-all [form]
  (prewalk (fn [x] (if (seq? x) (macroexpand x) x)) form))
