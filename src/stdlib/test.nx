; src/stdlib/test.nx — the `nexis.test` namespace (docs/TOOLING.md
; §3): deftest, is, are, testing, use-fixtures, run-tests and
; run-all-tests over atoms and throw. Embedded via @embedFile and
; bootstrapped at VM startup with nexis.test as the current
; namespace, after core.nx and walk.nx.
; The helpers the macros call (register!, check=, check-truthy,
; check-thrown, pass!, fail!) are public, since an expansion names
; them from the caller's namespace, and so is the state they keep
; (tests, counts, contexts, ...).

; ---- registry ----

(def tests
  "An atom of the test registry: namespace name to a vector of
  [test-name fn] in definition order. deftest adds to it."
  (atom {}))

(def ns-order
  "An atom of the vector of namespace names in the order they first
  registered a test; run-all-tests runs them in this order."
  (atom []))

(defn register!
  "Registers f as the test test-name of the namespace named ns-name,
  replacing in place a test of that name; returns nil. Used by the
  expansion of deftest."
  [ns-name test-name f]
  (let* [entries (get @tests ns-name [])
         present (some (fn* [e] (= (first e) test-name)) entries)]
    (when (nil? (get @tests ns-name))
      (swap! ns-order conj ns-name))
    (swap! tests assoc ns-name
           (if present
             (mapv (fn* [e] (if (= (first e) test-name) [test-name f] e)) entries)
             (conj entries [test-name f])))
    nil))

(defmacro deftest
  "Defines name as a function of no arguments running body and
  registers it as a test of the current namespace, replacing one of
  the same name. Returns the Var."
  [name & body]
  `(do (def ~name (fn* [] ~@body))
       (nexis.test/register! (nexis.internal/#%current-ns) '~name ~name)
       (var ~name)))

; ---- the state of one run ----

(def out
  "An atom of the function every report line is passed to, println
  unless replaced; reset it to collect the lines instead."
  (atom println))

(def counts
  "An atom of {:test n :pass n :fail n :error n} while a run is on,
  nil outside one, where an assertion reports but counts nothing."
  (atom nil))

(def current
  "An atom of {:ns name :name name} naming the running test, nil
  outside a run; report lines name it."
  (atom nil))

(def contexts
  "An atom of the vector of testing descriptions in force, outermost
  first; report lines name them."
  (atom []))

(defn- emit! [line] (@out line))
(defn- bump! [k] (when @counts (swap! counts update k inc)))

; " in ns/test (outer > inner)", without the parts not in force.
(defn- where []
  (let* [c @current
         ctxs @contexts]
    (str (if c (str " in " (:ns c) "/" (:name c)) "")
         (if (empty? ctxs) "" (str " (" (apply str (interpose " > " ctxs)) ")")))))

; The three outcomes of an assertion or a test. `pass!` is true and
; `fail!` false so `is` yields what it asserted.
(defn pass!
  "Counts a passed assertion in a run; returns true. Used by the
  expansion of is."
  [] (bump! :pass) true)

(defn fail!
  "Counts a failed assertion and reports form, the expected and actual
  values and msg when given; returns false. Used by the expansion of
  is."
  [form expected actual msg]
  (bump! :fail)
  (emit! (str "FAIL" (where) ": " (pr-str form)
              " expected: " (pr-str expected)
              " actual: " (pr-str actual)
              (if msg (str " ; " msg) "")))
  false)

(defn- error! [e]
  (bump! :error)
  (emit! (str "ERROR" (where) ": " (pr-str e))))

; ---- assertions ----

; What an assertion calls: `is` expands to one call of these, so the
; judging and the reporting are here once, not in every assertion.
; Each returns whether the assertion passed; a pass is counted here
; rather than through `pass!`, one closure call fewer per assertion.
(defn check=
  "Judges (is (= expected actual) msg): counts a pass and returns true
  when expected equals actual, else reports form and both values and
  returns false. Used by the expansion of is."
  [form expected actual msg]
  (if (= expected actual) (do (bump! :pass) true) (fail! form expected actual msg)))

(defn check-truthy
  "Judges (is form msg) whose value is v: counts a pass and returns
  true when v is truthy, else reports form and v and returns false.
  Used by the expansion of is."
  [form v msg]
  (if v (do (bump! :pass) true) (fail! form true v msg)))

; A throw of the value the catch holds keeps its origin (VM.md §12).
(defn check-thrown
  "Judges the thrown value e of (is (thrown? tag expr)): counts a pass
  and returns true when (catch tag ...) would take e, else throws e
  on. Used by the expansion of is."
  [e tag]
  (if (nexis.internal/#%catch-matches? e tag) (do (bump! :pass) true) (throw e)))

(defmacro is
  "Asserts form and returns whether it passed. (is (= expected actual))
  reports both values on failure. (is (thrown? matcher expr)) passes
  when expr throws a value (catch matcher ...) would take, a keyword
  tag or any, and fails when it returns; another throw propagates.
  (is expr) passes when expr is truthy. msg is evaluated once, after
  the values."
  [form & more]
  (let* [msg (first more)
         head (if (seq? form) (name (first form)) nil)]
    (cond
      (and (= head "=") (= (count form) 3))
      `(nexis.test/check= '~form ~(second form) ~(nth form 2) ~msg)
      (= head "thrown?")
      (let* [m (second form)
             tag? (and (keyword? m) (not= m :default))]
        `(try
           (nexis.test/fail! '~form '~m ~(nth form 2 nil) ~msg)
           ~(if tag?
              `(catch any e# (nexis.test/check-thrown e# ~m))
              `(catch ~m e# (nexis.test/pass!)))))
      true
      `(nexis.test/check-truthy '~form ~form ~msg))))

(defmacro are
  "Asserts expr with is once per group of args, each group's values
  substituted for the names of argv: (are [x y] (= x y) 1 1 2 2) is
  (do (is (= 1 1)) (is (= 2 2))). A count of args that is not a
  multiple of argv's fails the expansion."
  [argv expr & args]
  (cond
    (empty? args) (if (empty? argv) nil (throw (ex-info "The number of args doesn't match are's argv." {})))
    (or (empty? argv) (not (zero? (mod (count args) (count argv)))))
    (throw (ex-info "The number of args doesn't match are's argv." {}))
    :else
    `(do ~@(map (fn [vals] `(is ~(nexis.walk/postwalk-replace (zipmap argv vals) expr)))
                (partition (count argv) args)))))

(defmacro testing
  "Evaluates body with desc added to the descriptions report lines
  name, removed on every exit; descriptions nest."
  [desc & body]
  `(do (swap! nexis.test/contexts conj ~desc)
       (try (do ~@body)
            (finally (swap! nexis.test/contexts pop)))))

; ---- fixtures ----

(def fixtures
  "An atom of namespace name to {:once f :each f}, each the
  composition of the fixtures use-fixtures gave for that kind."
  (atom {}))

(defn compose-fixtures
  "Returns the fixture that runs f2 inside f1."
  [f1 f2]
  (fn [g] (f1 (fn [] (f2 g)))))

(defn join-fixtures
  "Returns the fixture that runs every fixture of fs, the first
  outermost."
  [fs]
  (reduce compose-fixtures (fn [g] (g)) fs))

(defn use-fixtures
  "Sets the current namespace's fixtures of kind: :once ones wrap the
  run of its tests, :each ones each test, the first outermost. A
  fixture is a function of the function it wraps, which it calls. A
  later call replaces the kind's fixtures; another kind is
  :invalid-argument."
  [kind & fs]
  (when-not (contains? #{:once :each} kind) (throw :invalid-argument))
  (swap! fixtures assoc-in [(nexis.internal/#%current-ns) kind] (join-fixtures fs))
  nil)

; ---- running ----

(defn- run-test [ns-name entry]
  (reset! current {:ns ns-name :name (first entry)})
  (reset! contexts [])
  (bump! :test)
  (try ((second entry))
       (catch any e (error! e))))

; Run every registered test of the named namespaces in order and
; report; {:test n :pass n :fail n :error n} where :test counts the
; tests run, :pass and :fail the assertions, :error the tests that
; threw.
(defn- run-namespaces [ns-names]
  (reset! counts {:test 0 :pass 0 :fail 0 :error 0})
  (try
    (doseq [n ns-names]
      (let* [fx (get @fixtures n)
             each (get fx :each (fn [g] (g)))]
        ((get fx :once (fn [g] (g)))
         (fn [] (doseq [entry (get @tests n [])]
                  (each (fn [] (run-test n entry))))))))
    (let* [c @counts]
      (emit! (str "Ran " (:test c) " tests containing "
                  (+ (:pass c) (:fail c)) " assertions."))
      (emit! (str (:fail c) " failures, " (:error c) " errors."))
      c)
    (finally
      (reset! counts nil)
      (reset! current nil)
      (reset! contexts []))))

(defn run-tests
  "Runs the tests of the current namespace, or of the namespace ns
  names, in definition order, and reports. Returns {:test n :pass n
  :fail n :error n}: tests run, assertions passed and failed, and tests
  that threw."
  ([] (run-namespaces [(nexis.internal/#%current-ns)]))
  ([ns] (run-namespaces [(name ns)])))

(defn successful?
  "Returns true if the run summary has no failure and no error."
  [summary]
  (and (zero? (get summary :fail 0)) (zero? (get summary :error 0))))

(defn run-all-tests
  "Runs the tests of every namespace that registered one, in the order
  they first registered, and reports; returns the summary run-tests
  does."
  []
  (run-namespaces @ns-order))
