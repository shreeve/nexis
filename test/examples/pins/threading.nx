; test/examples/pins/threading.nx — the threading macros (-> and ->>).
; A pin, not a teaching example: -> threading through +.
;
;   (-> 1 (+ 2) (+ 3))  is  (+ (+ 1 2) 3)  =>  6
;   (-> x f)            is  (f x)
;   (-> x (f a))        is  (f x a)         ; thread-first
;
; Host macros: let/fn/->.

(println (let [start 0]
  (-> start
      (+ 1)
      (+ 10)
      (+ 100))))
