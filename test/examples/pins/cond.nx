; test/examples/pins/cond.nx — classification via cond + when.
; A pin, not a teaching example: cond over and, with an :else clause.
; Showcases the host macros cond, when, and, or, ->, plus the
; user-facing `let`/`fn`/`loop` names.

(defn classify [n]
  (cond
    (and (< 0 n) (< n 10))  :small
    (and (< 9 n) (< n 100)) :medium
    (< 99 n)                :large
    :else                   :non-positive))

(println (classify 42))
