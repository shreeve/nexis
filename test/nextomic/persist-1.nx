; test/nextomic/persist-1.nx — first process: install a schema and write
; three transactions. persist-2.nx reads them back in a new process.

(require '[nextomic :as d])
(require '[prelude :as t])

(d/with-conn [c "persist.edb"]
  (d/transact! c [{:db/ident :city/name :db/valueType :db.type/string :db/cardinality :db.cardinality/one
                   :db/unique :db.unique/identity}
                  {:db/ident :city/population :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
                  {:db/ident :city/mood :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}])
  (d/transact! c [{:city/name "Turin" :city/population 850000 :city/mood :calm}
                  {:city/name "Genoa" :city/population 560000}])
  (d/transact! c [[:db/add [:city/name "Turin"] :city/population 870000]])
  (println (d/basis-t (d/db c))))
(println :persist-1-done)
