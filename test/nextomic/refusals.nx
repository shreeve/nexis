; test/nextomic/refusals.nx — what a refused transaction names: the
; attribute at fault, and the form, reference or value as written
; (docs/NEXTOMIC.md §3, §7).

(require '[nextomic :as d])
(require '[prelude :as t])

(def c (d/connect "refusals.edb"))
(d/transact! c [{:db/ident :u/email :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
                {:db/ident :u/age :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
                {:db/ident :u/tags :db/valueType :db.type/string :db/cardinality :db.cardinality/many}
                {:db/ident :u/friend :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}])
(def x (get (:tempids (d/transact! c [{:db/id "x" :u/email "x" :u/age 1}])) "x"))

; Malformed tx-data names the attribute at fault, or what it refuses.
(prn (t/caught (d/transact! c [{:db/ident :x/z :db/unique :db.unique/identity}])))
(prn (t/caught (d/transact! c [{:db/ident :x/w :db/valueType :db.type/long :db/cardinality :db.cardinality/many :db/unique :db.unique/identity}])))
(prn (t/caught (d/transact! c [[:db/add [:u/age 1] :u/age 2]])))
(prn (t/caught (d/transact! c [[:db.fn/cas x :u/tags nil "a"]])))
(prn (t/caught (d/transact! c [{:db/id x :u/_age 5}])))
(prn (t/caught (d/transact! c [{:db/id "n" :u/age 1 :u/friend {:u/age 2}}])))
(prn (t/caught (d/transact! c [[:db/add nil :u/age 5]])))
(prn (t/caught (d/transact! c [[:db/add "only" :u/age 5] [:db/retract "lonely" :u/age 5]])))
(prn (t/caught (d/transact! c [[:db/frob x :u/age 5]])))
(prn (t/caught (d/transact! c [[:db/add x :u/friend [:u/email [:u/email "x"]]]])))
(prn (t/caught (d/transact! c [[:db/add x "u/age" 5]])))
(prn (t/caught (d/transact! c [:not-a-form])))
; A nested map is refused for what it is, never for a key it holds that
; resolves no attribute.
(prn (t/caught (d/transact! c [{:db/id "p" :u/friend {:u/_friend "q" :u/email "e"}} {:db/id "q" :u/age 3}
                               {:db/ident :x/y :db/valueType :db.cardinality/one :db/cardinality :db.cardinality/one}])))

; :db/valueType, :db/cardinality and :db/unique take their own
; enumeration's idents, naming the attribute and the keyword; a typo
; mints nothing.
(prn (t/caught (d/transact! c [{:db/ident :x/y :db/valueType :db.cardinality/one :db/cardinality :db.cardinality/one}])))
(prn (t/caught (d/transact! c [{:db/ident :x/y :db/valueType :db.type/long :db/cardinality :db.type/long}])))
(prn (t/caught (d/transact! c [{:db/ident :x/y :db/valueType :db.type/long :db/cardinality :db.cardinality/one :db/unique :db.cardinality/one}])))
(prn (t/caught (d/transact! c [{:db/ident :x/y :db/valueType :db.type/strin :db/cardinality :db.cardinality/one}])))
(t/check "a refused enum keyword is never minted" (nil? (d/entid (d/db c) :db.type/strin)))

; A schema attribute on an entity that is no attribute (a map without
; :db/ident, the transaction entity) installs nothing and is refused.
(prn (t/caught (d/transact! c [{:db/id "u" :db/unique :db.unique/identity :u/age 1}])))
(prn (t/caught (d/transact! c [{:db/id "v" :db/valueType :db.type/long :db/cardinality :db.cardinality/one}])))
(prn (t/caught (d/transact! c [{:db/id "w" :db/index true :u/age 3}])))
(prn (t/caught (d/transact! c [{:db/id "w" :db/isComponent true :u/age 3}])))
(prn (t/caught (d/transact! c [{:db/id "w" :db/fulltext true :u/age 3}])))
(prn (t/caught (d/transact! c [[:db/add "datomic.tx" :db/index true]])))
(t/check "no user entity carries a schema attribute" (= 13 (count (d/schema (d/db c)))))

; The bootstrap idents keep their names: renaming one is refused, and
; asserting its own name stays a no-op.
(prn (t/caught (d/transact! c [[:db/add :db/fulltext :db/ident :my/ft]])))
(prn (t/caught (d/transact! c [[:db/add :db.type/string :db/ident :my/text]])))
(prn (t/caught (d/transact! c [[:db/add :db/ident :db/ident :my/ident]])))
(t/check "asserting a bootstrap ident's own name is a no-op" (map? (d/transact! c [[:db/add :db/doc :db/ident :db/doc]])))
(t/check "the bootstrap idents keep their names" (= 22 (d/entid (d/db c) :db/fulltext)))
