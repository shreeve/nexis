; test/nextomic/indexes.nx — datoms on every index with every
; component shape: bound, nil gap, lookup ref, keyword and ref values.

(require '[nextomic :as d])
(require '[prelude :as t])

(def c (d/connect "indexes.edb"))
(d/transact! c [{:db/ident :item/sku :db/valueType :db.type/string :db/cardinality :db.cardinality/one
                 :db/unique :db.unique/value}
                {:db/ident :item/name :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
                {:db/ident :item/qty :db/valueType :db.type/long :db/cardinality :db.cardinality/one :db/index true}
                {:db/ident :item/color :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
                {:db/ident :item/part-of :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}])
(def r (d/transact! c [{:db/id "kit" :item/sku "K-1" :item/name "Kit" :item/qty 3}
                       {:db/id "bolt" :item/sku "B-1" :item/name "Bolt" :item/qty 500 :item/color :steel :item/part-of ["kit"]}
                       {:db/id "nut" :item/sku "N-1" :item/name "Nut" :item/qty 500 :item/color :brass :item/part-of ["kit"]}]))
(def kit (get (:tempids r) "kit"))
(def bolt (get (:tempids r) "bolt"))
(def nut (get (:tempids r) "nut"))
(def db (d/db c))

; EAVT: whole entity, one attribute, exact datom.
(println (d/datoms db :eavt bolt))
(println (d/datoms db :eavt bolt :item/qty))
(println (d/datoms db :eavt bolt :item/qty 500))
(t/check "exact datom with the wrong value is empty" (empty? (d/datoms db :eavt bolt :item/qty 501)))
(t/check "lookup ref as the entity component" (= 1 (count (d/datoms db :eavt [:item/sku "N-1"] :item/name))))
(t/check "a gap filters: every :item/name datom holding Bolt" (= 1 (count (d/datoms db :eavt nil :item/name "Bolt"))))

; AEVT: an attribute across entities, then narrowed by entity.
(println (mapv first (d/datoms db :aevt :item/name)))
(println (d/datoms db :aevt :item/name nut))
(t/check "aevt with a value after a gap" (= [nut] (mapv first (d/datoms db :aevt :item/name nil "Nut"))))

; AVET: indexed and unique attributes, by value; a gap then entity.
(println (mapv first (d/datoms db :avet :item/qty 500)))
(println (d/datoms db :avet :item/sku "B-1"))
(t/check "avet with entity after a gap" (= 1 (count (d/datoms db :avet :item/qty nil nut))))
(t/check "avet on an unindexed attribute reads nothing" (empty? (d/datoms db :avet :item/name)))
(t/check "a value nobody holds matches nothing" (empty? (d/datoms db :avet :item/qty 7)))

; VAET: who points at the kit.
(println (mapv first (d/datoms db :vaet kit)))
(println (d/datoms db :vaet kit :item/part-of bolt))
(t/check "vaet by lookup ref" (= 2 (count (d/datoms db :vaet [:item/sku "K-1"]))))
(t/check "vaet of an entity nobody references is empty" (empty? (d/datoms db :vaet bolt)))

; Keyword values are keywords on the way out and match on the way in.
(t/check "keyword value round trip" (= :brass (nth (first (d/datoms db :eavt nut :item/color)) 2)))
(t/check "keyword the store never saw matches nothing" (empty? (d/datoms db :eavt nut :item/color :gold)))
(t/check "unknown ident as entity matches nothing" (empty? (d/datoms db :eavt :item/nope)))

; The bootstrap schema is visible through the same indexes.
(println (d/datoms db :eavt :db/ident))
(t/check "datoms carry their transaction" (= 3 (nth (first (d/datoms db :eavt nut :item/name)) 3)))
(t/check "current datoms are assertions" (every? #(nth % 4) (d/datoms db :aevt :item/qty)))

(d/release c)
:indexes-done
