; test/nextomic/prelude.nx — shared by every script in this directory
; through `(require '[prelude :as t])`, which finds it beside the
; script.

(ns prelude)

; Entity-id partitions (docs/NEXTOMIC.md §2.1): user entities start at
; 2^32; a transaction entity is tx-partition + t.
(def user-partition 4294967296)
(def tx-partition 70368744177664)

; Print "ok <label>" or "FAIL <label>"; a failure ends the script.
(defn check [label ok]
  (println (if ok "ok" "FAIL") label)
  (when-not ok (throw :check-failed)))

; The value body throws, or :no-error; an error map without the
; place it was raised at (`:fn`, `:file`, `:line`, `:column`), which
; names this run's path to the script.
(defmacro caught [& body]
  `(try (do ~@body :no-error)
        (catch any e# (if (map? e#) (dissoc e# :fn :file :line :column) e#))))

; The keyword body throws: an error map's :error, or the thrown value.
(defmacro caught-tag [& body]
  `(let [e# (caught ~@body)] (if (map? e#) (:error e#) e#)))
