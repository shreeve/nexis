; test/nextomic/query.nx — q and explain: patterns, joins, every :in
; form, constants and lookup refs, predicates and functions (built-in,
; defn'd, core, qualified), aggregates, every find spec, not/or and
; their -join forms, rules, time views, errors. Runs from a scratch
; directory; the store is fresh.

(require '[nextomic :as d])
(require '[nexis.string :as s])

(defn check [label ok]
  (println (if ok "ok" "FAIL") label)
  (when-not ok (throw :check-failed)))

(defmacro caught [& body]
  `(try (do ~@body :no-error) (catch any e# e#)))

; Results are persistent sets; sorting makes the output stable.
(defn rows [res] (sort res))

(def c (d/connect "query.edb"))
(d/transact! c [{:db/ident :person/name :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/index true}
                {:db/ident :person/email :db/valueType :db.type/string :db/cardinality :db.cardinality/one
                 :db/unique :db.unique/identity}
                {:db/ident :person/age :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
                {:db/ident :person/height :db/valueType :db.type/double :db/cardinality :db.cardinality/one}
                {:db/ident :person/active :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
                {:db/ident :person/tags :db/valueType :db.type/keyword :db/cardinality :db.cardinality/many}
                {:db/ident :person/friend :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
                {:db/ident :person/boss :db/valueType :db.type/ref :db/cardinality :db.cardinality/one}
                {:db/ident :person/role :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
                {:db/ident :order/number :db/valueType :db.type/long :db/cardinality :db.cardinality/one
                 :db/unique :db.unique/value}
                {:db/ident :order/customer :db/valueType :db.type/ref :db/cardinality :db.cardinality/one}
                {:db/ident :order/total :db/valueType :db.type/double :db/cardinality :db.cardinality/one :db/index true}
                {:db/ident :order/status :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/index true}
                {:db/ident :order/items :db/valueType :db.type/string :db/cardinality :db.cardinality/many}
                {:db/ident :role/admin} {:db/ident :role/user}])

; A supervision chain: Bob and Cy report to Ann, Di reports to Cy.
(def people
  (d/transact! c [{:db/id "ann" :person/name "Ann" :person/email "ann@x" :person/age 30 :person/height 1.7
                   :person/active true :person/tags [:red :blue] :person/role :role/admin}
                  {:db/id "bob" :person/name "Bob" :person/email "bob@x" :person/age 25 :person/height 1.8
                   :person/active false :person/tags [:blue] :person/friend ["ann"] :person/boss "ann"
                   :person/role :role/user}
                  {:db/id "cy" :person/name "Cy" :person/email "cy@x" :person/age 41 :person/height 1.65
                   :person/active true :person/tags [:red :green] :person/friend ["ann" "bob"] :person/boss "ann"}
                  {:db/id "di" :person/name "Di" :person/email "di@x" :person/age 30 :person/active true
                   :person/friend ["cy"] :person/boss "cy"}
                  {:db/id "ed" :person/name "Ed" :person/email "ed@x" :person/age 55 :person/tags [:green]
                   :person/role :role/admin}]))
(d/transact! c [{:order/number 1 :order/customer [:person/email "ann@x"] :order/total 10.5 :order/status :status/open
                 :order/items ["apple" "pear"]}
                {:order/number 2 :order/customer [:person/email "bob@x"] :order/total 99.0 :order/status :status/shipped
                 :order/items ["fig"]}
                {:order/number 3 :order/customer [:person/email "ann@x"] :order/total 5.25 :order/status :status/shipped}
                {:order/number 4 :order/customer [:person/email "cy@x"] :order/total 42.0 :order/status :status/open
                 :order/items ["apple"]}])
(def update
  (d/transact! c [[:db/add [:person/email "bob@x"] :person/age 26]
                  [:db/retract [:person/email "ann@x"] :person/tags :red]
                  {:db/id [:person/email "ed@x"] :person/name "Edward"}
                  {:db/id "flo" :person/name "Flo" :person/email "flo@x" :person/age 33
                   :person/friend [[:person/email "bob@x"]]}
                  [:db/retract [:person/email "cy@x"] :person/friend [:person/email "bob@x"]]]))
(def db (d/db c))
(def ann (d/entid db [:person/email "ann@x"]))

; --- patterns, joins, constants, lookup refs, _ ---------------------------

(println (rows (d/q '[:find ?n ?a :where [?e :person/name ?n] [?e :person/age ?a]] db)))
(println (rows (d/q '[:find ?n :where [?e :person/age 30] [?e :person/name ?n]] db)))
(println (rows (d/q '[:find ?n :where [?e :person/height 1.8] [?e :person/name ?n]] db)))
(println (rows (d/q '[:find ?n :where [?e :person/active true] [?e :person/name ?n]] db)))
(println (rows (d/q '[:find ?n :where [?e :person/role :role/admin] [?e :person/name ?n]] db)))
(println (rows (d/q '[:find ?n :where [[:person/email "ann@x"] :person/name ?n]] db)))
(println (rows (d/q '[:find ?n :where [?e :person/boss [:person/email "ann@x"]] [?e :person/name ?n]] db)))
(println (rows (d/q '[:find ?t :where [_ :person/tags ?t]] db)))
(println (rows (d/q '[:find ?n :where [?e :person/age _] [?e :person/tags _] [?e :person/name ?n]] db)))
(println (rows (d/q '[:find ?n ?f :where [?e :person/friend ?x] [?e :person/name ?n] [?x :person/name ?f]] db)))
(println (rows (d/q '[:find ?n ?item :where [?o :order/customer ?e] [?o :order/items ?item] [?e :person/name ?n]] db)))
(check "a constant that names nothing matches nothing"
       (= #{} (d/q '[:find ?n :where [?e :person/tags :nope/tag] [?e :person/name ?n]] db)))
(check "a lookup ref that names nothing matches nothing"
       (= #{} (d/q '[:find ?n :where [?e :person/boss [:person/email "nobody@x"]] [?e :person/name ?n]] db)))
(check "the tx position binds the transaction entity"
       (= 1 (count (d/q '[:find ?tx :where [?e :person/name "Flo" ?tx]] db))))

; --- every :in form -------------------------------------------------------

(println (d/q '[:find ?n . :in $ ?age :where [?e :person/age ?age] [?e :person/name ?n]] db 41))
(println (rows (d/q '[:find ?n ?a :in $ [?n ...] :where [?e :person/name ?n] [?e :person/age ?a]] db ["Ann" "Di" "Nobody"])))
(println (d/q '[:find ?e . :in $ [?n ?a] :where [?e :person/name ?n] [?e :person/age ?a]] db ["Ann" 30]))
(println (rows (d/q '[:find ?n ?a ?e :in $ [[?n ?a]] :where [?e :person/name ?n] [?e :person/age ?a]] db [["Ann" 30] ["Bob" 26] ["Bob" 25]])))
(println (rows (d/q '[:find ?n :in $ ?e :where [?e :person/name ?n]] db ann)))
(println (rows (d/q '[:find ?n ?total :in $ ?status ?min :where [?o :order/status ?status] [?o :order/total ?total]
                     [(> ?total ?min)] [?o :order/customer ?e] [?e :person/name ?n]] db :status/open 20.0)))

; --- predicates: built-in, defn'd, core, alias-qualified ------------------

(defn adult? [age] (>= age 30))
(defn boom [x] (throw :boom))

(println (rows (d/q '[:find ?n :where [?e :person/age ?a] [(< 26 ?a 41)] [?e :person/name ?n]] db)))
(println (rows (d/q '[:find ?n :where [?e :person/name ?n] [(not= ?n "Ann")] [?e :person/role _]] db)))
(println (rows (d/q '[:find ?n :where [?e :person/name ?n] [(missing? $ ?e :person/tags)]] db)))
(println (rows (d/q '[:find ?n :where [?e :person/age ?a] [(adult? ?a)] [?e :person/name ?n]] db)))
(println (rows (d/q '[:find ?n :where [?e :person/age ?a] [(even? ?a)] [?e :person/name ?n]] db)))
(println (rows (d/q '[:find ?n :where [?e :person/name ?n] [(string? ?n)]] db)))
(println (rows (d/q '[:find ?n :where [?e :person/name ?n] [(s/lower-case ?n) ?l] [(= ?l "ann")]] db)))

; --- function bindings ----------------------------------------------------

(println (rows (d/q '[:find ?s :where [?e :person/name ?n] [?e :person/age ?a] [(str ?n " is " ?a) ?s]] db)))
(println (rows (d/q '[:find ?n ?next :where [?e :person/name ?n] [?e :person/age ?a] [(+ ?a 1) ?next]] db)))
(println (rows (d/q '[:find ?u :where [?e :person/name ?n] [(nexis.string/upper-case ?n) ?u]] db)))
(println (rows (d/q '[:find ?n ?a :where [?e :person/name ?n] [(get-else $ ?e :person/age -1) ?a]] db)))
(println (rows (d/q '[:find ?n ?t :where [(ground [:red :green]) [?t ...]] [?e :person/tags ?t] [?e :person/name ?n]] db)))
(println (rows (d/q '[:find ?pair :where [?e :person/name ?n] [?e :person/age ?a] [(tuple ?n ?a) ?pair]] db)))
(defn name-and-length [n] [n (count n)])
(println (rows (d/q '[:find ?n ?len :where [?e :person/name ?x] [(name-and-length ?x) [?n ?len]]] db)))
(defn twice [n] [[n 1] [n 2]])
(println (rows (d/q '[:find ?n ?k :where [?e :person/name "Ann"] [?e :person/name ?x] [(twice ?x) [[?n ?k]]]] db)))
(defn maybe-name [n] (when (= n "Cy") n))
(check "a nil function result drops the row"
       (= #{["Cy"]} (d/q '[:find ?m :where [?e :person/name ?n] [(maybe-name ?n) ?m]] db)))

; --- aggregates, :with, every find spec -----------------------------------

(println (d/q '[:find [(min ?a) (max ?a) (sum ?a) (avg ?a) (count-distinct ?a) (count ?e)] :where [?e :person/age ?a]] db))
(println (d/q '[:find (sum ?a) . :where [?e :person/age ?a]] db))
(println (d/q '[:find (sum ?a) . :with ?e :where [?e :person/age ?a]] db))
(println (rows (d/q '[:find ?b (count ?e) :where [?e :person/boss ?x] [?x :person/name ?b]] db)))
(println (sort (d/q '[:find (distinct ?t) . :where [_ :person/tags ?t]] db)))
(println (d/q '[:find ?n . :where [?e :person/age 55] [?e :person/name ?n]] db))
(println (d/q '[:find ?n . :where [?e :person/age 99] [?e :person/name ?n]] db))
(println (sort (d/q '[:find [?n ...] :where [?e :person/boss _] [?e :person/name ?n]] db)))
(println (d/q '[:find [?n ?a] :where [?e :person/email "cy@x"] [?e :person/name ?n] [?e :person/age ?a]] db))
(println (d/q '[:find [?n ?a] :where [?e :person/email "nobody@x"] [?e :person/name ?n] [?e :person/age ?a]] db))

; --- not, or, not-join, or-join ------------------------------------------

(println (rows (d/q '[:find ?n :where [?e :person/name ?n] (not [?e :person/tags _])] db)))
(println (rows (d/q '[:find ?n :where [?e :person/name ?n] (or [?e :person/tags :green] [?e :person/age 30])] db)))
(println (rows (d/q '[:find ?n :where [?e :person/name ?n] [?e :person/age _]
                     (not-join [?e] [?o :order/customer ?e] [?o :order/status :status/open])] db)))
(println (rows (d/q '[:find ?n :where [?e :person/name ?n]
                     (or-join [?e] [?e :person/role :role/admin]
                                   (and [?e :person/boss ?b] [?b :person/role :role/admin]))] db)))

; --- rules: responsible over the supervision chain ------------------------

(def rules '[[(responsible ?boss ?e) [?e :person/boss ?boss]]
             [(responsible ?boss ?e) [?e :person/boss ?mid] (responsible ?boss ?mid)]])
(println (sort (d/q '[:find [?n ...] :in $ % :where [?b :person/email "ann@x"] (responsible ?b ?e) [?e :person/name ?n]] db rules)))
(println (sort (d/q '[:find [?n ...] :in $ % :where [?b :person/email "cy@x"] (responsible ?b ?e) [?e :person/name ?n]] db rules)))
(println (rows (d/q '[:find ?b ?n :in $ % :where (responsible ?x ?e) [?x :person/name ?b] [?e :person/name ?n]] db rules)))
(check "a repeated query and rule set are served from the caches"
       (= (d/q '[:find [?n ...] :in $ % :where [?b :person/email "ann@x"] (responsible ?b ?e) [?e :person/name ?n]] db rules)
          (d/q '[:find [?n ...] :in $ % :where [?b :person/email "ann@x"] (responsible ?b ?e) [?e :person/name ?n]] db rules)))

; --- time: as-of, since, history -----------------------------------------

(def t-people (:tx people))
(def ages '[:find ?n ?a :where [?e :person/name ?n] [?e :person/age ?a]])
(println (rows (d/q ages (d/as-of db t-people))))
(println (rows (d/q ages (d/since db t-people))))
(println (rows (d/q '[:find ?a ?added :where [?e :person/email "bob@x"] [?e :person/age ?a _ ?added]] (d/history db))))
(println (rows (d/q '[:find ?n ?added :where [?e :person/email "ed@x"] [?e :person/name ?n _ ?added]] (d/history db))))

; --- explain --------------------------------------------------------------

(def plan (d/explain '[:find ?n :in $ % :where [?e :person/age 30] [?e :person/name ?n] (not [?e :person/tags :red])
                      (responsible ?e ?x) [(< 1 2)]] db rules))
(check "explain returns the plan as text" (and (string? plan) (> (count plan) 0)))

; --- errors ---------------------------------------------------------------

(println (caught (d/q '[:find ?e :where [?e bogus]] db)))
(println (caught (d/q '[:find ?x :where [?e :person/name ?n]] db)))
(println (caught (d/q '[:find ?n :in $ ?a :where [?e :person/name ?n]] db)))
(println (caught (d/q '[:find ?e :where [?e :person/name ?n] [(nope ?n)]] db)))
(println (caught (d/q '[:find ?e :in $ ?pred :where [?e :person/name ?n] [(?pred ?n)]] db adult?)))
(println (caught (d/q '[:find ?e ?a ?v :where [?e ?a ?v]] db)))
(println (caught (d/q '[:find ?e :where [?e :nope/attr ?v]] db)))
(println (caught (d/q '[:find ?e :where [?e :person/boss [:nope/attr 1]]] db)))
(println (caught (d/q '[:find (sum ?n) :where [?e :person/name ?n]] db)))
(println (caught (d/explain '[:find ?e :where [?e bogus]] db)))
(println (caught (d/q '[:find ?e :where [?e :person/name ?n] [(boom ?n)]] db)))
(check "the store still works after a predicate threw"
       (= (inc (d/basis-t db)) (:tx (d/transact! c [{:person/email "gil@x" :person/name "Gil"}]))))
(check "results are ordinary sets"
       (let [res (d/q '[:find ?n ?a :where [?e :person/name ?n] [?e :person/age ?a]] (d/db c))]
         (and (set? res) (= 6 (count res)) (= ["Ann" "Bob" "Cy" "Di" "Edward" "Flo"] (sort (map first res)))
              (contains? res ["Bob" 26]))))
(d/release c)
(println (caught (d/q ages db)))
:query-done
