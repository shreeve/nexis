; test/nextomic/time.nx — as-of, since, history (with a retract-then-
; reassert sequence), tx-range, and db-values as values across time.

(require '[nextomic :as d])
(require '[prelude :as t])

(defn vals-of [db e a] (mapv #(nth % 2) (d/datoms db :eavt e a)))
(defn rows-of [db e a] (mapv #(vector (nth % 2) (nth % 3) (nth % 4)) (d/datoms db :eavt e a)))

(def c (d/connect "time.edb"))
(d/transact! c [{:db/ident :doc/title :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
                {:db/ident :doc/tags :db/valueType :db.type/keyword :db/cardinality :db.cardinality/many}])
; t=2 schema; t=3 create; t=4 retitle; t=5 retract tag; t=6 reassert tag; t=7 retract title.
(def r (d/transact! c [{:db/id "d" :doc/title "Draft" :doc/tags [:red :blue]}]))
(def doc (get (:tempids r) "d"))
(def db3 (d/db c))
(d/transact! c [[:db/add doc :doc/title "Final"]])
(def db4 (d/db c))
(d/transact! c [[:db/retract doc :doc/tags :red]])
(d/transact! c [[:db/add doc :doc/tags :red]])
(d/transact! c [[:db/retract doc :doc/title "Final"]])
(def db7 (d/db c))

(t/check "basis advances per transaction" (= [3 4 7] [(d/basis-t db3) (d/basis-t db4) (d/basis-t db7)]))
(t/check "a db-value taken earlier still answers as of its basis" (= ["Draft"] (vals-of db3 doc :doc/title)))
(t/check "the current view has no title" (empty? (vals-of db7 doc :doc/title)))
(t/check "equal views are equal values" (= (d/as-of db7 3) (d/as-of db7 3)))
(t/check "a plain db and an as-of view at the same t are different values" (not= db3 (d/as-of db7 3)))
(t/check "as-of composes to the older bound" (= (d/as-of db7 3) (d/as-of (d/as-of db7 5) 3)))

(println (d/as-of db7 3))
(println (vals-of (d/as-of db7 3) doc :doc/title))
(println (vals-of (d/as-of db7 4) doc :doc/title))
(println (vals-of (d/as-of db7 5) doc :doc/tags))
(println (vals-of (d/as-of db7 6) doc :doc/tags))
(t/check "as-of 0 sees nothing" (nil? (d/entity (d/as-of db7 0) doc)))
(t/check "as-of before the schema has no attribute" (nil? (get (d/schema (d/as-of db7 1)) :doc/title)))

; since: only facts asserted after T, from an empty state.
(println (d/since db7 3))
(println (vals-of (d/since db7 3) doc :doc/title))
(t/check "since shows the reasserted tag, not the untouched one" (= [:red] (vals-of (d/since db7 4) doc :doc/tags)))
(t/check "since after the last change is empty" (nil? (d/entity (d/since db7 7) doc)))

; history: every assertion and retraction with its t and added flag.
(println (d/history db7))
(println (rows-of (d/history db7) doc :doc/title))
(println (rows-of (d/history db7) doc :doc/tags))
(t/check "history composes with as-of" (= [["Draft" 3 true]] (rows-of (d/as-of (d/history db7) 3) doc :doc/title)))
(t/check "the history view is not equal to the current one" (not= db7 (d/history db7)))

; tx-range over the log.
(println (mapv :t (d/tx-range c)))
(println (mapv :t (d/tx-range c 4)))
(println (mapv :t (d/tx-range c 4 6)))
(println (mapv :t (d/tx-range c nil 3)))
(t/check "tx-range entries carry an instant" (every? #(pos? (:instant %)) (d/tx-range c)))
(println (mapv (fn [[e a v t added]] [a v added])
               (filterv (fn [[e a v t added]] (not= a :db/txInstant)) (:data (first (d/tx-range c 5 6))))))
(t/check "tx-range past the end is empty" (empty? (d/tx-range c 99)))

; A db-value stays usable after later transactions on its connection.
(d/transact! c [[:db/add doc :doc/title "Again"]])
(t/check "older db-value unaffected by later writes" (empty? (vals-of db7 doc :doc/title)))
(t/check "history taken earlier stops at its basis" (= 4 (count (rows-of (d/history db7) doc :doc/tags))))
(t/check "the new db sees the write" (= ["Again"] (vals-of (d/db c) doc :doc/title)))

; Excision removes an entity's datoms, or one attribute's, from every
; view and from the txlog entries that held them; each such entry keeps
; its place with an :excised marker, as does the excising transaction.
(def r2 (d/transact! c [{:db/id "e" :doc/title "Secret" :doc/tags [:red]}]))
(def secret (get (:tempids r2) "e"))
(def db9 (d/db c))
(println (dissoc (d/excise! c secret :doc/tags) :db-before :db-after :tx-data))
(println (d/touch (d/entity (d/db c) secret)))
(println (d/touch (d/entity db9 secret)))
(println (dissoc (d/excise! c secret) :db-before :db-after :tx-data))
(t/check "the entity is gone from the current view" (nil? (d/entity (d/db c) secret)))
(t/check "and from the view taken before" (nil? (d/entity db9 secret)))
(t/check "and from history" (empty? (d/datoms (d/history (d/db c)) :eavt secret)))
(println (mapv (fn [e] [(:t e) (:excised e) (count (:data e))]) (d/tx-range c 9)))
(t/check "the untouched entity keeps its rows" (= 4 (count (rows-of (d/history (d/db c)) doc :doc/tags))))
(println (t/caught (d/excise! c :doc/title)))
(println (t/caught (d/excise! c (+ t/user-partition 99))))

; Each schema flag is masked by the transaction that asserted it: an
; attribute indexed at one t and made unique at a later t is indexed
; but not unique in a view between them, so a lookup ref on it is
; refused there; :db/isComponent reads as false before its assertion.
(def t-idx (:tx (d/transact! c [{:db/ident :doc/code :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/index true}
                                {:db/ident :doc/part :db/valueType :db.type/ref :db/cardinality :db.cardinality/one}])))
(def coded (get (:tempids (d/transact! c [{:db/id "x" :doc/code "A1"}])) "x"))
(def t-uniq (:tx (d/transact! c [[:db/add :doc/code :db/unique :db.unique/identity]])))
(def t-comp (:tx (d/transact! c [[:db/add :doc/part :db/isComponent true]])))
(def flagged (d/db c))
(defn flags [db attr] (let [m (get (d/schema db) attr)] [(:db/index m) (:db/unique m) (:db/isComponent m)]))
(println (flags (d/as-of flagged t-idx) :doc/code))
(println (flags (d/as-of flagged t-uniq) :doc/code))
(println (t/caught (d/entid (d/as-of flagged t-idx) [:doc/code "A1"])))
(t/check "the lookup ref resolves from the transaction that made the attribute unique"
       (= coded (d/entid (d/as-of flagged t-uniq) [:doc/code "A1"])))
(println [(flags (d/as-of flagged t-uniq) :doc/part) (flags flagged :doc/part)])

(d/release c)
:time-done
