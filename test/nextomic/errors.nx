; test/nextomic/errors.nx — every error keyword is catchable by try.

(require '[nextomic :as d])
(require '[prelude :as t])

(def c (d/connect "errors.edb"))
(d/transact! c [{:db/ident :user/email :db/valueType :db.type/string :db/cardinality :db.cardinality/one
                 :db/unique :db.unique/identity}
                {:db/ident :user/age :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
                {:db/ident :user/boss :db/valueType :db.type/ref :db/cardinality :db.cardinality/one}])
(def r (d/transact! c [{:db/id "a" :user/email "a@x" :user/age 1} {:db/id "b" :user/email "b@x"}]))
(def a (get (:tempids r) "a"))
(def b (get (:tempids r) "b"))
(def db (d/db c))

(println (t/caught (d/transact! c [[:db/add a :user/nope 1]])))
(println (t/caught (d/datoms db :eavt a :user/nope)))
(println (t/caught (d/transact! c [[:db/add a :user/age "old"]])))
; A caught error names the call that failed: its function, line and
; column (the file is this run's path to the script).
(defn file-age [v] (d/transact! c [[:db/add a :user/age v]]))
(println (try (file-age "old") (catch :nextomic/value-type e [(:fn e) (:line e) (:column e) (string? (:file e))])))
(println (t/caught (d/datoms db :eavt a :user/age "old")))
(println (t/caught (d/transact! c [[:db/add a :user/email "b@x"]])))
(println (t/caught (d/transact! c [[:db/add a :user/age 2] [:db/add a :user/age 3]])))
(println (t/caught (d/transact! c [[:db/add a :user/boss [:user/email "nobody@x"]]])))
(println (t/caught (d/transact! c [[:db/add 0 :user/age 2]])))
(println (t/caught (d/transact! c [[:db/add a :user/age]])))
(println (t/caught (d/transact! c [[:db/nope a :user/age 1]])))
(println (t/caught (d/transact! c "not tx-data")))
(println (t/caught (d/entid db [:user/age 1])))
(println (t/caught (d/transact! c [[:db.fn/cas a :user/age 2 3]])))
(println (t/caught (d/transact! c [[:db.fn/cas a :user/boss nil b] [:db.fn/cas a :user/boss]])))
(println (t/caught (d/transact! c [[:db.fn/call (fn [db] (throw :inside))]])))
(println (t/caught (d/transact! c [[:db.fn/call (fn [db] (d/transact! c []))]])))
(println (t/caught (d/transact! c [[:db.fn/call (fn [db] {:db/id a :user/age 2})]])))
(println (t/caught (d/transact! c [[:db.fn/call :not-a-function]])))
(println (t/caught (d/transact! c '[[:db.fn/call no-such-fn]])))
; A chain of 1000 nested calls runs (speculatively: the store is left
; alone); an endless one stops at the depth limit, which the message
; names.
(defn chain [db n] (if (zero? n) [[:db/add a :user/age 7]] [[:db.fn/call chain (dec n)]]))
(println (d/with c [[:db.fn/call chain 998]] (fn [db-after report] (count (:tx-data report)))))
(defn loops [db] [[:db.fn/call loops]])
(println (t/caught (d/transact! c [[:db.fn/call loops]])))
; A keyword's text is an index key, so the store takes one of up to
; 4077 bytes; a longer one is refused as tx-data naming the bound
; (the store is left alone), and reads of it find nothing.
(def long-kw (keyword (apply str (repeat 4078 "k"))))
(println (d/with c [{:db/ident (keyword (apply str (repeat 4077 "k")))}] (fn [db-after report] (count (:tx-data report)))))
(println (t/caught (d/transact! c [{:db/ident long-kw}])))
(println (d/entid (d/db c) long-kw))
(println (t/caught (d/connect "/")))
(println (t/caught (d/transact! c [{:db/id "a" :user/boss "ghost"}])))
(println (t/caught (d/transact! c [[:db/add (+ t/tx-partition 2) :db/txInstant #inst "1970"]])))
(println (t/caught (d/transact! c [[:db/add "datomic.tx" :db/txInstant #inst "1970-01-01T00:00:00.005Z"]])))
(println (t/caught (d/transact! c [[:db/add "datomic.tx" :db/txInstant 5]])))
(t/check "a failed transaction leaves the basis alone" (= (d/basis-t db) (d/basis-t (d/db c))))
(t/check "the store still works after every failure" (= 1 (:user/age (d/entity (d/db c) a))))

; An aborted rename leaves nothing in the connection's ident cache: a
; second connection may then mint the name for another attribute.
(def c2 (d/connect "errors.edb"))
(d/transact! c [{:db/ident :x/a :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
                {:db/ident :x/b :db/valueType :db.type/long :db/cardinality :db.cardinality/one}])
(println (t/caught (d/transact! c [[:db/add :x/a :db/ident :x/new] [:db/add :x/b :db/ident :x/new]])))
; Two renames of one attribute in one transaction conflict, and retire
; neither name.
(println (t/caught (d/transact! c [[:db/add :x/a :db/ident :x/p] [:db/add :x/a :db/ident :x/q]])))
(t/check "a conflicting rename leaves the attribute its name" (= :x/a (d/ident (d/db c) (d/entid (d/db c) :x/a))))
(d/transact! c2 [{:db/ident :x/new :db/valueType :db.type/string :db/cardinality :db.cardinality/one}])
(t/check "an aborted rename is not cached" (= (d/entid (d/db c2) :x/new) (d/entid (d/db c) :x/new)))
(t/check "the attribute keeps its old name" (= :x/a (d/ident (d/db c) (d/entid (d/db c) :x/a))))
(println (t/caught (d/transact! c [{:db/id "e" :x/new 5}])))
; A read older than its own connection's rename (a query whose function
; renames the attribute the query reads) leaves nothing in the cache:
; the connection then knows the attribute by its new name only.
(d/transact! c [{:db/ident :x/old :db/valueType :db.type/long :db/cardinality :db.cardinality/one}])
(def o (get (:tempids (d/transact! c [{:db/id "o" :x/old 1}])) "o"))
(defn rename-old [] (d/transact! c [[:db/add :x/old :db/ident :x/renamed]]) 1)
(println (d/q '[:find (pull ?e [:x/old]) :in $ ?f :where [(?f) ?z] [?e :x/old _]] (d/db c) rename-old))
(t/check "a rename inside a query leaves the old name unknown"
       (and (nil? (d/entid (d/db c) :x/old))
            (= :x/renamed (d/ident (d/db c) (d/entid (d/db c) :x/renamed)))
            (nil? (get (d/schema (d/db c)) :x/old))))
(println (t/caught (d/transact! c [{:db/id o :x/old 5}])))

; An ident is never retracted, from an attribute or an enum, by any
; form: a name leaves only by a rename, and resolves as before.
(d/transact! c [{:db/ident :x/role :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
                {:db/ident :role/admin}])
(println (t/caught (d/transact! c [[:db/retract :x/a :db/ident :x/a]])))
(println (t/caught (d/transact! c [[:db/retract :x/a :db/ident]])))
(println (t/caught (d/transact! c [[:db/retractEntity :x/a]])))
(println (t/caught (d/transact! c [[:db/retract :role/admin :db/ident :role/admin]])))
(println (t/caught (d/transact! c [[:db/retractEntity :role/admin]])))
(t/check "a refused ident retraction leaves every name resolving"
       (and (= #{[:x/a]} (d/q '[:find ?i :where [?e :db/ident ?i] [(= ?i :x/a)]] (d/db c)))
            (= #{[(d/entid (d/db c) :role/admin)]} (d/q '[:find ?e :where [?e :db/ident :role/admin]] (d/db c)))
            (= :role/admin (d/ident (d/db c) (d/entid (d/db c) :role/admin)))))
; A schema flag belongs to an attribute: on an entity with no value
; type and cardinality (a half-written attribute map, an enum ident) it
; is refused, whatever the flag.
(println (t/caught (d/transact! c [{:db/ident :x/half :db/unique :db.unique/identity}])))
(println (t/caught (d/transact! c [[:db/add :role/admin :db/unique :db.unique/value]])))
(println (t/caught (d/transact! c [[:db/add :role/admin :db/index true]])))
(println (t/caught (d/transact! c [[:db/add :role/admin :db/isComponent true]])))
; A tempid only in retractions names no entity; a lookup ref on a
; non-unique attribute is malformed as a ref value as it is as an
; entity, and nil there is the wrong type; transaction 0 never existed;
; a cas never renames; an attribute is never named like a reverse ref.
(println (t/caught (d/transact! c [[:db/retract "zz" :x/a 1] [:db/retractEntity "yy"]])))
(println (t/caught (d/transact! c [[:db/add a :user/boss [:user/age 1]]])))
(println (t/caught (d/transact! c [[:db/add a :user/boss nil]])))
(println (t/caught (d/transact! c [[:db/add t/tx-partition :db/doc "t0"]])))
(println (t/caught (d/transact! c [[:db.fn/cas :x/a :db/ident :x/a :x/cas]])))
(println (t/caught (d/transact! c [{:db/ident :x/_secret :db/valueType :db.type/string :db/cardinality :db.cardinality/one}])))
(println (t/caught (d/transact! c [[:db/add :x/a :db/ident :x/_a]])))
(t/check "an enum ident may start with _" (map? (d/transact! c [{:db/ident :role/_hidden}])))
; A cas whose old value is a keyword the store has never seen fails
; as a cas naming that keyword, and mints nothing.
(d/transact! c [[:db/add a :x/role :role/admin]])
(println (t/caught (d/transact! c [[:db.fn/cas a :x/role :role/never :role/admin]])))
(t/check "a cas mints no ident for its old value" (nil? (d/entid (d/db c) :role/never)))
; Every query and pull refusal names what is at fault (NEXTOMIC.md §7).
(println (t/caught (d/q '[:find ?e :where (foo ?e)] db)))
(println (t/caught (d/q '[:find ?e :in $ % :where (foo ?e)] db '[[(bar ?x) [?x :user/age _]]])))
(println (t/caught (d/q '[:find ?e :in $ % :where (bar ?e 1)] db '[[(bar ?x) [?x :user/age _]]])))
(println (t/caught (d/q '[:find ?e :in $ % :where (bar ?e)] db '[[(bar ?x) [?x :user/age _]] [(bar ?x ?y) [?x :user/age ?y]]])))
(println (t/caught (d/q '[:find ?e :in $ % :where (bar ?e)] db '[[(bar ?x ?x) [?x :user/age _]]])))
(println (t/caught (d/q '[:find ?e :in $ % :where (bar ?e)] db '[[(bar ?x) (bar ?x ?x)]])))
(println (t/caught (d/q '[:find ?e :where [?e zork ?v]] db)))
(println (t/caught (d/q '[:find ?e :where [?e :user/age ?v] [(< ?v zork)]] db)))
(println (t/caught (d/q '[:find ?x :in $ ?x ?x] db 1 2)))
(println (t/caught (d/q '[:find ?x :in ?x :bogus ?x] 1)))
(println (t/caught (d/q '[:find ?e :where [$2 ?e :user/age _]] db)))
(println (t/caught (d/q '[:find ?a :where [(ground [1 2]) [?a ?a]]] db)))
(println (t/caught (d/q '[:find ?x :where [?x _ _]] db)))
(println (t/caught (d/q '[:find ?x :in [?x ...]] 5)))
(println (t/caught (d/q '[:find ?x ?y :in [?x ?y]] [1])))
(println (t/caught (d/q '[:find ?a ?b :in [[?a ?b]]] [[1 2] 3])))
(println (t/caught (d/q '[:find ?a :where [(ground 5) [?a ...]]] db)))
(println (t/caught (d/q '[:find ?a ?b :where [(ground [[1 2] [3]]) [[?a ?b]]]] db)))
(println (t/caught (d/q '[:find ?x :where [?e :user/age _] [(get-else $ ?e 7 0) ?x]] db)))
(println (t/caught (d/q '[:find ?e :where [(fulltext $ 7 "a") [[?e ?x]]]] db)))
(println (t/caught (d/pull db '[foo] a)))
(println (t/caught (d/pull db '[(:user/email :xform str)] a)))
(println (t/caught (d/pull db '[{:user/age [:user/email]}] a)))
; An unbound function name throws before any row runs, whether or not
; a row would reach its clause.
(println (t/caught (d/q '[:find ?e :where [?e :user/email "nobody@x"] [(no-such-fn ?e)]] db)))
(println (t/caught (d/q '[:find (no-such-agg ?e) :where [?e :user/email "nobody@x"]] db)))

(d/release c2)
(def last-t (d/basis-t (d/db c)))

; Releasing: idempotent; every later use of the connection or of a
; db-value taken from it is :nextomic/closed.
(d/release c)
(d/release c)
(println (t/caught (d/db c)))
(println (t/caught (d/transact! c [[:db/add a :user/age 2]])))
(println (t/caught (d/entity db a)))
(println (t/caught (d/datoms db :eavt a)))
(println (t/caught (d/basis-t (d/as-of db 1))))
(println (t/caught (d/tx-range c)))
(println (t/caught (d/sync c)))
(t/check "release is idempotent" (nil? (d/release c)))

; The store reopens cleanly after all of that.
(d/with-conn [c2 "errors.edb"]
  (t/check "reopened store is at the last committed basis" (= last-t (d/basis-t (d/db c2)))))
(println :errors-done)
