; test/nextomic/basics.nx — connect, schema, transact!, entity (lazy,
; read on access; touch for the map), entid, ident, schema. Runs from a
; scratch directory; the store is fresh.

(require '[nextomic :as d])
(require '[prelude :as t])

; Drop the transaction's own :db/txInstant datom: its value is the clock.
(defn facts [report]
  (filterv (fn [[e a v t added]] (not= a :db/txInstant)) (:tx-data report)))

(def c (d/connect "basics.edb"))
(println c)
(println (d/db c))
(t/check "fresh store is at the bootstrap basis" (= 1 (d/basis-t (d/db c))))
(t/check "db-values are values" (= (d/db c) (d/db c)))
(t/check "a db-value is not its history view" (not= (d/db c) (d/history (d/db c))))
; Two connections to one file read one database: their db-values at
; one basis and mode are equal, and hash alike.
(d/with-conn [again "basics.edb"]
  (t/check "db-values of two connections to one file are equal"
         (and (= (d/db c) (d/db again)) (= (hash (d/db c)) (hash (d/db again)))
              (= (d/as-of (d/db c) 1) (d/as-of (d/db again) 1))
              (not= (d/db c) (d/history (d/db again)))
              (= #{(d/db c)} #{(d/db again)})
              (= (d/entity (d/db c) :db/ident) (d/entity (d/db again) :db/ident)))))

; Schema install is an ordinary transaction of attribute entities.
(def schema-report
  (d/transact! c [{:db/ident :person/name :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
                  {:db/ident :person/email :db/valueType :db.type/string :db/cardinality :db.cardinality/one
                   :db/unique :db.unique/identity}
                  {:db/ident :person/age :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
                  {:db/ident :person/height :db/valueType :db.type/double :db/cardinality :db.cardinality/one}
                  {:db/ident :person/active :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
                  {:db/ident :person/born :db/valueType :db.type/instant :db/cardinality :db.cardinality/one}
                  {:db/ident :person/tags :db/valueType :db.type/keyword :db/cardinality :db.cardinality/many}
                  {:db/ident :person/friends :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
                  {:db/ident :person/home :db/valueType :db.type/ref :db/cardinality :db.cardinality/one
                   :db/isComponent true}
                  {:db/ident :addr/city :db/valueType :db.type/string :db/cardinality :db.cardinality/one
                   :db/index true}
                  {:db/ident :person/uuid :db/valueType :db.type/uuid :db/cardinality :db.cardinality/one}
                  {:db/ident :person/photo :db/valueType :db.type/bytes :db/cardinality :db.cardinality/one}]))
(t/check "schema transaction is t=2" (= 2 (:tx schema-report)))
(t/check "attribute entities take ids in the attribute partition" (= 23 (d/entid (d/db c) :person/name)))
(t/check "db-before and db-after bracket the transaction"
       (and (= 1 (d/basis-t (:db-before schema-report))) (= 2 (d/basis-t (:db-after schema-report)))))
(println (get (d/schema (d/db c)) :person/email))
(println (get (d/schema (d/db c)) :person/home))
(println (get (d/schema (d/db c)) :addr/city))
(t/check "ident round trips" (= :person/tags (d/ident (d/db c) (d/entid (d/db c) :person/tags))))
(t/check "ident of an unknown eid is nil" (nil? (d/ident (d/db c) 12345)))
(t/check "entid of an unknown ident is nil" (nil? (d/entid (d/db c) :person/nope)))

; Map forms with tempids, card-many vectors, nested component maps, and
; vector forms that refer to the same tempids.
(def r1 (d/transact! c [{:db/id "ann" :person/name "Ann" :person/email "ann@example.com" :person/age 41
                         :person/height 1.7 :person/active true :person/born 1000000
                         :person/tags [:staff :admin]
                         :person/home {:addr/city "Rome"}
                         :person/uuid "0123abcd-4567-89ef-0123-456789abcdef"
                         :person/photo "raw bytes"}
                        [:db/add "bob" :person/name "Bob"]
                        [:db/add "bob" :person/email "bob@example.com"]
                        [:db/add "bob" :person/friends "ann"]
                        [:db/add "datomic.tx" :db/doc "first import"]
                        [:db/add :person/photo :db/doc "a portrait"]]))
(println (:tempids r1))
(println (facts r1))
(println (get (d/schema (d/db c)) :person/photo))
(t/check "schema and the attribute entity agree on the doc"
       (= "a portrait" (:db/doc (get (d/schema (d/db c)) :person/photo)) (:db/doc (d/entity (d/db c) :person/photo))))
(t/check "the doc is absent from the view before it" (nil? (:db/doc (get (d/schema (:db-before r1)) :person/photo))))
(def ann (get (:tempids r1) "ann"))
(def bob (get (:tempids r1) "bob"))
(println (d/entity (d/db c) ann))
(println (d/touch (d/entity (d/db c) ann)))
(println (d/touch (d/entity (d/db c) bob)))
(t/check "the transaction entity carries its doc"
       (= "first import" (:db/doc (d/entity (d/db c) (+ t/tx-partition (:tx r1))))))
(t/check "a ref reads as an entity of the same view, so access navigates"
       (= "Rome" (:addr/city (:person/home (d/entity (d/db c) ann)))))
(t/check "entities of one view are equal; entity-db is the view"
       (let [ent (d/entity (d/db c) ann)]
         (and (= ent (d/entity (d/db c) ann))
              (= (:person/home ent) (d/entity (d/db c) (:db/id (:person/home ent))))
              (= (d/db c) (d/entity-db ent))
              (not= ent (d/entity (d/db c) bob)))))
(t/check "entity by lookup ref" (= ann (:db/id (d/entity (d/db c) [:person/email "ann@example.com"]))))
(t/check "entity by unknown lookup ref is nil" (nil? (d/entity (d/db c) [:person/email "nobody@example.com"])))
(t/check "entid by lookup ref" (= bob (d/entid (d/db c) [:person/email "bob@example.com"])))
(t/check "an entity with no datoms is nil" (nil? (d/entity (d/db c) (+ t/user-partition 999))))

; Card-one overwrite retracts the old value in the same transaction;
; re-asserting a current value writes nothing.
(def r2 (d/transact! c [[:db/add ann :person/age 42]]))
(println (facts r2))
(t/check "no-op re-assertion writes only :db/txInstant" (empty? (facts (d/transact! c [[:db/add ann :person/age 42]]))))

; Card-many accumulates; explicit retract removes one value.
(d/transact! c [[:db/add ann :person/tags :founder]])
(println (:person/tags (d/entity (d/db c) ann)))
(d/transact! c [[:db/retract ann :person/tags :admin]])
(println (:person/tags (d/entity (d/db c) ann)))
; Retracting the attribute drops every value.
(d/transact! c [[:db/retract ann :person/tags]])
(t/check "retract-attribute leaves no values" (nil? (:person/tags (d/entity (d/db c) ann))))

; Unique identity upserts: a map keyed by the same email updates Ann.
(def r3 (d/transact! c [{:db/id "who" :person/email "ann@example.com" :person/name "Ann Lee"}]))
(t/check "upsert resolves the tempid to the existing entity" (= ann (get (:tempids r3) "who")))
(println (:person/name (d/entity (d/db c) ann)))

; Negative fixnum tempids, lookup refs in entity position, refs by
; lookup ref.
(def r4 (d/transact! c [[:db/add -1 :person/name "Cy"]
                        [:db/add -1 :person/friends [:person/email "ann@example.com"]]
                        [:db/add [:person/email "bob@example.com"] :person/age 30]]))
(println (:tempids r4))
(t/check "ref by lookup ref resolves" (= #{ann} (set (map :db/id (:person/friends (d/entity (d/db c) (get (:tempids r4) -1)))))))
(t/check "lookup ref in entity position" (= 30 (:person/age (d/entity (d/db c) bob))))

; retractEntity removes the entity's datoms, the refs pointing at it and
; its components.
(def home (:db/id (:person/home (d/entity (d/db c) ann))))
(def r5 (d/transact! c [[:db/retractEntity ann]]))
(println (count (facts r5)))
(t/check "retracted entity is gone" (nil? (d/entity (d/db c) ann)))
(t/check "its component is gone" (nil? (d/entity (d/db c) home)))
(t/check "refs to it are gone" (nil? (:person/friends (d/entity (d/db c) bob))))
(t/check "its email is free again" (nil? (d/entid (d/db c) [:person/email "ann@example.com"])))

; Transaction functions: [:db.fn/call f arg ...] calls f with db-before
; and the args; its tx-data takes the form's place. A symbol names a
; var; the function value itself is never stored.
(defn older [db e years]
  [[:db/add e :person/age (+ years (:person/age (d/entity db e)))]])
(defn older-twice [db e] [[:db.fn/call older e 1] [:db.fn/call older e 1]])
(println (facts (d/transact! c [[:db.fn/call older bob 5]])))
(println (facts (d/transact! c '[[:db.fn/call older 4294967298 1]])))
(t/check "nested calls see the same db-before, so equal claims are one datom"
       (= 37 (:person/age (d/entity (:db-after (d/transact! c [[:db.fn/call older-twice bob]])) bob))))
(t/check "a nil result is no tx-data" (empty? (facts (d/transact! c [[:db.fn/call (fn [db] nil)]]))))
(t/check "a call inside with is speculative"
       (= [38 37] [(d/with c [[:db.fn/call older bob 1]] (fn [db r] (:person/age (d/entity db bob))))
                   (:person/age (d/entity (d/db c) bob))]))

; :db.fn/cas asserts new when the current value is old; nil old means absent.
(println (facts (d/transact! c [[:db.fn/cas bob :person/age 37 40]])))
(println (t/caught (d/transact! c [[:db.fn/cas bob :person/age 37 41]])))
(println (t/caught (d/transact! c [[:db.fn/cas bob :person/height nil 1.8] [:db.fn/cas bob :person/height nil 1.9]])))
(t/check "cas against an absent attribute" (= 1.8 (:person/height (d/entity (:db-after (d/transact! c [[:db.fn/cas bob :person/height nil 1.8]])) bob))))
(println (t/caught (d/transact! c [[:db.fn/cas bob :person/height nil 1.9]])))

; Schema alteration: :db/ident on an attribute entity renames it (the
; old name retires, for every view), :db/cardinality goes one -> many
; freely and many -> one while no entity holds two values.
(def db-named (d/db c))
(println (facts (d/transact! c [[:db/add :person/name :db/ident :person/full-name]])))
(println [(d/entid (d/db c) :person/name) (d/entid (d/db c) :person/full-name) (d/ident (d/db c) 23)])
(println (:person/full-name (d/entity (d/db c) bob)))
(t/check "the old name is gone from every view" (= (keys (d/entity db-named bob)) (keys (d/entity (d/db c) bob))))
(t/check "tx-range decodes the entries written under the old name"
       (= 1 (count (filterv (fn [[e a v]] (= [a v] [:db/ident :person/full-name])) (:data (first (d/tx-range c 2 3)))))))
(println (t/caught (d/transact! c [[:db/add bob :person/name "Bob"]])))
(println (t/caught (d/transact! c [{:db/ident :person/name :db/valueType :db.type/string :db/cardinality :db.cardinality/one}])))
(println (t/caught (d/transact! c [[:db/add :person/full-name :db/ident :person/age]])))
(d/transact! c [[:db/add :person/full-name :db/cardinality :db.cardinality/many]])
(d/transact! c [[:db/add bob :person/full-name "Robert"]])
(println (:person/full-name (d/entity (d/db c) bob)))
(println (:person/full-name (d/entity db-named bob)))
(println (t/caught (d/transact! c [[:db/add :person/full-name :db/cardinality :db.cardinality/one]])))
(d/transact! c [[:db/retract bob :person/full-name "Bob"]])
(d/transact! c [[:db/add :person/full-name :db/cardinality :db.cardinality/one]])
(println (:db/cardinality (get (d/schema (d/db c)) :person/full-name)))
(println (:person/full-name (d/entity (d/db c) bob)))
(println (t/caught (d/transact! c [[:db/add :person/email :db/cardinality :db.cardinality/many]])))
(println (t/caught (d/transact! c [[:db/add :person/age :db/valueType :db.type/string]])))

; tx-data is a set: a bare retract or a retractEntity expands against
; the committed values, so an add under the same attribute stands in
; either order; re-asserting a current datom and retracting it in one
; transaction is a conflict in either order.
(d/transact! c [[:db/add bob :person/age 9] [:db/retract bob :person/age]])
(println (:person/age (d/entity (d/db c) bob)))
(d/transact! c [[:db/retract bob :person/age] [:db/add bob :person/age 10]])
(println (:person/age (d/entity (d/db c) bob)))
(println (t/caught (d/transact! c [[:db/add bob :person/age 10] [:db/retract bob :person/age]])))
(println (t/caught (d/transact! c [[:db/retract bob :person/age] [:db/add bob :person/age 10]])))
(println (t/caught (d/transact! c [[:db/add bob :person/age 10] [:db/retract bob :person/age 10]])))
(println (t/caught (d/transact! c [[:db/add bob :person/age 10] [:db/retractEntity bob]])))
(d/transact! c [[:db/add bob :person/age 11] [:db/retractEntity bob]])
(println (d/touch (d/entity (d/db c) bob)))
(d/transact! c [[:db/retractEntity bob] [:db/add bob :person/age 12]])
(println (d/touch (d/entity (d/db c) bob)))

; Unique values and lookup refs read tx-data as a set too: a unique
; value moves to another entity whichever form comes first, and a
; lookup ref names an identity the transaction asserts wherever that
; assertion stands.
(def xy (d/transact! c [{:db/id "x" :person/email "x@example.com"} {:db/id "y" :person/email "y@example.com"}]))
(def x (get (:tempids xy) "x"))
(def y (get (:tempids xy) "y"))
(d/transact! c [[:db/add y :person/email "x@example.com"] [:db/add x :person/email "x2@example.com"]])
(t/check "a unique value moves before its old holder lets go" (= y (d/entid (d/db c) [:person/email "x@example.com"])))
(d/transact! c [[:db/add [:person/email "new@example.com"] :person/age 7] [:db/add "n" :person/email "new@example.com"]])
(t/check "a lookup ref names an identity asserted after it" (= 7 (:person/age (d/entity (d/db c) [:person/email "new@example.com"]))))
(println (t/caught (d/transact! c [[:db/add x :person/email "y2@example.com"] [:db/add y :person/email "x2@example.com"]])))
(println (t/caught (d/transact! c [[:db/add x :person/email "x2@example.com"] [:db/add x :person/age 1]])))

(d/release c)
(println :basics-done)
