; test/nextomic/gc.nx — the collector runs inside query callbacks. The
; build runs this script with NEXIS_GC_STRESS=1, so a cycle is due every
; few kilobytes and every user function called from `q` (a predicate, a
; function binding, a custom aggregate) allocates enough to trigger one
; while the pipeline still holds earlier results. Runs from a scratch
; directory; the store is fresh.

(require '[nextomic :as d])
(require '[prelude :as t])

(defn rows [res] (sort res))

(def c (d/connect "gc.edb"))
(d/transact! c [{:db/ident :item/name :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
                {:db/ident :item/n :db/valueType :db.type/long :db/cardinality :db.cardinality/one}])
(d/transact! c (mapv (fn [i] {:item/name (str "item-" i) :item/n i}) (range 40)))
(def db (d/db c))

; Every call builds and drops a few kilobytes of garbage.
(defn churn [x] (count (apply str (map (fn [i] (str x i)) (range 200)))))

(defn big-even? [n] (churn n) (even? n))
(t/check "predicate survives collections"
  (= (rows (d/q '[:find ?n :where [?e :item/n ?n] [(big-even? ?n)]] db))
     (rows (map vector (filter even? (range 40))))))

(defn label [n] (churn n) (str "L" n))
(t/check "function binding results survive collections"
  (= (rows (d/q '[:find ?l :where [?e :item/n ?n] [(< ?n 10)] [(label ?n) ?l]] db))
     (rows (map (fn [n] [(str "L" n)]) (range 10)))))

(defn total [xs] (churn (count xs)) (reduce + 0 xs))
(t/check "custom aggregate survives collections"
  (= (d/q '[:find (total ?n) . :where [?e :item/n ?n]] db)
     (reduce + 0 (range 40))))

(t/check "the same query parses again after the caches emptied"
  (= (rows (d/q '[:find ?n :where [?e :item/n ?n] [(big-even? ?n)]] db))
     (rows (map vector (filter even? (range 40))))))

(d/release c)
(println "done")
