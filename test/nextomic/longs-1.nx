; test/nextomic/longs-1.nx — :db.type/long and :db.type/instant hold the
; full signed 64-bit range (docs/NEXTOMIC.md §2.2): transact, entity,
; pull, lookup refs, index order, range seeks, query comparisons and
; aggregates across the fixnum boundary (±2^47) and the double one
; (±2^53), cas, history, the txlog. One past i64 is refused.
; longs-2.nx reads the store back in a new process.

(require '[nextomic :as d])
(require '[prelude :as t])

(def i64-max 9223372036854775807)
(def i64-min -9223372036854775808)
(def i48-max 140737488355327)
(def i48-min -140737488355328)
(def two53 9007199254740992)
(def edges [i64-min (dec (- two53)) (- two53) (dec i48-min) i48-min -1
            0 i48-max (inc i48-max) two53 (inc two53) i64-max])

(def c (d/connect "longs.edb"))
(d/transact! c [{:db/ident :n/v :db/valueType :db.type/long :db/cardinality :db.cardinality/one :db/index true}
                {:db/ident :n/id :db/valueType :db.type/long :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
                {:db/ident :n/all :db/valueType :db.type/long :db/cardinality :db.cardinality/many}
                {:db/ident :n/at :db/valueType :db.type/instant :db/cardinality :db.cardinality/one :db/index true}])
(def r (d/transact! c (vec (map-indexed (fn [i v] {:db/id (str i) :n/v v :n/id v :n/at v}) edges))))
(def ids (mapv #(get (:tempids r) (str %)) (range (count edges))))
(def db (d/db c))

; Reads return the value written, a fixnum or a bignum as the language
; represents it.
(t/check "entity reads every edge" (= edges (mapv #(:n/v (d/entity db %)) ids)))
(t/check "instants read every edge" (= edges (mapv #(:n/at (d/entity db %)) ids)))
(t/check "pull reads every edge" (= edges (mapv #(:n/v (d/pull db [:n/v] %)) ids)))
(t/check "datoms read every edge" (= edges (mapv #(nth (first (d/datoms db :eavt % :n/v)) 2) ids)))
(t/check "an exact datom with a bignum value" (= 1 (count (d/datoms db :eavt (peek ids) :n/v i64-max))))
(t/check "a lookup ref by a bignum" (= (peek ids) (:db/id (d/pull db [:db/id] [:n/id i64-max]))))
(t/check "a lookup ref by the least long" (= (first ids) (:db/id (d/entity db [:n/id i64-min]))))

; Index order is value order, as compare sorts.
(println (mapv #(nth % 2) (d/datoms db :avet :n/v)))
(t/check "avet order agrees with sort" (= (sort edges) (mapv #(nth % 2) (d/datoms db :avet :n/v))))
(t/check "instant order agrees with sort" (= (sort edges) (mapv #(nth % 2) (d/datoms db :avet :n/at))))

; Range seeks with fixnum and bignum bounds on either side of a boundary.
(defn vs [ds] (mapv #(nth % 2) ds))
(println (vs (d/index-range db :n/v i48-max (inc two53))))
(println (vs (d/index-range db :n/v i64-min i48-min)))
(println (vs (d/index-range db :n/v (inc i48-max) nil)))
(println (vs (d/index-range db :n/v nil (dec i48-min))))
(println (vs (d/index-range db :n/at -1 (inc i48-max))))

; Past i64 is refused, as Datomic's long refuses it.
(println (t/caught (d/transact! c [{:n/v (inc i64-max)}])))
(println (t/caught (d/transact! c [{:n/v (dec i64-min)}])))
(println (t/caught (d/transact! c [{:n/at (inc i64-max)}])))
(println (t/caught (d/index-range db :n/v 0 (inc i64-max))))
(println (t/caught (d/datoms db :avet :n/v (dec i64-min))))

; Query: constants, inputs, predicates and aggregates across the boundaries.
(t/check "a bignum constant in a pattern" (= #{[(peek ids)]} (d/q '[:find ?e :where [?e :n/v 9223372036854775807]] db)))
(println (t/caught (d/q '[:find ?v :where [_ 140737488355328 ?v]] db)))
(t/check "the tx position holds a transaction entity"
         (= 12 (count (d/q '[:find ?e :where [?e :n/v _ 70368744177667]] db))))
(t/check "a tx constant past the id range matches nothing"
         (empty? (d/q '[:find ?e :where [?e :n/v _ 4611756387171565571]] db)))
(t/check "a bignum input" (= #{[(first ids)]} (d/q '[:find ?e :in $ ?x :where [?e :n/v ?x]] db i64-min)))
(println (sort (d/q '[:find [?v ...] :where [_ :n/v ?v] [(> ?v 140737488355327)]] db)))
(println (sort (d/q '[:find [?v ...] :in $ ?lo ?hi :where [_ :n/v ?v] [(<= ?lo ?v ?hi)]] db (- two53) i48-min)))
(t/check "a bound past i64 compares exactly"
         (= 12 (count (d/q '[:find ?v :in $ ?big :where [_ :n/v ?v] [(< ?v ?big)]] db (* 4 i64-max)))))
(t/check "a double compares by contagion" (= 1 (count (d/q '[:find ?v :where [_ :n/v ?v] [(> ?v 9.0e18)]] db))))
(println (d/q '[:find (min ?v) (max ?v) (count ?v) :where [_ :n/v ?v]] db))
(println (d/q '[:find (min 3 ?v) (max 3 ?v) :where [_ :n/v ?v]] db))
(t/check "sum is exact" (= (reduce + edges) (d/q '[:find (sum ?v) . :with ?e :where [?e :n/v ?v]] db)))
(println (d/q '[:find (sum ?v) . :with ?e :where [?e :n/v ?v] [(> ?v 0)]] db))
(println (d/q '[:find (median ?v) . :with ?e :where [?e :n/v ?v] [(> ?v 0)]] db))
(println (d/q '[:find (avg ?v) . :with ?e :where [?e :n/v ?v] [(>= ?v 9007199254740992)]] db))
(println (d/q '[:find (sum ?x) . :in [?x ...]] [(* 4 i64-max) 1 i64-min]))
(println (d/q '[:find (max ?x) . :in [?x ...]] [(* 4 i64-max) 1 i64-max]))

; Cardinality many, cas and history keep the full range.
(def e0 (first ids))
(d/transact! c [[:db/add e0 :n/all i64-min] [:db/add e0 :n/all 0] [:db/add e0 :n/all i64-max]])
(t/check "a card-many set of edges" (= #{i64-min 0 i64-max} (:n/all (d/entity (d/db c) e0))))
(def before (d/db c))
(def cas (d/transact! c [[:db.fn/cas e0 :n/v i64-min i64-max]]))
(println (t/caught (d/transact! c [[:db.fn/cas e0 :n/v i64-min 0]])))
(t/check "cas asserted the bignum" (= i64-max (:n/v (d/entity (d/db c) e0))))
(t/check "as-of reads the value before" (= i64-min (:n/v (d/entity (d/as-of (d/db c) (d/basis-t before)) e0))))
(println (sort (d/q '[:find ?v ?added :in $ ?e :where [?e :n/v ?v _ ?added]] (d/history (d/db c)) e0)))

; The txlog carries the values as the language represents them.
(def t0 (d/basis-t db))
(t/check "the txlog holds every edge"
         (= (set edges) (set (keep (fn [[e a v]] (when (= a :n/v) v)) (:data (first (d/tx-range c t0 (inc t0))))))))

; A :db/txInstant past the fixnum range stands, in the entity and the txlog.
(def late (d/transact! c [[:db/add "datomic.tx" :db/txInstant (inc i48-max)] [:db/add e0 :n/v 1]]))
(t/check "the instant on the transaction entity" (= (inc i48-max) (:db/txInstant (d/entity (d/db c) (+ t/tx-partition (:tx late))))))
(t/check "the instant in the txlog" (= (inc i48-max) (:instant (first (d/tx-range c (:tx late) nil)))))

(d/release c)
(println :longs-1-done)
