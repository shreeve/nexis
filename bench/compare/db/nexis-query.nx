; bench/compare/db/nexis-query.nx — reopen the store nexis-load.nx
; built and time the read and write workloads of docs/BENCH.md §12
; against it. Usage: nexis run nexis-query.nx STORE
; Twins: dtlv-query.clj, datomic-local-query.clj, datomic-pro-query.clj;
; the same operations and answers (Datalevin has no time views).

(require '[nextomic :as d])

(def path (first *command-line-args*))

; ns is taken before the answer is computed: arguments evaluate left
; to right, so a check query after the work stays outside the time.
(defn report [phase ns answer]
  (println (str "phase=" phase " ns=" ns " answer=" answer)))

(defn email [i] (str "p" i "@x.org"))

(def t-open (nano-time))
(def conn (d/connect path))
(def db0 (d/db conn))
(report "open" (- (nano-time) t-open) (some? (d/entid db0 [:dept/name "d0"])))

; 10,000 point reads through the unique email, one entity each.
(let [t0 (nano-time)
      total (loop [i 0 acc 0]
              (if (< i 10000)
                (recur (inc i) (+ acc (:person/age (d/entity db0 [:person/email (email (* i 10))]))))
                acc))]
  (report "lookup-10k" (- (nano-time) t0) total))

; A three-clause join, once for each of 20 departments (20,000 rows).
(let [t0 (nano-time)
      total (loop [k 0 acc 0]
              (if (< k 20)
                (recur (inc k)
                       (+ acc (count (d/q '[:find ?p ?name :in $ ?dn
                                            :where [?d :dept/name ?dn] [?p :person/dept ?d] [?p :person/name ?name]]
                                          db0 (str "d" k)))))
                acc))]
  (report "join3-20x" (- (nano-time) t0) total))

; Salary totals per department over every person.
(let [t0 (nano-time)
      rows (d/q '[:find ?dn (sum ?s) :with ?p
                  :where [?p :person/dept ?d] [?d :dept/name ?dn] [?p :person/salary ?s]]
                db0)]
  (report "aggregate" (- (nano-time) t0) (str (count rows) "/" (reduce + (map second rows)))))

; pull-many of 10,000 people with their department's name.
(let [eids (mapv (fn [i] (d/entid db0 [:person/email (email (* i 10))])) (range 10000))
      t0 (nano-time)
      res (d/pull-many db0 [:person/name :person/age {:person/dept [:dept/name]}] eids)]
  (report "pull-10k" (- (nano-time) t0) (str (count res) "/" (reduce + (map :person/age res)) "/"
                             (count (filter (fn [r] (:dept/name (:person/dept r))) res)))))

; The lookups and the pull again over other people (offset p = 1..9,
; nine passes), each pass timed: the median pass, and the answers'
; total. Neither goes through a query, so no result cache applies; a
; JVM has compiled the paths by then.
(defn median [xs] (nth (vec (sort xs)) (quot (dec (count xs)) 2)))

(let [passes (mapv (fn [p]
                     (let [t0 (nano-time)
                           total (loop [i 0 acc 0]
                                   (if (< i 10000)
                                     (recur (inc i) (+ acc (:person/age (d/entity db0 [:person/email (email (+ p (* i 10)))]))))
                                     acc))]
                       [(- (nano-time) t0) total]))
                   (range 1 10))]
  (report "lookup-10k-warm" (median (map first passes)) (reduce + (map second passes))))

(let [pattern [:person/name :person/age {:person/dept [:dept/name]}]
      passes (mapv (fn [p]
                     (let [eids (mapv (fn [i] (d/entid db0 [:person/email (email (+ p (* i 10)))])) (range 10000))
                           t0 (nano-time)
                           res (d/pull-many db0 pattern eids)
                           ns (- (nano-time) t0)]
                       [ns (reduce + (map :person/age res))]))
                   (range 1 10))]
  (report "pull-10k-warm" (median (map first passes)) (reduce + (map second passes))))

(def salary-sum-q
  '[:find (sum ?s) . :with ?p :in $ [?em ...] :where [?p :person/email ?em] [?p :person/salary ?s]])
(def first-1000 (mapv email (range 1000)))

; Three batches of 1,000 transactions of one datom each, the same
; writes in every twin: in the default commit (`:commit`: atomic, no
; sync; docs/DB.md §3.3), through a second connection opened
; `{:durability :durable}` (each commit syncs data, then meta), and
; with `:sync :none` and one sync at the end.
(def t-before (d/basis-t (d/db conn)))
(let [t0 (nano-time)]
  (dotimes [i 1000]
    (d/transact! conn [[:db/add [:person/email (email i)] :person/salary (inc i)]]))
  (report "tx-1k-default" (- (nano-time) t0) (d/q salary-sum-q (d/db conn) first-1000)))

(let [durable (d/connect path {:durability :durable})
      t0 (nano-time)]
  (dotimes [i 1000]
    (d/transact! durable [[:db/add [:person/email (email i)] :person/salary (+ 2 i)]]))
  (report "tx-1k-durable" (- (nano-time) t0) (d/q salary-sum-q (d/db durable) first-1000))
  (d/release durable))

(let [t0 (nano-time)]
  (dotimes [i 1000]
    (d/transact! conn [[:db/add [:person/email (email i)] :person/salary (+ 3 i)]] {:sync :none}))
  (d/sync conn)
  (report "tx-1k-nosync" (- (nano-time) t0) (d/q salary-sum-q (d/db conn) first-1000)))

; One entity of five attributes per transaction, in the default
; commit: 1,000 new people, then 1,000 upserts of existing ones through
; the unique email, each changing the salary alone.
(def dept-eids (let [db (d/db conn)] (mapv (fn [k] (d/entid db [:dept/name (str "d" k)])) (range 100))))
(defn person [i salary]
  {:person/email (email i) :person/name (str "name-" i) :person/age (+ 18 (mod (* i 7) 60))
   :person/dept (nth dept-eids (mod i 100)) :person/salary salary})
(def upserted (mapv email (range 1000 2000)))

(let [t0 (nano-time)]
  (dotimes [i 1000]
    (d/transact! conn [(person (+ 100000 i) (+ 30000 i))]))
  (report "tx-entity-1k" (- (nano-time) t0) (d/q '[:find (count ?e) . :where [?e :person/email]] (d/db conn))))

(let [t0 (nano-time)]
  (dotimes [i 1000]
    (d/transact! conn [(person (+ 1000 i) (+ 4 i))]))
  (report "tx-upsert-1k" (- (nano-time) t0) (d/q salary-sum-q (d/db conn) upserted)))

; The time views: the salary total as of the basis before the writes,
; and the count of salary datoms in the history of those 1,000 people.
(let [t0 (nano-time)
      db (d/db conn)
      before (d/q salary-sum-q (d/as-of db t-before) first-1000)
      hist (d/q '[:find (count ?s) . :with ?p ?tx ?added :in $ [?em ...]
                  :where [?p :person/email ?em] [?p :person/salary ?s ?tx ?added]]
                (d/history db) first-1000)]
  (report "as-of+history" (- (nano-time) t0) (str before "/" hist)))

(d/release conn)
