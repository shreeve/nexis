; bench/micro/vdestr.nx N: count plus destructuring [x y & more] of a vector, the destructuring row's shape: two nth, an nthnext and a count, each a leaf called through a Var.
(let [n (parse-long (first *command-line-args*))
      v [1 2 3 4]]
  (println (loop [i 0 acc 0] (if (< i n) (recur (inc i) (let [[x y & more] v] (+ acc x y (count more)))) acc))))
