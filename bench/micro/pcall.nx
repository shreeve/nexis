; bench/micro/pcall.nx N: count plus a call of a protocol method on a record, three types extending it.
(defprotocol Shape (area [s]))
(defrecord Tri [] Shape (area [_] 0))
(defrecord Circ [] Shape (area [_] 2))
(defrecord Sq [] Shape (area [_] 1))
(let [n (parse-long (first *command-line-args*))
      r (->Sq)]
  (println (loop [i 0 k 0] (if (< i n) (recur (inc i) (area r)) k))))
