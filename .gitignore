.zig-cache/
zig-out/
bin/
*.o
*.a
*.dSYM/
.DS_Store
notes.txt

# Bench JSON artifacts are per-machine run outputs. Numbers of
# record live inline in docs/PERF.md; regenerate locally with
# `zig build bench -- --out bench/baseline.json`.
bench/*.json

# Phase 4: emdb data files (created during testing).
# Examples that use relative paths now write to `tmp/`
# (see `examples/todo-app.nx`, `examples/durable-refs.nx`); the
# bare patterns below catch any stragglers from REPL sessions or
# ad-hoc commands run from the repo root. `tmp/.gitkeep` keeps
# the directory present at clone time (emdb doesn't auto-create
# parent dirs); everything else inside `tmp/` is local-only.
*.edb
*.edb-lock
tmp/*
!tmp/.gitkeep
