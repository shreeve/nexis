.zig-cache/
zig-out/
bin/
*.o
*.a
*.dSYM/
.DS_Store
notes.txt

# Bench JSON artifacts are per-machine run outputs. Numbers of
# record live inline in docs/PERF.md; regenerate locally with
# `zig build bench -- --out bench/baseline.json`.
bench/*.json

# Store files left by a REPL session or an ad-hoc run from the repo
# root. Examples write under tmp/ (`db/open` creates the parent
# directories); tests and benches write under .zig-cache/tmp/.
*.edb
*.edb-lock
*.emdb
*.emdb-lock
tmp/
