.zig-cache/
zig-out/
bin/
*.o
*.a
*.dSYM/
.DS_Store
notes.txt

# Bench JSON artifacts are per-machine run outputs. Numbers of
# record live inline in docs/PERF.md; regenerate locally with
# `zig build bench -- --out bench/baseline.json`.
bench/*.json

# Phase 4: emdb data files (created during testing).
# Examples that use relative paths now write to `tmp/` (see
# `examples/todo-app.nx`, `examples/durable-refs.nx`). `db/open`
# auto-creates the path's parent directories (Phase 5.2a polish),
# so `tmp/` doesn't need to exist at clone time — the CLI creates
# it on first run. The bare patterns below catch stragglers from
# REPL sessions or ad-hoc commands run from the repo root.
*.edb
*.edb-lock
tmp/
